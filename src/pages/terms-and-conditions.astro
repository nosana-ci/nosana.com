  <div class="mx-auto max-w-3xl px-4 py-12 md:px-12 md:py-20 lg:py-24">
    <h1 class="grotesk h4 text-primary mb-2">Terms and Conditions</h1>
    <p class="body4 text-tertiary mb-10">Last updated: August 3, 2026</p>

