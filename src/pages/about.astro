---
export const prerender = true;

import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/about/heroSection.astro";
import Divider from "../components/ui/divider.astro";
import InovationSection from "../components/about/inovationSection.astro";
import AboutComputeSection from "../components/about/aboutComputeSection.astro";
import VisionSection from "../components/about/visionSection.astro";
import TeamSection from "../components/about/teamSection.astro";
import CareersSection from "../components/about/careersSection.astro";
import Newsletter from "../components/layout/newsletter.astro";

const entry = await getEntry("about", "index");
const { seoDescription, seoImage, noIndex } = entry?.data ?? {};
---

<Layout
  title="About Nosana"
  description="Learn about Nosana and the platform behind on-demand GPU compute for AI and high-performance workloads."
  ogImage={seoImage || "/og/about.png"}
  noIndex={noIndex}
  ogTitle="About Nosana"
  ogDescription="Learn more about Nosana and its GPU compute platform."
>
  <HeroSection />
  <Divider />
  <InovationSection />
  <Divider />
  <AboutComputeSection />
  <Divider />
  <VisionSection />
  <Divider />
  <TeamSection />
  <Divider />
  <CareersSection />
  <Divider />
  <Newsletter />
</Layout>