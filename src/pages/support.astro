---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import Divider from "../components/ui/divider.astro";
import Faqs from "../components/support/faqs.astro";
import Newsletter from "../components/layout/newsletter.astro";
import GithubBanner from "../components/support/githubBanner.astro";
import DiscordBanner from "../components/support/discordBanner.astro";

const entry = await getEntry("support", "index");
if (!entry) {
  throw new Error("content not found");
}
const { seoDescription, seoImage, noIndex } = entry.data;
---

<Layout
  title="Nosana Support & Community Help"
  description="Get help with Nosana. Access documentation, community support, Discord, and GitHub resources for GPU compute."
  ogImage={seoImage || "/og/support.png"}
  noIndex={noIndex}
  ogTitle="Nosana Support"
  ogDescription="Find support, documentation, and community help for running or providing GPU compute on Nosana."
>
  <div class="flex flex-col gap-2 px-4 lg:px-12 pt-8 md:pt-16 lg:pt-18">
    <h1 class="h4 grotesk text-primary">{entry.data.heading}</h1>
    <p class="body2 text-secondary max-w-xl">{entry.data.description}</p>
  </div>
  <Divider />
  <DiscordBanner />
  <Divider />
  <GithubBanner />
  <Divider />
  <Faqs />
  <Divider />
  <Newsletter />
  <Divider />
</Layout>
