---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import Divider from "../components/ui/divider.astro";
import Newsletter from "../components/layout/newsletter.astro";
import TestimonialStack from "../components/homepage/testimonials.astro";
import Badge from "../components/ui/badge.astro";
import Production from "../components/homepage/production.astro";
import SocialBannerMarquee from "../components/layout/socialBannerMarquee.astro";
import Socials from "../components/ui/socials.astro";
import TestimonialGrid2 from "../components/testimonials/testimonialGrid2.astro";
import TestimonialSlider from "../components/gpu-providers/testimonials.astro";
import Features from "../components/testimonials/features.astro";
import CaseStudies from "../components/testimonials/caseStudies.astro";

const entry = await getEntry("testimonialsHomepage", "index");
if (!entry) {
  throw new Error("content not found");
}

const gpuProvidersEntry = await getEntry("gpuProviders", "index");
if (!gpuProvidersEntry) {
  throw new Error("GPU Providers content not found");
}
---

<Layout title="Nosana | Testimonials Page" ogImage="/og/testimonials.png"
>
  <div class="flex flex-col gap-2 px-4 md:px-12 pt-8 md:pt-16 lg:pt-18">
    <Badge title={entry.data.badge.title} class="w-fit" />
    <h1 class="h4 grotesk text-primary max-w-3xl">
      {entry.data.heading}
    </h1>
    <p class="body2 text-secondary max-w-3xl">{entry.data.description}</p>
  </div>
  <Divider />
  <TestimonialStack />
  <Divider />
  <TestimonialGrid2 />
  <Divider />
  <Production />
  <Divider />
  <TestimonialSlider testimonialsSection={gpuProvidersEntry.data.testimonialsSection} />
  <Divider />
  <SocialBannerMarquee />
  <div class="px-4 md:px-12 flex items-center justify-center">
    <Socials showTitle={true} />
  </div>
  <Features />
  <Divider />
  <CaseStudies />
  <Divider />
  <Newsletter />
  <Divider />
</Layout>
