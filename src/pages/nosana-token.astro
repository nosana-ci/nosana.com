---
export const prerender = true;

import { getEntry } from "astro:content";
import Newsletter from "../components/layout/newsletter.astro";
import CommunitySection from "../components/nosana-token/communitySection.astro";
import GuideSection from "../components/nosana-token/guideSection.astro";
import FeaturesSection from "../components/nosana-token/featuresSection.astro";
import HeroSection from "../components/nosana-token/heroSection.astro";
import StakingSection from "../components/nosana-token/stakingSection.astro";
import Divider from "../components/ui/divider.astro";
import Layout from "../layouts/Layout.astro";

const entry = await getEntry("nosanaToken", "index");
const { seoDescription, seoImage, noIndex } = entry?.data ?? {};
---

<Layout
  title="$NOS Token"
  description="Overview of the $NOS token and its role within the Nosana platform."
  ogImage={seoImage || "/og/nosana-token.png"}
  noIndex={noIndex}
  ogTitle="$NOS Token"
  ogDescription="Information about the $NOS token and how it is used on Nosana."
>
  <HeroSection />
  <FeaturesSection />
  <Divider />
  <CommunitySection />
  <Divider />
  <StakingSection />
  <Divider />
  <GuideSection />
  <Divider />
  <Newsletter/>
</Layout>
