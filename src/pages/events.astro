---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Divider from "../components/ui/divider.astro";
import Newsletter from "../components/layout/newsletter.astro";
import LatestEvent from "../components/events/latestEvent.astro";
import EventsHero from "../components/events/eventsHero.astro";
import EventsList from "../components/events/eventsList.astro";
import LiveSessions from "../components/events/liveSessions.astro";
import CommunityCalls from "../components/events/communityCalls.astro";
---

<Layout
  title="Nosana Events & Meetups"
  description="Join Nosana at events, hackathons, and meetups focused on GPU compute and real-world AI workloads."
  ogImage="/og/events.png"
  ogTitle="Nosana Events"
  ogDescription="Meet the Nosana community at events and hackathons focused on GPU compute."
>
  <div class="h-8 w-full md:h-16 lg:h-18"></div>
  <LatestEvent />
  <Divider />
  <EventsHero />
  <Divider />
  <EventsList />
  <Divider />
  <LiveSessions />
  <CommunityCalls />
  <Newsletter />
</Layout>
