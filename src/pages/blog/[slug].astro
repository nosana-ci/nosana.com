---
export const prerender = true;

import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import NewsletterCard from "../../components/layout/newsletterCard.astro";
import Divider from "../../components/ui/divider.astro";
import RecentBlogs from "../../components/blogs/recentBlogs.astro";

export async function getStaticPaths() {
  const blogs = await getCollection("blogs");

  return blogs.map((blog) => ({
    params: { slug: blog.id },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const { Content, headings } = await render(blog);

// Filter and format headings for the ToC
const tocHeadings = headings.filter(h => h.depth <= 3);

const { title, description, thumbnail, createdAt, tags } = blog.data;

const formattedDate = createdAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const canonicalURL = new URL(`/blog/${blog.id}`, Astro.site).href;
const imageURL = new URL(thumbnail.src, Astro.site).href;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  image: imageURL,
  datePublished: createdAt.toISOString(),
  url: canonicalURL,
  keywords: tags?.join(", "),
  publisher: {
    "@type": "Organization",
    name: "Nosana",
    url: Astro.site?.href,
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon-96x96.png", Astro.site).href,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
};
---

<Layout title={title} description={description} ogImage={thumbnail.src} ogType="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  </Fragment>
  <article class="px-4 lg:px-12">
    <p class="body3 text-primary mt-8 mb-2 lg:mt-12">
      {formattedDate}
    </p>
    <h1 class="h4 grotesk text-primary">
      {title}
    </h1>
    <div class="my-8 lg:my-12">
      <Image
        src={thumbnail}
        alt={title}
        quality={100}
        class="border-default h-auto w-full rounded-xl border"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start relative">

      <aside class="hidden md:block md:col-span-5 lg:col-span-3 sticky mt-10 top-10 z-20">
        <div class="flex flex-col gap-12">
          {tocHeadings.length > 0 && (
            <nav class="toc">
              <h2 class="body4 text-primary mb-4 font-semibold">On this Page</h2>
              <ul class="flex flex-col gap-3">
                {tocHeadings.map((heading, index) => (
                  <li class="group">
                    <a 
                      href={`#${heading.slug}`} 
                      class="toc-link flex items-start gap-4 text-primary transition-colors duration-200 py-1"
                    >
                      <span class="caption1 font-bold text-primary group-hover:text-brand-100 transition-colors">
                        {(index + 1).toString().padStart(2, '0')}
                      </span>
                      <span class="caption1 leading-tight line-clamp-1 transition-colors">
                        {heading.text}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <NewsletterCard />
        </div>
      </aside>

      <div class="md:col-span-7 lg:col-span-9 max-w-4xl">
        <div class="blog-content lg:ml-16 xl:ml-22 relative z-10">
          <Content />
        </div>
        <div class="mt-8 lg:mt-12 block md:hidden relative z-20">
          <NewsletterCard />
        </div>
      </div>
    </div>
  </article>
  <Divider />
  <RecentBlogs currentSlug={blog.id} />
</Layout>

<style is:global>
  .blog-content h1,
  .blog-content h2,
  .blog-content h3,
  .blog-content h4,
  .blog-content h5,
  .blog-content h6 {
    position: relative;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
    width: 100%;
    border-bottom: 1px solid #2A2A2A;
    padding: 0 0 12px 12px;
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content h1::before,
  .blog-content h2::before,
  .blog-content h3::before,
  .blog-content h4::before,
  .blog-content h5::before,
  .blog-content h6::before {
    content: "";
    position: absolute;
    left: 0;
    top: 5%;
    height: 70%;
    width: 2px;
    background-color: var(--color-brand-100);
    border-radius: 20px;
  }

  .blog-content h1 {
    font-size: 18px;
  }

  @media (min-width: 768px) {
    .blog-content h1 {
      font-size: 24px;
    }
  }

  @media (min-width: 1024px) {
    .blog-content h1 {
      font-size: 28px;
    }
  }

  .blog-content h2,
  .blog-content h3 {
    font-size: 18px;
  }

  @media (min-width: 768px) {
    .blog-content h2,
    .blog-content h3 {
      font-size: 24px;
    }
  }

  .blog-content h4,
  .blog-content h5,
  .blog-content h6 {
    font-size: 18px;
  }

  @media (min-width: 768px) {
    .blog-content h4,
    .blog-content h5,
    .blog-content h6 {
      font-size: 24px;
    }
  }

  .blog-content p {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  .blog-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content li {
    font-size: 14px;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }

  .blog-content li p {
    display: inline;
    margin: 0;
  }

  .blog-content li br {
    display: block;
    content: "";
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .blog-content p {
      font-size: 16px;
    }
    .blog-content li {
      font-size: 16px;
    }
  }

  @media (min-width: 1024px) {
    .blog-content p {
      font-size: 18px;
    }
    .blog-content li {
      font-size: 18px;
    }
  }

  .blog-content a {
    color: var(--color-brand-100);
    transition: all 0.3s ease;
  }

  .blog-content a:hover {
    text-decoration: underline;
  }

  .blog-content img {
    border-radius: 0.75rem;
    border: 1px solid var(--color-default);
    margin: 0 0 2rem 0;
    width: 100%;
    height: auto;
  }

  .blog-content blockquote {
    border-left: 2px solid var(--color-brand-100);
    padding: 0.25rem 0 0.25rem 1rem;
    font-style: italic;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }

  .blog-content hr {
    display: none;
  }

  .toc-link.active span {
    color: var(--color-brand-100) !important;
  }

  .blog-content pre {
    position: relative;
    background-color: #1F1F1F;
    border: 1px solid #2A2A2A;
    border-radius: 0.5rem;
    padding: 1rem;
    padding-top: 2.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-family: monospace;
  }

  .blog-content pre code {
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: 14px;
  }

  .blog-content :not(pre) > code {
    background-color: #2A2A2A;
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.9em;
    color: #4DFF4A;
  }

  .blog-content .copy-code-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 0.25rem;
    color: #7A7A7A;
    padding: 0.25rem 0.625rem;
    font-size: 12px;
    line-height: 1.5;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .blog-content .copy-code-btn:hover {
    background: #3A3A3A;
    color: #FAFAFA;
  }

  .blog-content .copy-code-btn.copied {
    color: #10E80C;
    border-color: #10E80C;
  }
</style>

<script>
  function initToC() {
    const tocLinks = document.querySelectorAll('.toc-link');
    const headings = document.querySelectorAll('.blog-content h1, .blog-content h2, .blog-content h3');
    
    if (tocLinks.length === 0 || headings.length === 0) return;

    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -80% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          tocLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      });
    }, observerOptions);

    headings.forEach(heading => observer.observe(heading));
  }

  // Run on initial load
  initToC();

  // Re-run on Astro View Transitions
  document.addEventListener('astro:after-swap', initToC);

  // Blog article view tracking
  const dl = (window as any).dataLayer || [];
  dl.push({
    event: "blog_article_view",
    article_title: document.title,
    article_slug: window.location.pathname,
  });

  // Blog read signal — fires when user scrolls past 75% of article content
  const blogContent = document.querySelector('.blog-content');
  if (blogContent) {
    let blogReadFired = false;
    const readObserver = new IntersectionObserver((entries) => {
      if (!blogReadFired && entries[0].isIntersecting) {
        blogReadFired = true;
        dl.push({
          event: "blog_article_read",
          article_title: document.title,
          article_slug: window.location.pathname,
        });
        readObserver.disconnect();
      }
    }, { threshold: 0.75 });

    // Observe the last child of blog content as a "read" signal
    const lastChild = blogContent.lastElementChild;
    if (lastChild) readObserver.observe(lastChild);
  }

  // Copy buttons for code blocks
  function addCopyButtons() {
    document.querySelectorAll('.blog-content pre').forEach(pre => {
      if (pre.querySelector('.copy-code-btn')) return;
      const btn = document.createElement('button');
      btn.className = 'copy-code-btn';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = (code?.textContent ?? pre.textContent) ?? '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
        } catch {
          btn.textContent = 'Failed';
        }
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 2000);
      });
      pre.appendChild(btn);
    });
  }

  addCopyButtons();
  document.addEventListener('astro:after-swap', addCopyButtons);
</script>
