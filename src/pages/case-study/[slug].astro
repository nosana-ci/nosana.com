---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import NewsletterCard from "../../components/layout/newsletterCard.astro";
import Divider from "../../components/ui/divider.astro";
import RecentCaseStudeis from "../../components/case-study/recentCaseStudeis.astro";

export async function getStaticPaths() {
  const allBlogs = await getCollection("blogs");
  const blogs = allBlogs.filter((b) => b.data.category === "case-study");

  return blogs.map((blog) => ({
    params: { slug: blog.id },
    props: { blog },
  }));
}

interface Props {
  blog: CollectionEntry<"blogs">;
}

const { blog } = Astro.props;
const { Content, headings } = await render(blog);

// Filter and format headings for the ToC
const tocHeadings = headings.filter(h => h.depth <= 3);

const { title, description, thumbnail, createdAt } = blog.data;

const formattedDate = createdAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={title} description={description} ogImage={thumbnail.src} ogType="article">
  <article class="px-4 md:px-12">
    <p class="body3 text-primary mt-8 mb-2 lg:mt-12">
      {formattedDate}
    </p>
    <h1 class="h4 grotesk text-primary">
      {title}
    </h1>
    <div class="my-8 lg:my-12">
      <Image
        src={thumbnail}
        alt={title}
        class="border-default h-auto w-full rounded-xl border"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start relative">

      <aside class="hidden md:block md:col-span-5 lg:col-span-3 sticky mt-10 top-10">
        <div class="flex flex-col gap-12">
          {tocHeadings.length > 0 && (
            <nav class="toc">
              <h2 class="body4 text-primary mb-4 font-semibold">On this Page</h2>
              <ul class="flex flex-col gap-3">
                {tocHeadings.map((heading, index) => (
                  <li class="group">
                    <a 
                      href={`#${heading.slug}`} 
                      class="flex items-start gap-4 text-primary transition-colors duration-200 py-1"
                    >
                      <span class="caption1 font-bold text-primary group-hover:text-brand-100 transition-colors">
                        {(index + 1).toString().padStart(2, '0')}
                      </span>
                      <span class="caption1 leading-tight line-clamp-1">
                        {heading.text}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <NewsletterCard />
        </div>
      </aside>

      <div class="md:col-span-7 lg:col-span-9 max-w-4xl">
        <div class="blog-content lg:ml-16 xl:ml-22">
          <Content />
        </div>
        <div class="mt-8 lg:mt-12 block md:hidden">
          <NewsletterCard />
        </div>
      </div>
    </div>

  <Divider />
  <RecentCaseStudeis currentSlug={blog.id} />

  </article>
</Layout>

<style is:global>
  .blog-content h1,
  .blog-content h2,
  .blog-content h3,
  .blog-content h4,
  .blog-content h5,
  .blog-content h6 {
    position: relative;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
    width: 100%;
    border-bottom: 1px solid #2A2A2A;
    padding: 0 0 12px 12px;
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content h1::before,
  .blog-content h2::before,
  .blog-content h3::before,
  .blog-content h4::before,
  .blog-content h5::before,
  .blog-content h6::before {
    content: "";
    position: absolute;
    left: 0;
    top: 5%;
    height: 70%;
    width: 2px;
    background-color: var(--color-brand-100);
    border-radius: 20px;
  }

  .blog-content h1 {
    font-size: 18px;
  }

  @media (min-width: 768px) {
    .blog-content h1 {
      font-size: 24px;
    }
  }

  @media (min-width: 1024px) {
    .blog-content h1 {
      font-size: 28px;
    }
  }

  .blog-content h2,
  .blog-content h3 {
    font-size: 18px;
  }

  @media (min-width: 768px) {
    .blog-content h2,
    .blog-content h3 {
      font-size: 24px;
    }
  }

  .blog-content h4,
  .blog-content h5,
  .blog-content h6 {
    font-size: 18px;
  }

  @media (min-width: 768px) {
    .blog-content h4,
    .blog-content h5,
    .blog-content h6 {
      font-size: 24px;
    }
  }

  .blog-content p,
  .blog-content li {
    font-size: 14px;
    line-height: 1.3;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .blog-content p,
    .blog-content li {
      font-size: 16px;
    }
  }

  @media (min-width: 1024px) {
    .blog-content p,
    .blog-content li {
      font-size: 18px;
    }
  }

  .blog-content a {
    color: var(--color-brand-100);
    transition: all 0.3s ease;
  }

  .blog-content a:hover {
    text-decoration: underline;
  }

  .blog-content ul {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 0.5rem;
  }

  .blog-content ol {
    list-style-type: decimal;
    list-style-position: inside;
    margin-bottom: 0.5rem;
  }

  .blog-content img {
    border-radius: 0.75rem;
    border: 1px solid var(--color-default);
    margin: 0 0 2rem 0;
    width: 100%;
    height: auto;
  }

  .blog-content blockquote {
    border-left: 2px solid var(--color-brand-100);
    padding: 0.25rem 0 0.25rem 1rem;
    font-style: italic;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }
</style>
