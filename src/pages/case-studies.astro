---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import Divider from "../components/ui/divider.astro";
import Newsletter from "../components/layout/newsletter.astro";
import LatestCaseStudy from "../components/case-study/latestCaseStudySlider.astro";
import Badge from "../components/ui/badge.astro";
import Production from "../components/case-study/production.astro";
import SocialBannerMarquee from "../components/layout/socialBannerMarquee.astro";
import Socials from "../components/ui/socials.astro";

const entry = await getEntry("caseStudyHomepage", "index");
if (!entry) {
  throw new Error("content not found");
}

const [titleMain, titleSub] = entry.data.heading.split("-");
---

<Layout
  title="GPU Compute Case Studies"
  description="See how teams use Nosana to run AI and compute workloads with on-demand GPU resources."
  ogImage="/og/case-study.png"
  ogTitle="Nosana Case Studies"
  ogDescription="Real examples of teams running AI and compute workloads using Nosana GPUs."
>
  <div class="flex flex-col gap-2 px-4 lg:px-12 pt-8 md:pt-16 lg:pt-18">
    <Badge title={entry.data.badge.title} class="w-fit" />
    <h1 class="h4 grotesk text-primary max-w-3xl">
      {titleMain}
      <span class="text-brand-100">{titleSub}</span>
    </h1>
    <p class="body2 text-secondary max-w-3xl">{entry.data.description}</p>
  </div>
  <Divider />
  <LatestCaseStudy />
  <Divider />
  <Production />
  <SocialBannerMarquee />
  <div class="px-4 lg:px-12 flex items-center justify-center">
    <Socials showTitle={true} />
  </div>
  <Divider />
  <Newsletter />
  <Divider />
</Layout>
