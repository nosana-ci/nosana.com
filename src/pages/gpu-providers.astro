---
import { getEntry } from "astro:content";
import Hero from "../components/gpu-providers/hero.astro";
import WhyProvideSection from "../components/gpu-providers/whyProvideSection.astro";
import Divider from "../components/ui/divider.astro";
import Layout from "../layouts/Layout.astro";
import Testimonials from "../components/gpu-providers/testimonials.astro";
import HowToGetStart from "../components/gpu-providers/howToGetStart.astro";
import VideoSection from "../components/gpu-providers/videoSection.astro";
import EarningsSection from "../components/gpu-providers/earningsSection.astro";
import NewsletterSection from "../components/layout/newsletter.astro";
import HardwareRequirements from "../components/gpu-providers/hardwareRequirements.astro";

const entry = await getEntry("gpuProviders", "index");

if (!entry) {
  throw new Error("GPU Providers content not found");
}

const {
  heroSection,
  whyProvideSection,
  testimonialsSection,
  getStarted,
  videoSection,
  earningSection,
  hardwareRequirementsSection,
  seoDescription,
  seoImage,
  noIndex,
} = entry.data;
---

<Layout title="Nosana | GPU Providers" description={seoDescription} ogImage={seoImage} noIndex={noIndex}>
  <Hero heroSection={heroSection} />
  <Divider />
  <WhyProvideSection whyProvideSection={whyProvideSection} />
  <Divider />
  <Testimonials testimonialsSection={testimonialsSection} />
  <Divider />
  <HowToGetStart getStarted={getStarted} />
  <Divider />
  <VideoSection videoSection={videoSection} />
  <Divider />
  <EarningsSection earningSection={earningSection} />
  <Divider />
  <HardwareRequirements hardwareRequirementsSection={hardwareRequirementsSection} />
  <Divider />
  <NewsletterSection />
  <Divider />
</Layout>
