---
export const prerender = true;

import { getEntry } from "astro:content";
import { getImage } from "astro:assets";
import heroBg from "../content/homepage/assets/heroBg.webp";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/homepage/hero.astro";
import Brands from "../components/layout/brands.astro";
import PathSection from "../components/homepage/path.astro";
import EcosystemSection from "../components/homepage/ecosystem.astro";
import Divider from "../components/ui/divider.astro";
import WhyNosanaSection from "../components/homepage/whynosana.astro";
import RentGPUSection from "../components/homepage/rentgpu.astro";
import Banner from "../components/homepage/banner.astro";
import ProductionSection from "../components/homepage/production.astro";
import MediaCard from "../components/ui/mediaCard.astro";
import Testimonials from "../components/homepage/testimonials.astro";
import Newsletter from "../components/layout/newsletter.astro";
import CTA from "../components/homepage/cta.astro";
import LatestBlog from "../components/blogs/latestBlogHomepage.astro";
import LatestEvent from "../components/events/latestEventHomepage.astro";

const entry = await getEntry("homepage", "index");
if (!entry) {
	throw new Error("content not found");
}

const { seoDescription, seoImage, noIndex } = entry.data;

const heroPoster = await getImage({ src: heroBg, format: "webp", quality: 80 });

const siteUrl = Astro.site?.href ?? "https://nosana.com/";

// One @graph rather than separate blocks, so the entities reference each other
// by @id: an agent reading the Service knows which Organization provides it.
// Prices are deliberately absent here — pricing.md and the markets API are the
// single source, and a number duplicated into markup goes stale unnoticed.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Nosana",
      url: siteUrl,
      logo: new URL("/favicon-96x96.png", Astro.site).href,
      description: seoDescription,
      sameAs: [
        "https://twitter.com/nosana_ai",
        "https://github.com/nosana-ci",
        "https://discord.gg/nosana",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Nosana",
      description: seoDescription,
      publisher: { "@id": `${siteUrl}#organization` },
    },
    {
      "@type": "Service",
      "@id": `${siteUrl}#gpu-cloud`,
      name: "Nosana GPU cloud",
      serviceType: "GPU cloud computing",
      description:
        "On-demand GPU compute for AI inference, fine-tuning, rendering and simulation, billed per second at the price of the GPU market you deploy to.",
      provider: { "@id": `${siteUrl}#organization` },
      areaServed: "Worldwide",
      termsOfService: new URL("/terms-and-conditions/", Astro.site).href,
      offers: {
        "@type": "Offer",
        url: new URL("/pricing.md", Astro.site).href,
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        description:
          "Per-second billing per GPU market. Live prices: https://api.nosana.com/api/markets/",
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}#kit`,
      name: "@nosana/kit",
      applicationCategory: "DeveloperApplication",
      description:
        "TypeScript SDK and agent skill for deploying and managing GPU workloads on Nosana.",
      url: "https://github.com/nosana-ci/nosana-kit",
      operatingSystem: "Node.js",
      publisher: { "@id": `${siteUrl}#organization` },
      offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
    },
  ],
};
---

<Layout
  title="Affordable GPU Rental at Scale - On-Demand GPU Compute Cloud"
  description="Rent GPUs on demand for AI and high-performance workloads. Nosana lets you run workloads instantly or earn by sharing your GPU with flexible pricing."
  ogImage="/og/home.png"
  noIndex={noIndex}
  ogTitle="Affordable GPU Rental at Scale - On-Demand GPU Compute"
  ogDescription="Affordable GPU rental for AI and high-performance workloads. Run on demand or earn by providing GPU compute through the Nosana GPU cloud."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroPoster.src} fetchpriority="high" />
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
	<Hero />
	<div class="bg-bg-base py-8 md:py-16 lg:py-18 w-full"><Brands /></div>
	<PathSection />
	<Divider />
	<EcosystemSection />
	<Divider />
	<WhyNosanaSection />
	<Divider />
	<RentGPUSection />
	<Banner />
	<Divider />
	<ProductionSection />
	<div class="h-fit w-full flex flex-col xl:flex-row gap-10 px-4 lg:px-12">
		<LatestEvent />
		<LatestBlog />
	</div>
	<Divider />
	<Testimonials />
	<Divider />
	<Newsletter />
	<CTA />
</Layout>
