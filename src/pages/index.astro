---
import { getEntry } from "astro:content";

import Layout from "../layouts/Layout.astro";
import Hero from "../components/homepage/hero.astro";
import Brands from "../components/layout/brands.astro";
import PathSection from "../components/homepage/path.astro";
import EcosystemSection from "../components/homepage/ecosystem.astro";
import Divider from "../components/ui/divider.astro";
import WhyNosanaSection from "../components/homepage/whynosana.astro";
import RentGPUSection from "../components/homepage/rentgpu.astro";
import Banner from "../components/homepage/banner.astro";
import ProductionSection from "../components/homepage/production.astro";
import MediaCard from "../components/ui/mediaCard.astro";
import Testimonials from "../components/homepage/testimonials.astro";
import Newsletter from "../components/layout/newsletter.astro";
import CTA from "../components/homepage/cta.astro";
import LatestBlog from "../components/blogs/latestBlogHomepage.astro";
import LatestEvent from "../components/events/latestEventHomepage.astro";

const entry = await getEntry("homepage", "index");
if (!entry) {
	throw new Error("content not found");
}

const { upcomingEventsMock, latestBlogsMock, seoDescription, seoImage, noIndex } = entry.data;
---

<Layout title="Nosana" description={seoDescription} ogImage={seoImage} noIndex={noIndex}>
	<Hero />
	<div class="bg-bg-base py-8 md:py-16 lg:py-18 w-full"><Brands /></div>
	<PathSection />
	<Divider />
	<EcosystemSection />
	<Divider />
	<WhyNosanaSection />
	<Divider />
	<RentGPUSection />
	<Banner />
	<Divider />
	<ProductionSection />
	<div class="h-fit w-full flex flex-col lg:flex-row gap-10 px-4 md:px-12">
		<LatestEvent />
		<LatestBlog />
	</div>
	<Divider />
	<Testimonials />
	<Divider />
	<Newsletter />
	<CTA />
</Layout>
