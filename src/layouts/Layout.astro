---
import "../styles/global.css";
import Navbar from "../components/layout/navbar.astro";
import Footer from "../components/layout/footer.astro";

interface Props {
	title?: string;
}

const { title = "Nosana" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-bg-base text-primary font-sans">
		<main
			class="flex flex-col items-center justify-center max-w-[1728px] mx-auto w-full"
		>
			<Navbar />
			<slot />
			<Footer />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
	}
</style>
