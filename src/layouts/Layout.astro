---
import "../styles/global.css";
import Navbar from "../components/layout/navbar.astro";
import Footer from "../components/layout/footer.astro";
import BaseHead from "../components/BaseHead.astro";
import Toast from "../components/ui/toast.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  ogType?: "website" | "article";
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title = "Nosana",
  description = "Nosana is an open-source GPU cloud platform for AI and high-performance workloads. Rent affordable GPUs or provide your idle GPU power to the network.",
  ogImage,
  noIndex,
  ogType,
  ogTitle,
  ogDescription,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="preload"
      href="/fonts/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HNDP62SH8M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HNDP62SH8M');
    </script>
    <!-- End Google Analytics 4 -->
    <BaseHead
      title={title}
      description={description}
      image={ogImage}
      noIndex={noIndex}
      type={ogType}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
    />
    <slot name="head" />
  </head>

  <body class="bg-bg-base text-primary min-h-screen font-sans">
    <Navbar />

    <main class="mx-auto w-full max-w-[1728px]">
      <slot />
    </main>

    <Toast />
    <Footer />

    <script>
      // ── GA4 Event Tracking via dataLayer ──
      declare global {
        interface Window {
          dataLayer: Record<string, unknown>[];
        }
      }
      window.dataLayer = window.dataLayer || [];

      // Page metadata
      window.dataLayer.push({
        event: "page_metadata",
        page_title: document.title,
        page_path: window.location.pathname,
        page_url: window.location.href,
        page_hostname: window.location.hostname,
      });

      // ── Click Tracking ──
      document.addEventListener("click", (e) => {
        const target = (e.target as Element).closest("a, button");
        if (!target) return;

        const href =
          target.getAttribute("href") || target.getAttribute("data-href") || "";
        const text = (target as HTMLElement).innerText?.trim() || "";

        // CTA clicks — buttons with data-cta attribute
        const ctaType = target.getAttribute("data-cta");
        if (ctaType) {
          window.dataLayer.push({
            event: "cta_click",
            cta_type: ctaType,
            cta_text: text,
            cta_url: href,
            page_path: window.location.pathname,
          });
          return;
        }

        // Navbar clicks
        if (target.closest("[data-navbar]")) {
          window.dataLayer.push({
            event: "navbar_click",
            click_url: href,
            click_text: text,
          });
          return;
        }

        // Footer clicks
        if (target.closest("footer, [data-footer]")) {
          window.dataLayer.push({
            event: "footer_click",
            click_url: href,
            click_text: text,
          });
          return;
        }

        // Outbound link clicks
        const isOutbound =
          href.startsWith("http") && !href.includes(window.location.hostname);
        if (isOutbound) {
          window.dataLayer.push({
            event: "outbound_link_click",
            click_url: href,
            click_text: text,
            page_path: window.location.pathname,
          });
          return;
        }

        // General navigation clicks (internal links)
        if (href && target.tagName === "A") {
          window.dataLayer.push({
            event: "navigation_click",
            click_url: href,
            click_text: text,
          });
        }
      });

      // ── Scroll Depth (25 / 50 / 75 / 90 %) ──
      const scrollThresholds = [25, 50, 75, 90];
      const reached = new Set<number>();
      window.addEventListener(
        "scroll",
        () => {
          const scrolled =
            (window.scrollY /
              (document.documentElement.scrollHeight - window.innerHeight)) *
            100;
          for (const threshold of scrollThresholds) {
            if (!reached.has(threshold) && scrolled >= threshold) {
              reached.add(threshold);
              window.dataLayer.push({
                event: "scroll_depth",
                scroll_threshold: threshold,
                page_path: window.location.pathname,
              });
            }
          }
        },
        { passive: true },
      );

      // ── Newsletter Subscription ──
      document.querySelectorAll<HTMLFormElement>('form[action="/api/newsletter"]').forEach((form) => {
        form.addEventListener("submit", () => {
          window.dataLayer.push({
            event: "newsletter_subscribe",
            page_path: window.location.pathname,
          });
        });
      });

      // ── FAQ Interaction ──
      document.querySelectorAll<HTMLDetailsElement>("[data-faq]").forEach((faq) => {
        faq.addEventListener("toggle", () => {
          if (faq.open) {
            const question = faq.querySelector("summary")?.innerText?.trim() || "";
            window.dataLayer.push({
              event: "faq_open",
              faq_question: question,
              page_path: window.location.pathname,
            });
          }
        });
      });
    </script>

    <script>
      import Lenis from "lenis";

      const lenis = new Lenis({
        duration: 1.5,
        smoothWheel: true,
        wheelMultiplier: 1.0,
        touchMultiplier: 2.0,
      });

      function raf(time: DOMHighResTimeStamp) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
  }
</style>
