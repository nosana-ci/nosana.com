---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import NavigateButton from "./navigateButton.astro";

const entry = await getEntry("caseStudy", "index");
if (!entry) throw new Error("Case study content not found");

const { caseStudies } = entry.data;

const ITEMS_PER_PAGE = 6;
---

<section class="w-full">
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-default"
  >
    {
      caseStudies.map((item, index) => (
        <div
          class="case-card hidden border border-default p-6"
          data-index={index}
        >
          <div class="flex flex-col gap-4 h-full">
            <Image
              src={item.icon}
              alt=""
              class="w-12 h-12 select-none pointer-events-none"
            />

            <h3 class="text-primary body2 font-semibold">{item.title}</h3>

            <p class="text-primary body4">{item.description}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="flex items-center justify-center py-8 md:py-16 lg:py-18 gap-4">
    <NavigateButton
      id="case-prev"
      variant="secondary"
      direction="left"
      text="Back"
      class="cursor-pointer"
    />

    <div id="case-pages" class="flex gap-2"></div>

    <NavigateButton
      id="case-next"
      variant="secondary"
      direction="right"
      text="Next"
      class="cursor-pointer"
    />
  </div>
</section>

<script>
  (() => {
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".case-card"),
    );

    const prevBtn = document.getElementById(
      "case-prev",
    ) as HTMLButtonElement | null;

    const nextBtn = document.getElementById(
      "case-next",
    ) as HTMLButtonElement | null;

    const pagesContainer = document.getElementById("case-pages");

    const ITEMS_PER_PAGE = 6;
    const totalPages = Math.ceil(cards.length / ITEMS_PER_PAGE);

    let currentPage = 0;

    function renderPages() {
      if (!pagesContainer) return;
      pagesContainer.innerHTML = "";

      for (let i = 0; i < totalPages; i++) {
        const btn = document.createElement("button");
        btn.textContent = String(i + 1);
        btn.className =
          "w-10 h-10 body4 rounded-[5px] transition cursor-pointer " +
          (i === currentPage
            ? "bg-brand-100 text-bg-base"
            : "bg-white/15 text-secondary hover:bg-brand-100/50 hover:text-primary");

        btn.addEventListener("click", () => {
          currentPage = i;
          update();
        });

        pagesContainer.appendChild(btn);
      }
    }

    function update() {
      const start = currentPage * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;

      cards.forEach((card, index) => {
        card.classList.toggle("hidden", index < start || index >= end);
      });

      renderPages();

      if (prevBtn) {
        const disabled = currentPage === 0;

        prevBtn.disabled = disabled;
        prevBtn.classList.toggle("opacity-40", disabled);
        prevBtn.classList.toggle("cursor-not-allowed", disabled);
        prevBtn.classList.toggle("pointer-events-none", disabled);
      }

      if (nextBtn) {
        const disabled = currentPage === totalPages - 1;

        nextBtn.disabled = disabled;
        nextBtn.classList.toggle("opacity-40", disabled);
        nextBtn.classList.toggle("cursor-not-allowed", disabled);
        nextBtn.classList.toggle("pointer-events-none", disabled);
      }
    }

    prevBtn?.addEventListener("click", () => {
      if (currentPage > 0) {
        currentPage--;
        update();
      }
    });

    nextBtn?.addEventListener("click", () => {
      if (currentPage < totalPages - 1) {
        currentPage++;
        update();
      }
    });

    update();
  })();
</script>
