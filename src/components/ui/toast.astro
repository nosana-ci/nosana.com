---
import { Image } from "astro:assets";
import cross from "../../assets/icons/close.svg";
import success from "../../assets/icons/success.svg";
import error from "../../assets/icons/error.svg";
---

<div
  id="global-toast"
  role="status"
  aria-live="polite"
  class="fixed bottom-6 right-6 z-50
         flex items-stretch gap-2
         min-w-[280px] max-w-sm
         bg-surface border border-default
         text-primary px-5 py-4 rounded-lg shadow-lg
         opacity-0 translate-y-3 pointer-events-none
         transition-all duration-200 ease-out"
>

  <!-- Icon Column -->
  <div class="self-stretch flex items-center">
    <div class="w-7 h-full flex items-center justify-center relative">
      <Image
        id="global-toast-success-icon"
        src={success}
        alt="success"
        width={32}
        height={32}
        class="absolute opacity-0 select-none pointer-events-none h-full aspect-square"
      />
      <Image
        id="global-toast-error-icon"
        src={error}
        alt="error"
        width={32}
        height={32}
        class="absolute opacity-0 select-none pointer-events-none h-full aspect-square"
      />
    </div>
  </div>

  <!-- Text -->
  <div class="flex-1 flex flex-col justify-center">
    <p id="global-toast-title" class="font-semibold text-sm leading-tight"></p>
    <p id="global-toast-text" class="text-xs text-secondary mt-1 leading-snug"></p>
  </div>

  <!-- Close -->
  <button
    id="global-toast-close"
    class="self-start w-2 h-2 flex items-center justify-center opacity-70 hover:opacity-100 transition cursor-pointer"
  >
    <Image
      src={cross}
      alt="close"
      width={16}
      height={16}
      class="w-full h-full"
    />
  </button>
</div>

<script>
  const toast = document.getElementById("global-toast");
  const toastTitle = document.getElementById("global-toast-title");
  const toastText = document.getElementById("global-toast-text");
  const successIcon = document.getElementById("global-toast-success-icon");
  const errorIcon = document.getElementById("global-toast-error-icon");
  const closeBtn = document.getElementById("global-toast-close");

  let hideTimeout;

  function show(type, message) {
    clearTimeout(hideTimeout);

    successIcon.classList.add("opacity-0");
    errorIcon.classList.add("opacity-0");

    if (type === "success") {
      successIcon.classList.remove("opacity-0");
      toastTitle.textContent = "Success";
    } else {
      errorIcon.classList.remove("opacity-0");
      toastTitle.textContent = "Error";
    }

    toastText.textContent = message;

    toast.classList.remove(
      "opacity-0",
      "translate-y-3",
      "pointer-events-none"
    );

    hideTimeout = setTimeout(hide, 3000);
  }

  function hide() {
    toast.classList.add(
      "opacity-0",
      "translate-y-3",
      "pointer-events-none"
    );
  }

  closeBtn.addEventListener("click", hide);

  // Listen globally
  window.addEventListener("toast", (e) => {
    const { type, message } = e.detail;
    show(type, message);
  });
</script>