---
import { getCollection, type CollectionEntry } from "astro:content";
import TestimonialStackCard from "./testimonialStackCard.astro";
import NavigateButton from "./navigateButton.astro";

const allTestimonials = await getCollection("testimonials");
const testimonialsCollection = allTestimonials.filter(
  (t): t is CollectionEntry<"testimonials"> & { data: { type: "stack" } } =>
    t.data.type === "stack",
);

const cardsData = testimonialsCollection
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => t.data)
  .slice(0, 3);
---

<div class="relative w-[600px] max-w-full">
  <div class="relative aspect-601/375">
    {
      cardsData.map((t, i) => {
        const { name, username, logo, message, rating } = t;

        return (
          <div
            data-testimonial
            class="absolute inset-0 transition-all duration-300 ease-out"
            style={`
            z-index: ${cardsData.length - i};
            transform: translate(0px, ${-i * 40}px) scale(${1 - i * 0.08});
          `}
          >
            <TestimonialStackCard
              name={name}
              username={username}
              logo={logo}
              message={message}
              rating={rating}
            />
          </div>
        );
      })
    }
  </div>

  <div
    class="hidden md:flex absolute right-[-56px] top-1/2 -translate-y-1/2 flex-col gap-2"
  >
    <div data-nav="prev">
      <NavigateButton direction="up" variant="secondary" />
    </div>
    <div data-nav="next">
      <NavigateButton direction="down" variant="secondary" />
    </div>
  </div>
</div>

<div class="md:hidden w-full flex justify-end mt-6">
  <div class="flex gap-3">
    <div data-nav="prev">
      <NavigateButton direction="left" variant="secondary" />
    </div>
    <div data-nav="next">
      <NavigateButton direction="right" variant="secondary" />
    </div>
  </div>
</div>

<script>
  let index = 0;

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-testimonial]"),
  );

  const prevBtn = document.querySelectorAll<HTMLElement>('[data-nav="prev"]');
  const nextBtn = document.querySelectorAll<HTMLElement>('[data-nav="next"]');

  function getStackOffset() {
    return window.matchMedia("(min-width: 768px)").matches ? 40 : 30;
  }

  function update() {
    const total = cards.length;

    cards.forEach((card, i) => {
      const pos = (i - index + total) % total;

      card.style.zIndex = String(total - pos);
      card.style.transform = `translate(0px, ${-pos * getStackOffset()}px) scale(${1 - pos * 0.08})`;
      card.style.pointerEvents = pos === 0 ? "auto" : "none";
    });
  }

  prevBtn.forEach((btn) => {
    btn.addEventListener("click", () => {
      index = (index - 1 + cards.length) % cards.length;
      update();
    });
  });

  nextBtn.forEach((btn) => {
    btn.addEventListener("click", () => {
      index = (index + 1) % cards.length;
      update();
    });
  });

  window.addEventListener("resize", update);
  update();
</script>
