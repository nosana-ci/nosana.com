---
import type { HTMLAttributes } from "astro/types";
import chevronDownDouble from "../../assets/icons/chevronDownDouble.svg?raw";

interface Props extends HTMLAttributes<"button"> {
  variant?: "primary" | "secondary";
  direction?: "up" | "down" | "left" | "right";
  text?: string;
  class?: string;
}

const {
  variant = "primary",
  direction = "right",
  text,
  class: className,
  ...rest
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center gap-2 rounded-sm group overflow-hidden transition-all disabled:opacity-50 disabled:pointer-events-none";

const variants = {
  primary: "bg-primary hover:bg-primary/90 text-bg-base",
  secondary: "bg-white/15 hover:bg-white/20 border border-default text-primary",
};

const variantStyle = variants[variant];

const rotation = {
  up: "-rotate-180",
  down: "rotate-0",
  left: "rotate-90",
  right: "-rotate-90",
}[direction];

const axis = {
  up: "flex-col",
  down: "flex-col",
  left: "flex-row",
  right: "flex-row",
}[direction];

const translate = {
  up: "-translate-y-0 group-hover:-translate-y-4",
  down: "-translate-y-4 group-hover:translate-y-0",
  left: "-translate-x-0 group-hover:-translate-x-4",
  right: "-translate-x-4 group-hover:translate-x-0",
}[direction];

const reverse = direction === "left" || direction === "up";
const textBeforeIcon = direction === "right" || direction === "down";
---

<button
  type="button"
  class:list={[
    baseStyles,
    variantStyle,
    "p-2 lg:p-3 cursor-pointer",
    className,
  ]}
  {...rest}
>
  {/* Text before icon */}
  {
    text && textBeforeIcon && (
      <span class="text-sm font-medium whitespace-nowrap">{text}</span>
    )
  }

  <!-- Arrow icon -->
  <div class="w-3 h-3 lg:w-4 lg:h-4 relative">
    <div
      class:list={["flex transition-transform duration-300", axis, translate]}
    >
      {
        (reverse ? [false, true] : [true, false]).map((isHover) => (
          <span
            class:list={[
              "w-3 h-3 lg:w-4 lg:h-4 flex items-center justify-center shrink-0",
              isHover
                ? "opacity-0 group-hover:opacity-100"
                : "opacity-100 group-hover:opacity-0",
              "transition-opacity duration-300 [&_path]:fill-current",
              rotation,
            ]}
          >
            <Fragment set:html={chevronDownDouble} />
          </span>
        ))
      }
    </div>
  </div>

  {/* Text after icon */}
  {
    text && !textBeforeIcon && (
      <span class="text-sm font-medium whitespace-nowrap">{text}</span>
    )
  }
</button>
