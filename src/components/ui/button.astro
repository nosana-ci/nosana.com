---
import chevronDownDouble from "../../assets/icons/chevronDownDouble.svg?raw";

interface Props {
  title: string;
  url: string;
  variant?: "primary" | "secondary" | "colored" | "ghost";
  color?: string;
  icon?: any;
  iconColor?: string;
  iconSize?: number; // px
  target?: string;
  class?: string;
}

const {
  title,
  url,
  variant = "primary",
  color = "#0B840E",
  icon,
  iconColor = "#10E80C",
  iconSize = 24,
  target,
  class: className,
} = Astro.props;

const baseStyles =
  "rounded-sm inline-flex items-stretch transition-all group overflow-hidden whitespace-nowrap font-semibold";

const variants = {
  primary: "bg-primary text-secondarydark hover:bg-primary/90",
  secondary: "bg-white/15 hover:bg-white/20 border border-default text-primary",
  ghost: "text-primary hover:text-brand-100",
  colored: "text-primary hover:brightness-90 transition-all",
};

const variantStyle = variants[variant];
const customStyle =
  variant === "colored" && color ? { backgroundColor: color } : {};
---

<a
  href={url}
  target={target}
  class:list={[baseStyles, variantStyle, className]}
  style={customStyle}
>
  <span
    class:list={[
      "body4 flex flex-1 items-center gap-2 transition-colors",
      variant === "ghost" ? "px-1 py-2" : "p-2 lg:px-4 lg:py-3",
    ]}
  >
    {
      icon && (
        <span
          class="flex shrink-0 items-center justify-center transition-colors"
          style={{
            width: `${iconSize}px`,
            height: `${iconSize}px`,
            color: iconColor,
          }}
        >
          {typeof icon === "string" && icon.includes("<svg") ? (
            <span class="pointer-events-none h-full w-full select-none [&_path]:fill-current">
              <Fragment set:html={icon} />
            </span>
          ) : (
            <div
              class="pointer-events-none h-full w-full bg-current select-none"
              style={`
                    mask: url(${typeof icon === "string" ? icon : icon.src}) no-repeat center;
                    -webkit-mask: url(${typeof icon === "string" ? icon : icon.src}) no-repeat center;
                    mask-size: contain;
                    -webkit-mask-size: contain;`}
            />
          )}
        </span>
      )
    }
    {title}
  </span>

  <div
    class:list={[
      "flex shrink-0 items-center justify-center overflow-hidden transition-all",
      variant !== "ghost" ? "border-default border-l p-2 lg:p-4" : "px-1 py-2",
    ]}
  >
    <div class="relative h-3 w-3 lg:h-4 lg:w-4">
      <div
        class="flex -translate-x-3 transition-transform duration-300 group-hover:translate-x-0 lg:-translate-x-4"
      >
        <span
          class="pointer-events-none flex h-3 w-3 shrink-0 -rotate-90 items-center justify-center opacity-0 transition-opacity duration-300 select-none group-hover:opacity-100 lg:h-4 lg:w-4 [&_path]:fill-current"
        >
          <Fragment set:html={chevronDownDouble} />
        </span>
        <span
          class="pointer-events-none flex h-3 w-3 shrink-0 -rotate-90 items-center justify-center opacity-100 transition-opacity duration-300 select-none group-hover:opacity-0 lg:h-4 lg:w-4 [&_path]:fill-current"
        >
          <Fragment set:html={chevronDownDouble} />
        </span>
      </div>
    </div>
  </div>
</a>
