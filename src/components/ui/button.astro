---
import chevronDownDouble from "../../assets/icons/chevronDownDouble.svg?raw";

interface Props {
  title: string;
  url: string;
  variant?: "primary" | "secondary" | "colored" | "ghost";
  color?: string;
  icon?: any;
  iconColor?: string;
  iconSize?: number;
  target?: string;
  class?: string;
  "data-cta"?: string;
  download?: string | boolean;
}

const {
  title,
  url,
  variant = "primary",
  color = "#0B840E",
  icon,
  iconColor = "#10E80C",
  iconSize,
  target,
  download,
  class: className,
  "data-cta": dataCta,
} = Astro.props;

const baseStyles =
  "rounded-sm inline-flex items-stretch transition-all group overflow-hidden whitespace-nowrap font-semibold";

const variants = {
  primary: "bg-primary text-secondarydark hover:bg-primary/90",
  secondary: "bg-white/15 hover:bg-white/20 border border-default text-primary",
  ghost: "text-primary hover:text-brand-100",
  colored: "text-primary hover:brightness-90 transition-all",
};

const variantStyle = variants[variant];
const customStyle =
  variant === "colored" && color ? { backgroundColor: color } : {};
---

<a
  href={url}
  target={target}
  download={download}
  class:list={[baseStyles, variantStyle, className]}
  style={customStyle}
  {...(dataCta ? { "data-cta": dataCta } : {})}
>
  <span
    class:list={[
      "flex flex-1 items-center gap-2 transition-colors body4",
      variant === "ghost" ? "py-2 px-1" : "p-2 md:py-3 md:px-4",
    ]}
  >
    {
      icon && (
        <span
          class="flex items-center justify-center shrink-0 transition-colors w-(--icon-size,16px) h-(--icon-size,16px) md:w-(--icon-size,18px) md:h-(--icon-size,18px) lg:w-(--icon-size,24px) lg:h-(--icon-size,24px)"
          style={{
            ...((iconSize ? { "--icon-size": `${iconSize}px` } : {}) as any),
            color: iconColor,
          }}
        >
          {typeof icon === "string" && icon.includes("<svg") ? (
            <span class="w-full h-full [&_path]:fill-current pointer-events-none select-none">
              <Fragment set:html={icon} />
            </span>
          ) : (
            <div
              class="w-full h-full bg-current pointer-events-none select-none"
              style={`mask: url(${typeof icon === "string" ? icon : icon.src}) no-repeat center;
                    -webkit-mask: url(${typeof icon === "string" ? icon : icon.src}) no-repeat center;
                    mask-size: contain;
                    -webkit-mask-size: contain;`}
            />
          )}
        </span>
      )
    }
    {title}
  </span>

  <div
    class:list={[
      "shrink-0 flex items-center justify-center overflow-hidden transition-all",
      variant !== "ghost" ? "border-l border-default p-2 md:p-4" : "py-2 px-1",
    ]}
  >
    <div class="w-3 h-3 md:w-4 md:h-4 relative">
      <div
        class="flex transition-transform duration-300 -translate-x-3 md:-translate-x-4 group-hover:translate-x-0"
      >
        <span
          class="w-3 h-3 md:w-4 md:h-4 pointer-events-none select-none
                 flex items-center justify-center shrink-0
                 opacity-0 group-hover:opacity-100 transition-opacity
                 duration-300 [&_path]:fill-current -rotate-90"
        >
          <Fragment set:html={chevronDownDouble} />
        </span>
        <span
          class="w-3 h-3 md:w-4 md:h-4 pointer-events-none select-none
                 flex items-center justify-center shrink-0
                 opacity-100 group-hover:opacity-0 transition-opacity
                 duration-300 [&_path]:fill-current -rotate-90"
        >
          <Fragment set:html={chevronDownDouble} />
        </span>
      </div>
    </div>
  </div>
</a>
