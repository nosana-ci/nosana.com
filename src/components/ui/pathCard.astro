---
import { Image } from "astro:assets";
import NavigateButton from "./navigateButton.astro";
import glowImage from "../../content/homepage/assets/glowImg.svg";

interface Props {
  image: any;
  safariImage?: any;
  title: string;
  description: string;
  caption: string;
  url: string;
}

const { image, safariImage, title, description, caption, url } = Astro.props;
const [titleMain, titleSub] = title.split("-");
---

<div
  class="group/pathcard border-elevated flex h-full w-full flex-col justify-between gap-4 rounded-lg border p-4 md:gap-6 md:p-6"
>
  <div>
    <div class="relative overflow-hidden pb-4">
      <Image
        src={glowImage}
        alt="glow"
        aria-hidden="true"
        quality={100}
        class="pointer-events-none absolute inset-0 z-20 h-auto w-full opacity-0 transition-opacity duration-300 group-hover/pathcard:opacity-100"
      />

      <img
        src={image.src ?? image}
        data-safari-src={safariImage?.src ?? safariImage}
        alt={title}
        class="path-card-image border-elevated relative z-10 h-auto w-full border select-none"
      />
    </div>

    <div class="flex flex-col gap-4">
      <h3 class="text-primary h4 grotesk max-w-[450px]">
        {titleMain}
        <span class="text-brand-100"> {titleSub}</span>
      </h3>

      <p class="text-secondary body2">{description}</p>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <span class="text-secondary body4">{caption}</span>

    <div class="flex items-center gap-2">
      <span class="text-secondary body4">Learn More</span>

      <a href={url}>
        <NavigateButton variant="secondary" direction="right" />
      </a>
    </div>
  </div>
</div>
