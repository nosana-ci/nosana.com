---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  showTitle?: boolean;
}

const { showTitle = false } = Astro.props;

const entry = await getEntry("layout", "index");
if (!entry) {
  throw new Error("Layout content not found");
}

const { title, links } = entry.data.socials;
---

<div>
  {
    showTitle && (
      <h5 class="text-pprimary text-center py-4 h5 grotesk">{title}</h5>
    )
  }
  <div class="flex flex-wrap gap-3">
    {
      links.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.name}
          class="w-8 lg:w-10 h-8 lg:h-10 rounded-full border border-default
               flex items-center justify-center group transition"
        >
          <Image
            src={social.icon}
            alt={social.name}
            class="w-[14px] lg:w-[18px] h-[14px] lg:h-[18px] select-none brightness-0 invert group-hover:brightness-100 group-hover:invert-0 transition"
          />
        </a>
      ))
    }
  </div>
</div>
