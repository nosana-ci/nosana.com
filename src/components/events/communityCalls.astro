---
import { getEntry } from "astro:content";

const entry = await getEntry("communityCalls", "index");
if (!entry) return;

const { title, description, nextCallDate } = entry.data;

const lastUpdatedFormatted = new Date().toLocaleString("en-US", {
  month: "numeric",
  day: "numeric",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
  second: "2-digit",
  hour12: true,
});

let calls: { meeting: string; time: string; recordingUrl: string; }[] = [];
try {
  const apiUrl = new URL("/api/community-calls", Astro.url);
  const response = await fetch(apiUrl);
  if (response.ok) {
    const data = await response.json();
    calls = data.calls || [];
  }
} catch (error) {
  console.error("[communityCalls.astro] Failed to fetch community calls:", error);
}
---

<section id="community-calls" class="w-full px-4 py-10 md:px-12 md:py-24">
  <div class="mb-10 flex flex-col gap-4">
    <h2 class="text-primary h1 grotesk">{title}</h2>
    <p class="text-secondary body3 max-w-6xl">{description}</p>
  </div>

  <div class="w-full overflow-x-auto">
    <table class="w-full border-collapse text-center">
      <thead>
        <tr class="border-elevated bg-surface border">
          <th
            class="text-secondary body4 border-elevated border px-6 py-4 font-normal"
          >
            Meeting
          </th>
          <th
            class="text-secondary body4 border-elevated border px-6 py-4 font-normal"
          >
            Time
          </th>
          <th
            class="text-secondary body4 border-elevated border px-6 py-4 font-normal"
          >
            Recording
          </th>
        </tr>
      </thead>

      <tbody>
        {
          calls.map((call, index) => (
            <tr 
              class="border-elevated bg-surface/40 border transition community-call-row"
              style={{ display: index >= 6 ? 'none' : '' }}
            >
              <td class="text-primary body4 border-elevated border px-6 py-4">
                #{index + 1}
              </td>
              <td class="text-primary body4 border-elevated border px-6 py-4">
                {call.time}
              </td>
              <td class="border-elevated border px-6 py-4">
                <a
                  href={call.recordingUrl}
                  target="_blank"
                  class="text-brand-100 body4 hover:text-brand-200 inline-flex items-center gap-1.5 transition"
                >
                  Link
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {calls.length > 6 && (
    <button 
      id="community-show-more-btn"
      class="w-full border-elevated border-x border-b bg-surface/40 hover:bg-surface/80 transition py-4 px-6 text-primary body4 flex justify-center items-center cursor-pointer"
    >
      Show More
    </button>
  )}

  <div
    class="mt-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"
  >
    <p class="text-secondary body4">
      The next community call will take place on<br />
      <span class="text-primary">{nextCallDate}.</span>
    </p>
    <p class="text-secondary caption1 text-right">
      Last update:<br />
      <span class="text-primary">{lastUpdatedFormatted}</span>
    </p>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const showMoreBtn = document.getElementById("community-show-more-btn");
    const rows = document.querySelectorAll(".community-call-row");
    let visibleCount = 6;

    if (showMoreBtn) {
      showMoreBtn.addEventListener("click", () => {
        let shownInThisClick = 0;
        
        for (let i = visibleCount; i < rows.length; i++) {
          if (shownInThisClick < 4) {
            (rows[i] as HTMLElement).style.display = "";
            shownInThisClick++;
            visibleCount++;
          } else {
            break;
          }
        }

        if (visibleCount >= rows.length) {
          showMoreBtn.style.display = 'none';
        }
      });
    }
  });
</script>
