---
import Pagination from "../ui/pagination.astro";
import Button from "../ui/button.astro";

const CARDS_PER_PAGE = 2;
---

<section class="w-full px-4 lg:px-12">
  <div class="mb-10 flex flex-col gap-2">
    <h2 class="text-primary h1 grotesk">Live Session</h2>
    <p class="text-secondary body3">All sessions and recordings in one place.</p>
  </div>

  <!-- Featured session -->
  <div class="mb-14 flex flex-col gap-8 lg:flex-row lg:gap-12">
    <div class="aspect-video w-full shrink-0 overflow-hidden rounded-lg lg:w-[45%]">
      <iframe
        id="featured-iframe"
        class="h-full w-full"
        allow="autoplay; encrypted-media; fullscreen"
        allowfullscreen>
      </iframe>
    </div>

    <div class="flex flex-col gap-5">

      <!-- Dynamic label -->
      <span id="featured-label" class="text-brand-100 body3">
        Upcoming
      </span>

      <h3
        id="featured-title"
        class="text-primary h4 grotesk leading-snug line-clamp-3">
      </h3>

      <p
        id="featured-description"
        class="text-secondary body2 line-clamp-4">
      </p>

      <div id="featured-button">
        <Button
          title="Watch Now"
          url="#"
          variant="secondary"
          target="_blank"
        />
      </div>

    </div>
  </div>

  <!-- More Sessions -->
  <div class="flex flex-col gap-8">
    <h4 class="text-primary h5 grotesk">More Sessions</h4>

    <div
      id="sessions-grid"
      class="grid grid-cols-1 gap-4 min-[1200px]:grid-cols-2">
    </div>

    <!-- Template -->
    <template id="session-template">
      <div class="session-card border-elevated flex flex-col sm:flex-row gap-6 overflow-hidden border p-4 md:p-6">

        <!-- Thumbnail -->
        <div class="aspect-video sm:w-[45%] shrink-0 overflow-hidden rounded">
          <img class="h-full w-full object-cover session-thumbnail" />
        </div>

        <!-- Content -->
        <div class="flex flex-1 flex-col justify-between gap-3 py-1 sm:py-2">

          <div class="flex flex-col gap-1.5">
            <span class="text-tertiary caption1 session-date"></span>

            <h5 class="text-primary body3 font-semibold leading-snug line-clamp-3 session-title"></h5>
          </div>

          <div class="session-button">
            <Button
              title="Watch Now"
              url="#"
              variant="secondary"
              target="_blank"
            />
          </div>

        </div>
      </div>
    </template>

    <div class="mx-auto mt-8">
      <Pagination
        id="sessions-pagination"
        items={["1"]}
        activeIndex={0}
        maxVisible={5}
      />
    </div>
  </div>
</section>

<script>
const CARDS_PER_PAGE = 2

function timeAgo(date) {

  const now = new Date()

  const months =
    (now.getFullYear() - date.getFullYear()) * 12 +
    (now.getMonth() - date.getMonth())

  if (months < 1) return "This month"
  if (months === 1) return "1 Month ago"

  return months + " Months ago"
}

async function loadSessions() {

  const res = await fetch("/api/sessions")
  const data = await res.json()

  let featured = data.featured
  let sessions = data.sessions || []

  if (!featured && sessions.length) {
    featured = sessions[0]
    sessions = sessions.slice(1)
  }

  // Sort newest first
  sessions.sort((a,b)=> new Date(b.publishedAt) - new Date(a.publishedAt))

  renderFeatured(featured)
  renderSessions(sessions)
}

function renderFeatured(session) {

  if (!session) return

  const iframe = document.getElementById("featured-iframe")
  const title = document.getElementById("featured-title")
  const desc = document.getElementById("featured-description")
  const label = document.getElementById("featured-label")
  const buttonWrapper = document.getElementById("featured-button")

  if (!iframe || !title || !desc || !label || !buttonWrapper) return

  iframe.src = session.embedLink
  title.textContent = session.title
  desc.textContent = session.description

  const btn = buttonWrapper.querySelector("a")
  if (btn) btn.href = session.watchUrl

  if (session.isUpcoming) {

    const date = new Date(session.publishedAt)

    const formatted =
      date.toLocaleDateString(undefined,{
        month:"short",
        day:"numeric",
        year:"numeric"
      })

    label.textContent = `Upcoming • ${formatted}`

  } else {

    label.textContent = "Latest"

  }
}

function renderSessions(sessions) {

  const grid = document.getElementById("sessions-grid")
  const template = document.getElementById("session-template")

  if (!grid || !template) return

  grid.innerHTML = ""

  sessions.forEach((session, i) => {

    const node = template.content.cloneNode(true)

    const card = node.querySelector(".session-card")
    const thumb = node.querySelector(".session-thumbnail")
    const title = node.querySelector(".session-title")
    const date = node.querySelector(".session-date")
    const buttonContainer = node.querySelector(".session-button")

    if (!card || !thumb || !title || !date || !buttonContainer) return

    card.dataset.page = Math.floor(i / CARDS_PER_PAGE)

    if (i >= CARDS_PER_PAGE) card.style.display = "none"

    thumb.src = session.thumbnail
    thumb.alt = session.title

    title.textContent = session.title
    date.textContent = timeAgo(new Date(session.publishedAt))

    const btn = buttonContainer.querySelector("a")
    if (btn) btn.href = session.watchUrl

    grid.appendChild(node)
  })

  updatePagination(sessions.length)
}

function updatePagination(totalSessions) {

  const totalPages = Math.max(1, Math.ceil(totalSessions / CARDS_PER_PAGE))
  const pagination = document.getElementById("sessions-pagination")

  if (!pagination) return

  const pages = Array.from({ length: totalPages }, (_, i) => String(i + 1))

  pagination.dispatchEvent(
    new CustomEvent("pagination:update", {
      detail: {
        id: "sessions-pagination",
        items: pages
      }
    })
  )
}

document.addEventListener("pagination:change", (e) => {

  const detail = e.detail

  if (detail.id !== "sessions-pagination") return

  document.querySelectorAll(".session-card").forEach((card) => {

    const page = Number(card.dataset.page || 0)

    card.style.display = page === detail.index ? "" : "none"
  })
})

document.addEventListener("DOMContentLoaded", () => {
  loadSessions().catch(console.error)
})
</script>