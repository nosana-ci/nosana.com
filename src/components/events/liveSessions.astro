---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Pagination from "../ui/pagination.astro";
import Button from "../ui/button.astro";

const allSessions = await getCollection("sessions");

const sessions = allSessions.sort(
  (a, b) =>
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime(),
);

const featured = sessions.find((s) => s.data.featured) ?? sessions[0];
const moreSessions = sessions.filter((s) => s.id !== featured.id);

const CARDS_PER_PAGE = 2;
const totalPages = Math.max(1, Math.ceil(moreSessions.length / CARDS_PER_PAGE));
const pageLabels = Array.from({ length: totalPages }, (_, i) => String(i + 1));

function timeAgo(date: Date): string {
  const now = new Date();
  const months =
    (now.getFullYear() - date.getFullYear()) * 12 +
    (now.getMonth() - date.getMonth());
  if (months < 1) return "This month";
  if (months === 1) return "1 Month ago";
  return `${months} Months ago`;
}

// ── Icon definitions ──────────────────────────────────────────────────────────
const icons = {
  web: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.5"/>
    <ellipse cx="12" cy="12" rx="3.5" ry="9.5" stroke="currentColor" stroke-width="1.5"/>
    <path d="M2.5 9h19M2.5 15h19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>`,
  youtube: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z" stroke="currentColor" stroke-width="1.5"/>
    <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>`,
  x: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
  </svg>`,
} as const;

// Small variant (15px) for session cards
const iconsSmall = {
  web: icons.web.replace(/width="18" height="18"/g, 'width="15" height="15"'),
  youtube: icons.youtube.replace(/width="18" height="18"/g, 'width="15" height="15"'),
  x: icons.x.replace(/width="16" height="16"/g, 'width="13" height="13"'),
} as const;
---

<section class="w-full px-4 lg:px-12">
  <div class="mb-10 flex flex-col gap-2">
    <h2 class="text-primary h1 grotesk">Live Session</h2>
    <p class="text-secondary body3">All sessions and recordings in one place.</p>
  </div>

  <!-- Featured session -->
  <div class="mb-14 flex flex-col gap-8 lg:flex-row lg:gap-12">
    <div class="w-full shrink-0 overflow-hidden rounded-lg lg:w-[45%]">
      <Image
        src={featured.data.thumbnail}
        alt={featured.data.title}
        class="h-full w-full object-cover"
      />
    </div>

    <div class="flex flex-col gap-5">
      <span class="text-brand-100 body3">Latest</span>

      <h3 class="text-primary h4 grotesk leading-snug">
        {featured.data.title}
      </h3>

      <p class="text-secondary body2">
        {featured.data.description}
      </p>

      <div class="flex items-center gap-3">
        <span class="text-secondary body4">Watch on</span>
        <div class="flex items-center gap-2">
          {featured.data.watchOnWeb && (
            <a href={featured.data.watchOnWeb} target="_blank"
               class="text-secondary hover:text-primary transition" aria-label="Watch on Web"
               set:html={icons.web} />
          )}
          {featured.data.watchOnYoutube && (
            <a href={featured.data.watchOnYoutube} target="_blank"
               class="text-secondary hover:text-primary transition" aria-label="Watch on YouTube"
               set:html={icons.youtube} />
          )}
          {featured.data.watchOnX && (
            <a href={featured.data.watchOnX} target="_blank"
               class="text-secondary hover:text-primary transition" aria-label="Watch on X"
               set:html={icons.x} />
          )}
        </div>
      </div>

      <div>
        <Button
          title="Watch Now"
          url={featured.data.watchUrl}
          variant="secondary"
          target="_blank"
          data-cta="watch"
        />
      </div>
    </div>
  </div>

  <!-- More Sessions -->
  {moreSessions.length > 0 && (
    <div class="flex flex-col gap-8">
      <h4 class="text-primary h5 grotesk">More Sessions</h4>

      <div
        id="sessions-grid"
        class="grid grid-cols-1 gap-4 min-[1200px]:grid-cols-2"
      >
        {moreSessions.map((session, i) => (
          <div
            class="session-card border-elevated flex flex-col sm:flex-row gap-6 overflow-hidden border p-4 md:p-6"
            data-page={Math.floor(i / CARDS_PER_PAGE)}
            style={i >= CARDS_PER_PAGE ? "display:none" : ""}
          >
            <!-- Thumbnail -->
            <div class="aspect-video sm:aspect-auto sm:w-[45%] shrink-0 overflow-hidden rounded">
              <Image
                src={session.data.thumbnail}
                alt={session.data.title}
                class="h-full w-full object-cover"
              />
            </div>

            <!-- Content -->
            <div class="flex flex-1 flex-col justify-between gap-3 py-1 sm:py-2">
              <div class="flex flex-col gap-1.5">
                <span class="text-tertiary caption1">
                  {timeAgo(new Date(session.data.publishedAt))}
                </span>
                <h5 class="text-primary body3 font-semibold leading-snug line-clamp-3">
                  {session.data.title}
                </h5>
              </div>

              <div class="flex flex-col gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-secondary caption1">Watch on</span>
                  <div class="flex items-center gap-1.5">
                    {session.data.watchOnWeb && (
                      <a href={session.data.watchOnWeb} target="_blank"
                         class="text-secondary hover:text-primary transition" aria-label="Web"
                         set:html={iconsSmall.web} />
                    )}
                    {session.data.watchOnYoutube && (
                      <a href={session.data.watchOnYoutube} target="_blank"
                         class="text-secondary hover:text-primary transition" aria-label="YouTube"
                         set:html={iconsSmall.youtube} />
                    )}
                    {session.data.watchOnX && (
                      <a href={session.data.watchOnX} target="_blank"
                         class="text-secondary hover:text-primary transition" aria-label="X"
                         set:html={iconsSmall.x} />
                    )}
                  </div>
                </div>

                <div>
                  <Button
                    title="Watch Now"
                    url={session.data.watchUrl}
                    variant="secondary"
                    target="_blank"
                    data-cta="watch"
                  />
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mx-auto mt-8">
        <Pagination
          id="sessions-pagination"
          items={pageLabels}
          activeIndex={0}
          maxVisible={5}
        />
      </div>
    </div>
  )}
</section>

<script>
  document.addEventListener("pagination:change", (e: Event) => {
    const { id, index } = (e as CustomEvent).detail;
    if (id !== "sessions-pagination") return;

    document.querySelectorAll<HTMLElement>(".session-card").forEach((card) => {
      card.style.display =
        parseInt(card.dataset.page || "0") === index ? "" : "none";
    });
  });
</script>
