---
import { getCollection } from "astro:content";
import EventCard from "./eventCard.astro";
import Pagination from "../ui/pagination.astro";

const allEvents = await getCollection("events");

const events = allEvents.sort(
  (a, b) =>
    new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime(),
);

const shortMonths = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];

const now = new Date();
const currentMonth = now.getMonth();
const currentYear = now.getFullYear();
---

<section class="w-full px-4 lg:px-12">
  <div id="events-list" class="flex flex-col gap-12">
    {
      events.map((event) => {
        const date = new Date(event.data.createdAt);
        const month = date.getMonth();
        const year = date.getFullYear();
        const dateLabel = date.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        });
        return (
          <div
            class="event-item flex flex-col gap-6"
            data-month={month}
            data-year={year}
            data-title={event.data.title.toLowerCase()}
            data-date-label={dateLabel}
          >
            <p class="text-tertiary body3 pb-4">{dateLabel}</p>
            <EventCard
              title={event.data.title}
              description={event.data.description}
              thumbnail={event.data.thumbnail}
              createdAt={new Date(event.data.createdAt)}
              time={event.data.time}
              url={event.data.url}
            />
          </div>
        );
      })
    }
  </div>

  <p
    id="events-empty"
    class="text-tertiary body3 hidden py-20 text-center"
  >
    No events found for selected month and year.
  </p>

  <div class="mx-auto mt-12 flex justify-center">
    <Pagination
      id="events-pagination"
      items={shortMonths}
      activeIndex={currentMonth}
      maxVisible={5}
    />
  </div>
</section>

<script>
  const monthSelect = document.getElementById(
    "events-month",
  ) as HTMLSelectElement | null;
  const yearSelect = document.getElementById(
    "events-year",
  ) as HTMLSelectElement | null;
  const monthSelectMobile = document.getElementById(
    "events-month-mobile",
  ) as HTMLSelectElement | null;
  const yearSelectMobile = document.getElementById(
    "events-year-mobile",
  ) as HTMLSelectElement | null;
  const searchInput = document.getElementById(
    "events-search",
  ) as HTMLInputElement | null;
  const searchInputDesktop = document.getElementById(
    "events-search-desktop",
  ) as HTMLInputElement | null;
  const paginationRoot = document.getElementById("events-pagination");
  const eventItems = document.querySelectorAll<HTMLElement>(".event-item");
  const emptyMsg = document.getElementById("events-empty");
  const eventsList = document.getElementById("events-list");

  const shortMonths = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ];

  let activeMonth = new Date().getMonth();
  let activeYear = new Date().getFullYear();
  let searchQuery = "";

  function filterEvents() {
    let visibleCount = 0;
    eventItems.forEach((item) => {
      const m = parseInt(item.dataset.month || "-1");
      const y = parseInt(item.dataset.year || "-1");
      const title = item.dataset.title || "";

      const searchMatch = !searchQuery || title.includes(searchQuery.toLowerCase());

      // When searching, ignore month/year filters
      const visible = searchQuery
        ? searchMatch
        : m === activeMonth && y === activeYear;

      item.style.display = visible ? "" : "none";
      if (visible) visibleCount++;
    });

    if (emptyMsg) emptyMsg.classList.toggle("hidden", visibleCount > 0);
    if (eventsList) eventsList.classList.toggle("hidden", visibleCount === 0);
  }

  // Sync pagination to external changes
  function setPaginationIndex(index: number) {
    if (!paginationRoot) return;
    paginationRoot.dataset.active = String(index);
    paginationRoot.dispatchEvent(
      new CustomEvent("pagination:set", { detail: { index } }),
    );
  }

  // Sync all month selects to a given value
  function syncMonthSelects(value: string) {
    if (monthSelect) monthSelect.value = value;
    if (monthSelectMobile) monthSelectMobile.value = value;
  }

  // Listen for pagination changes
  document.addEventListener("pagination:change", (e: Event) => {
    const { id, index } = (e as CustomEvent).detail;
    if (id !== "events-pagination") return;
    activeMonth = index;
    syncMonthSelects(shortMonths[index]);
    filterEvents();
  });

  // Desktop month dropdown
  if (monthSelect) {
    monthSelect.addEventListener("change", () => {
      activeMonth = shortMonths.indexOf(monthSelect.value);
      if (monthSelectMobile) monthSelectMobile.value = monthSelect.value;
      setPaginationIndex(activeMonth);
      filterEvents();
    });
  }

  // Mobile month dropdown
  if (monthSelectMobile) {
    monthSelectMobile.addEventListener("change", () => {
      activeMonth = shortMonths.indexOf(monthSelectMobile.value);
      if (monthSelect) monthSelect.value = monthSelectMobile.value;
      setPaginationIndex(activeMonth);
      filterEvents();
    });
  }

  // Desktop year dropdown
  if (yearSelect) {
    yearSelect.addEventListener("change", () => {
      activeYear = parseInt(yearSelect.value);
      if (yearSelectMobile) yearSelectMobile.value = yearSelect.value;
      filterEvents();
    });
  }

  // Mobile year dropdown
  if (yearSelectMobile) {
    yearSelectMobile.addEventListener("change", () => {
      activeYear = parseInt(yearSelectMobile.value);
      if (yearSelect) yearSelect.value = yearSelectMobile.value;
      filterEvents();
    });
  }

  // Mobile search input (toggled by icon)
  if (searchInput) {
    searchInput.addEventListener("input", () => {
      searchQuery = searchInput.value.trim();
      filterEvents();
    });
  }

  // Desktop search input
  if (searchInputDesktop) {
    searchInputDesktop.addEventListener("input", () => {
      searchQuery = searchInputDesktop.value.trim();
      filterEvents();
    });
  }

  // Initial filter
  filterEvents();
</script>
