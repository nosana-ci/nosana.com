---
import { getCollection } from "astro:content";
import EventCard from "./eventCard.astro";
import Pagination from "../ui/pagination.astro";

const allEvents = await getCollection("events");

const events = allEvents.sort(
  (a, b) =>
    new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime(),
);

const shortMonths = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];

const now = new Date();
const currentMonth = now.getMonth();
const currentYear = now.getFullYear();
---

<section class="w-full px-4 lg:px-12">
  <div id="events-list" class="flex flex-col gap-12">
    {
      events.map((event, index) => {
        const date = new Date(event.data.createdAt);
        const month = date.getMonth();
        const year = date.getFullYear();
        const dateLabel = date.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        });
        return (
          <div
            class="event-item flex flex-col gap-6"
            data-month={month}
            data-year={year}
            data-title={event.data.title.toLowerCase()}
            data-date-label={dateLabel}
          >
            <p class="text-tertiary body3 pb-4">{dateLabel}</p>
            <EventCard
              title={event.data.title}
              description={event.data.description}
              thumbnail={event.data.thumbnail}
              createdAt={new Date(event.data.createdAt)}
              time={event.data.time}
              url={event.data.url}
            />
          </div>
        );
      })
    }
  </div>

  <p
    id="events-empty"
    class="text-tertiary body3 hidden py-20 text-center"
  >
    No events found for selected filters.
  </p>

  <div id="events-pagination-container" class="mx-auto mt-12 flex justify-center">
    <Pagination
      id="events-pagination"
      items={["1"]}
      activeIndex={0}
      maxVisible={5}
    />
  </div>
</section>

<script>
  const monthSelect = document.getElementById(
    "events-month",
  ) as HTMLSelectElement | null;
  const yearSelect = document.getElementById(
    "events-year",
  ) as HTMLSelectElement | null;
  const monthSelectMobile = document.getElementById(
    "events-month-mobile",
  ) as HTMLSelectElement | null;
  const yearSelectMobile = document.getElementById(
    "events-year-mobile",
  ) as HTMLSelectElement | null;
  const searchInput = document.getElementById(
    "events-search",
  ) as HTMLInputElement | null;
  const searchInputDesktop = document.getElementById(
    "events-search-desktop",
  ) as HTMLInputElement | null;
  
  const paginationRoot = document.getElementById("events-pagination");
  const paginationContainer = document.getElementById("events-pagination-container");
  const eventItems = document.querySelectorAll<HTMLElement>(".event-item");
  const emptyMsg = document.getElementById("events-empty");
  const eventsList = document.getElementById("events-list");
  
  const resetBtn = document.getElementById("events-reset");
  const resetBtnMobile = document.getElementById("events-reset-mobile");

  const monthsList = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ];

  let activeMonth = -1; // -1 for "All"
  let activeYear = -1;  // -1 for "All"
  let activePage = 0;
  let searchQuery = "";
  const itemsPerPage = 4;

  function filterEvents() {
    // 1. Determine matches based on filters
    const matches: HTMLElement[] = [];
    eventItems.forEach((item) => {
      const m = parseInt(item.dataset.month || "-1");
      const y = parseInt(item.dataset.year || "-1");
      const title = item.dataset.title || "";

      const monthMatch = activeMonth === -1 || m === activeMonth;
      const yearMatch = activeYear === -1 || y === activeYear;
      const searchMatch = !searchQuery || title.includes(searchQuery.toLowerCase());

      if (monthMatch && yearMatch && searchMatch) {
        matches.push(item);
      }
      
      // Initially hide all
      item.style.display = "none";
    });

    // 2. Calculate pagination
    const totalPages = Math.ceil(matches.length / itemsPerPage);
    if (activePage >= totalPages) activePage = Math.max(0, totalPages - 1);

    // 3. Show items for current page
    const start = activePage * itemsPerPage;
    const end = start + itemsPerPage;
    const pageMatches = matches.slice(start, end);
    
    pageMatches.forEach(item => {
      item.style.display = "";
    });

    // 4. Update empty state
    if (emptyMsg) emptyMsg.classList.toggle("hidden", matches.length > 0);
    if (eventsList) eventsList.classList.toggle("hidden", matches.length === 0);

    // 5. Show/Hide Reset Button
    const isFiltered = activeMonth !== -1 || activeYear !== -1 || searchQuery !== "";
    if (resetBtn) resetBtn.style.display = isFiltered ? "flex" : "none";
    if (resetBtnMobile) resetBtnMobile.style.display = isFiltered ? "flex" : "none";

    // 6. Update pagination UI
    if (paginationContainer) {
      paginationContainer.classList.toggle("hidden", totalPages <= 1);
    }

    if (paginationRoot && totalPages > 1) {
      const pageItems = Array.from({ length: totalPages }, (_, i) => String(i + 1));
      paginationRoot.dispatchEvent(
        new CustomEvent("pagination:update", { 
          detail: { 
            items: pageItems,
            active: activePage 
          } 
        })
      );
    }
  }

  function resetFilters() {
    activeMonth = -1;
    activeYear = -1;
    activePage = 0;
    searchQuery = "";

    if (monthSelect) monthSelect.value = "All";
    if (monthSelectMobile) monthSelectMobile.value = "All";
    if (yearSelect) yearSelect.value = "All";
    if (yearSelectMobile) yearSelectMobile.value = "All";
    if (searchInput) searchInput.value = "";
    if (searchInputDesktop) searchInputDesktop.value = "";

    filterEvents();
  }

  resetBtn?.addEventListener("click", resetFilters);
  resetBtnMobile?.addEventListener("click", resetFilters);

  // Listen for pagination changes
  document.addEventListener("pagination:change", (e: Event) => {
    const { id, index } = (e as CustomEvent).detail;
    if (id !== "events-pagination") return;
    if (activePage !== index) {
      activePage = index;
      filterEvents();
      // Scroll to top of list
      eventsList?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // Desktop month dropdown
  if (monthSelect) {
    monthSelect.addEventListener("change", () => {
      activeMonth = monthSelect.value === "All" ? -1 : monthsList.indexOf(monthSelect.value);
      if (monthSelectMobile) monthSelectMobile.value = monthSelect.value;
      activePage = 0;
      filterEvents();
    });
  }

  // Mobile month dropdown
  if (monthSelectMobile) {
    monthSelectMobile.addEventListener("change", () => {
      activeMonth = monthSelectMobile.value === "All" ? -1 : monthsList.indexOf(monthSelectMobile.value);
      if (monthSelect) monthSelect.value = monthSelectMobile.value;
      activePage = 0;
      filterEvents();
    });
  }

  // Desktop year dropdown
  if (yearSelect) {
    yearSelect.addEventListener("change", () => {
      activeYear = yearSelect.value === "All" ? -1 : parseInt(yearSelect.value);
      if (yearSelectMobile) yearSelectMobile.value = yearSelect.value;
      activePage = 0;
      filterEvents();
    });
  }

  // Mobile year dropdown
  if (yearSelectMobile) {
    yearSelectMobile.addEventListener("change", () => {
      activeYear = yearSelectMobile.value === "All" ? -1 : parseInt(yearSelectMobile.value);
      if (yearSelect) yearSelect.value = yearSelectMobile.value;
      activePage = 0;
      filterEvents();
    });
  }

  // Mobile search input
  if (searchInput) {
    searchInput.addEventListener("input", () => {
      searchQuery = searchInput.value.trim();
      activePage = 0;
      filterEvents();
    });
  }

  // Desktop search input
  if (searchInputDesktop) {
    searchInputDesktop.addEventListener("input", () => {
      searchQuery = searchInputDesktop.value.trim();
      activePage = 0;
      filterEvents();
    });
  }

  // Initial filter
  filterEvents();
</script>
