---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";

const latestEvent = await getEntry("events", "buidl-day-at-token2049");

if (!latestEvent) return null;

const { title, description, thumbnail, createdAt, time, url } =
  latestEvent.data;

const eventDate = new Date(createdAt);

const month = eventDate
  .toLocaleDateString("en-US", { month: "short" })
  .toUpperCase();

const day = eventDate.getDate();

const fullDate = eventDate.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<section class="w-full">
  <div class="px-4 lg:px-12">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="group grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center cursor-pointer"
    >
      <div class="w-full overflow-hidden">
        <Image
          src={thumbnail}
          alt={title}
          class="w-full h-auto select-none pointer-events-none"
        />
      </div>

      <div class="flex flex-col gap-8 lg:gap-10 flex-1">
        <Badge title="Latest Event" class="w-fit" />

        <div class="flex flex-col gap-4">
          <h2 class="text-primary h4 grotesk lg:line-clamp-2 lg:max-w-xl transition-colors duration-300 group-hover:text-brand-100">
            {title}
          </h2>

          <p class="text-secondary body2 lg:max-w-2xl lg:line-clamp-3">
            {description}
          </p>
        </div>

        <div class="flex items-start gap-4">

          <div class="w-12 h-12 rounded-lg overflow-hidden flex flex-col shrink-0">
            
            <div class="h-[30%] bg-[#C9C9C9] flex items-center justify-center">
              <span class="text-[10px] font-medium text-black leading-none">
                {month}
              </span>
            </div>

            <div class="h-[70%] bg-surface flex items-center justify-center">
              <span class="text-primary text-sm font-semibold leading-none">
                {day}
              </span>
            </div>
          </div>

          <div class="flex flex-col">
            <span class="text-primary body4">
              {fullDate}
            </span>

            {time && (
              <span class="text-secondary caption1">
                {time}
              </span>
            )}
          </div>

        </div>
      </div>
    </a>
  </div>
</section>
