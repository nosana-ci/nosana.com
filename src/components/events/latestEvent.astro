---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import { getYouTubeData } from "../../utils/youtube";

const now = new Date();

const events = await getCollection("events");
const { featured } = await getYouTubeData();

let upcomingItems = [];
let pastEvents = [];

for (const event of events) {

  const eventDate = new Date(event.data.createdAt);

  if (eventDate >= now) {
    upcomingItems.push({
      type: "event",
      date: eventDate,
      data: event.data,
    });
  } else {
    pastEvents.push({
      type: "event",
      date: eventDate,
      data: event.data,
    });
  }
}

if (featured) {

  const sessionDate = new Date(featured.publishedAt);

  if (sessionDate >= now) {
    upcomingItems.push({
      type: "session",
      date: sessionDate,
      data: featured,
    });
  }
}

let selected;

if (upcomingItems.length) {

  upcomingItems.sort((a, b) => a.date - b.date);
  selected = upcomingItems[0];

} else {

  pastEvents.sort((a, b) => b.date - a.date);
  selected = pastEvents[0];
}

if (!selected) return null;

let title;
let description;
let thumbnail;
let createdAt;
let time;
let url;
let badgeTitle;
let embedLink;
let isSession = false;

if (selected.type === "event") {

  ({ title, description, thumbnail, createdAt, time, url } = selected.data);
  badgeTitle = "Upcoming Event";

} else {

  title = selected.data.title;
  description = selected.data.description;
  thumbnail = selected.data.thumbnail;
  createdAt = selected.data.publishedAt;
  embedLink = selected.data.embedLink;
  time = "";
  url = selected.data.watchUrl;

  badgeTitle = "Upcoming Session";
  isSession = true;
}

const displayDate = new Date(createdAt);

const month = displayDate
  .toLocaleDateString("en-US", { month: "short" })
  .toUpperCase();

const day = displayDate.getDate();

const fullDate = displayDate.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<section class="w-full">
  <div class="px-4 lg:px-12">

    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="group grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center cursor-pointer"
    >

      <div class="w-full overflow-hidden aspect-video rounded-lg relative">

        {
          isSession ? (

            <>
              <!-- Click overlay -->
              <button
                class="absolute inset-0 z-10 cursor-pointer"
                id="video-overlay"
                aria-label="Activate video"
              />

              <iframe
                src={embedLink}
                class="w-full h-full pointer-events-none"
                allow="autoplay; encrypted-media; fullscreen"
                allowfullscreen
                id="session-video"
              />
            </>

          ) : (

            typeof thumbnail === "string" ? (
              <img
                src={thumbnail}
                alt={title}
                class="w-full h-full object-cover select-none pointer-events-none"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Image
                src={thumbnail}
                alt={title}
                class="w-full h-full object-cover select-none pointer-events-none"
                loading="lazy"
                decoding="async"
              />
            )

          )
        }

      </div>

      <div class="flex flex-col gap-8 lg:gap-10 flex-1">

        <Badge title={badgeTitle} class="w-fit" />

        <div class="flex flex-col gap-4">

          <h2 class="text-primary h4 grotesk lg:line-clamp-2 lg:max-w-xl transition-colors duration-300 group-hover:text-brand-100">
            {title}
          </h2>

          <p class="text-secondary body2 lg:max-w-2xl lg:line-clamp-3">
            {description}
          </p>

        </div>

        <div class="flex items-start gap-4">

          <div class="w-12 h-12 rounded-lg overflow-hidden flex flex-col shrink-0">

            <div class="h-[30%] bg-[#C9C9C9] flex items-center justify-center">
              <span class="text-[10px] font-medium text-black leading-none">
                {month}
              </span>
            </div>

            <div class="h-[70%] bg-surface flex items-center justify-center">
              <span class="text-primary text-sm font-semibold leading-none">
                {day}
              </span>
            </div>

          </div>

          <div class="flex flex-col">

            <span class="text-primary body4">
              {fullDate}
            </span>

            {time && (
              <span class="text-secondary caption1">
                {time}
              </span>
            )}

          </div>

        </div>

      </div>

    </a>

  </div>
</section>