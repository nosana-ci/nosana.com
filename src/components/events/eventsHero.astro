---
const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];

const now = new Date();
const currentMonthName = months[now.getMonth()];
const currentYear = now.getFullYear();

const years = [2023, 2024, 2025, 2026];
const defaultYear = years.includes(currentYear) ? currentYear : 2025;
---

<section class="w-full px-4 py-10 md:px-12 md:py-16">
  <div class="mb-10 flex flex-col gap-4 md:mb-12">
    <h1 class="text-primary h2 grotesk">Events & Community</h1>
    <p class="text-secondary body3 max-w-lg">
      Join us at global tech events, meetups, and hackathons shaping the future
      of AI infrastructure
    </p>
  </div>

  <!-- Mobile layout: dropdowns left, search icon right -->
  <div class="flex items-center justify-between sm:hidden">
    <!-- Month + Year group -->
    <div class="flex items-center gap-2">
      <!-- Month -->
      <div class="relative w-[130px] shrink-0">
        <select
          id="events-month-mobile"
          class="bg-surface text-secondary body3 focus:outline-default w-full cursor-pointer appearance-none rounded px-3 py-3 pr-7 focus:outline"
        >
          {
            months.map((month) => (
              <option
                value={month}
                selected={month === currentMonthName}
                class="bg-surface text-secondary [font-size:inherit]"
              >
                {month}
              </option>
            ))
          }
        </select>
        <span class="text-tertiary pointer-events-none absolute top-1/2 right-2 -translate-y-1/2">
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>

      <!-- Year -->
      <div class="relative">
        <select
          id="events-year-mobile"
          class="bg-surface text-secondary body3 focus:outline-default cursor-pointer appearance-none rounded px-3 py-3 pr-7 focus:outline"
        >
          {
            years.map((year) => (
              <option
                value={year}
                selected={year === defaultYear}
                class="bg-surface text-secondary [font-size:inherit]"
              >
                {year}
              </option>
            ))
          }
        </select>
        <span class="text-tertiary pointer-events-none absolute top-1/2 right-2 -translate-y-1/2">
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
    </div>

    <!-- Search icon button -->
    <button
      id="events-search-toggle"
      class="bg-surface text-tertiary flex shrink-0 items-center justify-center rounded px-4 py-3"
      aria-label="Search"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M11 11L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile search input (hidden by default, toggled by icon) -->
  <div id="events-search-mobile-wrap" class="mt-2 hidden sm:hidden">
    <input
      id="events-search"
      type="text"
      placeholder="Search for Events"
      class="bg-surface text-secondary placeholder:text-tertiary body3 focus:outline-default w-full rounded px-4 py-3 pr-10 focus:outline"
    />
  </div>

  <!-- Desktop / tablet layout (sm+): original full row -->
  <div class="hidden sm:flex sm:flex-row sm:items-center sm:gap-3 md:max-w-4/5">
    <div class="relative flex-1">
      <input
        id="events-search-desktop"
        type="text"
        placeholder="Search for Events"
        class="bg-surface text-secondary placeholder:text-tertiary body3 focus:outline-default w-full rounded px-4 py-3 pr-10 focus:outline"
      />
      <span class="text-tertiary pointer-events-none absolute top-1/2 right-3 -translate-y-1/2">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M11 11L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>

    <div class="relative">
      <select
        id="events-month"
        class="bg-surface text-secondary body3 focus:outline-default min-w-[140px] cursor-pointer appearance-none rounded px-4 py-3 pr-8 focus:outline"
      >
        {
          months.map((month) => (
            <option
              value={month}
              selected={month === currentMonthName}
              class="bg-surface text-secondary [font-size:inherit]"
            >
              {month}
            </option>
          ))
        }
      </select>
      <span class="text-tertiary pointer-events-none absolute top-1/2 right-3 -translate-y-1/2">
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>

    <div class="relative">
      <select
        id="events-year"
        class="bg-surface text-secondary body3 focus:outline-default min-w-[90px] cursor-pointer appearance-none rounded px-4 py-3 pr-8 focus:outline"
      >
        {
          years.map((year) => (
            <option
              value={year}
              selected={year === defaultYear}
              class="bg-surface text-secondary [font-size:inherit]"
            >
              {year}
            </option>
          ))
        }
      </select>
      <span class="text-tertiary pointer-events-none absolute top-1/2 right-3 -translate-y-1/2">
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</section>

<script>
  // Mobile search toggle
  const searchToggle = document.getElementById("events-search-toggle");
  const searchMobileWrap = document.getElementById("events-search-mobile-wrap");
  const searchMobileInput = document.getElementById("events-search") as HTMLInputElement | null;

  if (searchToggle && searchMobileWrap) {
    searchToggle.addEventListener("click", () => {
      const isHidden = searchMobileWrap.classList.contains("hidden");
      searchMobileWrap.classList.toggle("hidden", !isHidden);
      if (isHidden && searchMobileInput) searchMobileInput.focus();
    });
  }
</script>
