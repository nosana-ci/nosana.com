---
const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];

const defaultYear = 2025;
const years = [2023, 2024, 2025, 2026];
---

<section class="w-full px-4 py-10 md:px-12 md:py-16">
  <div class="mb-10 flex flex-col gap-4 md:mb-12">
    <h1 class="text-primary h2 grotesk">Events & Community</h1>
    <p class="text-secondary body3 max-w-lg">
      Join us at global tech events, meetups, and hackathons shaping the future
      of AI infrastructure
    </p>
  </div>

  <div
    class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center md:max-w-4/5"
  >
    <div class="relative flex-1">
      <input
        id="events-search"
        type="text"
        placeholder="Search for Events"
        class="bg-surface text-secondary placeholder:text-tertiary body3 focus:outline-default w-full rounded px-4 py-3 pr-10 focus:outline"
      />
      <span
        class="text-tertiary pointer-events-none absolute top-1/2 right-3 -translate-y-1/2"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5"
          ></circle>
          <path
            d="M11 11L14 14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </span>
    </div>

    <div class="relative">
      <select
        id="events-month"
        class="bg-surface text-secondary body3 focus:outline-default min-w-[140px] cursor-pointer appearance-none rounded px-4 py-3 pr-8 focus:outline"
      >
        {
          months.map((month) => (
            <option
              value={month}
              selected={month === "December"}
              class="bg-surface text-secondary"
            >
              {month}
            </option>
          ))
        }
      </select>
      <span
        class="text-tertiary pointer-events-none absolute top-1/2 right-3 -translate-y-1/2"
      >
        <svg
          width="10"
          height="6"
          viewBox="0 0 10 6"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M1 1L5 5L9 1"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>

    <div class="relative">
      <select
        id="events-year"
        class="bg-surface text-secondary body3 focus:outline-default min-w-[90px] cursor-pointer appearance-none rounded px-4 py-3 pr-8 focus:outline"
      >
        {
          years.map((year) => (
            <option
              value={year}
              selected={year === defaultYear}
              class="bg-surface text-secondary"
            >
              {year}
            </option>
          ))
        }
      </select>
      <span
        class="text-tertiary pointer-events-none absolute top-1/2 right-3 -translate-y-1/2"
      >
        <svg
          width="10"
          height="6"
          viewBox="0 0 10 6"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M1 1L5 5L9 1"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</section>
