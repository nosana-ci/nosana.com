---
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import TestimonialsSlider from "../testimonials/testimonialSlider.astro";

const entry = await getEntry("gpuProviders", "index");

if (!entry) {
  throw new Error("GPU Providers content not found");
}

const { testimonialsSection } = entry.data;

const badge = testimonialsSection.badge;
const heading = testimonialsSection.heading;
---

<section class="w-full px-4 md:px-12">
  <Badge title={badge.title} class="mb-4" />

  <h2 class="text-primary h4 grotesk max-w-3xl mb-8 md:mb-16 lg:mb-18">
    {heading}
  </h2>

  <TestimonialsSlider />
</section>
