---
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import TestimonialsSlider from "../testimonials/testimonialSlider.astro";

type Props = {
  testimonialsSection: CollectionEntry<"gpuProviders">["data"]["testimonialsSection"];
};

const { testimonialsSection } = Astro.props;

const { badge, heading } = testimonialsSection;
---

<section class="w-full px-4 lg:px-12">
  <Badge title={badge.title} class="mb-4" />

  <h2 class="text-primary h4 grotesk max-w-3xl mb-8 md:mb-16 lg:mb-18">
    {heading}
  </h2>

  <TestimonialsSlider />
</section>
