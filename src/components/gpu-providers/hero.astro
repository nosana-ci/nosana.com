---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import heroBg from "../../content/homepage/assets/heroBg.webp";
import heroVideo from "../../content/homepage/assets/heroBg.mp4";
import gpuRaw from "../../content/gpu-providers/assets/gpu.svg?raw";
import texture from "../../content/homepage/assets/texture.webp";

import Button from "../ui/button.astro";
import Badge from "../ui/badge.astro";

type Props = {
  heroSection: CollectionEntry<"gpuProviders">["data"]["heroSection"];
};

const { heroSection } = Astro.props;

const { badge, heading, description, cta1, cta2 } = heroSection;

const gpuSvg = gpuRaw.replace('<svg ', '<svg preserveAspectRatio="xMaxYMax slice" ');
---

<section
  class="relative h-[calc(100vh-5rem)] w-full overflow-hidden px-4 pt-10 lg:pt-20 lg:h-[110vh] lg:px-12 2xl:h-[calc(100vh-5rem)]"
>
  <video
    autoplay
    loop
    muted
    playsinline
    poster={heroBg.src}
    class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none select-none"
  >
    <source src={heroVideo} type="video/mp4" />
  </video>

  <div
    class="relative z-10 bg-bg-base h-full rounded-t-xl overflow-hidden p-6 md:p-12 lg:p-20"
  >
    <div class="absolute inset-0 pointer-events-none mix-blend-hard-light z-0">
      <Image
        src={texture}
        alt="texture"
        class="w-full h-full object-cover pointer-events-none select-none"
      />
    </div>

    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute right-0 bottom-0 lg:right-20 w-full h-full">
        <div
          class="w-full h-full pointer-events-none select-none [&>svg]:w-full [&>svg]:h-full [&>svg]:object-cover [&>svg]:object-bottom-right"
          set:html={gpuSvg}
        />
      </div>
      <div
        class="absolute inset-0 pointer-events-none z-1 opacity-5
              [background-image:linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)]
              [background-size:72px_72px]"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-3xl">
      {badge && <Badge title={badge.title} icon={badge.icon} class="mb-4" />}

      <h1 class="text-primary mb-4 grotesk h4">{heading}</h1>
      <p class="text-secondary md:max-w-xl leading-relaxed mb-6 lg:mb-10 body2">
        {description}
      </p>

      <div class="flex flex-wrap gap-4">
        {
          cta1 && (
            <Button
              title={cta1.title}
              url={cta1.url}
              variant="secondary"
              data-cta="earn_gpu"
            />
          )
        }

        {
          cta2 && (
            <Button
              title={cta2.title}
              url={cta2.url}
              icon={cta2.icon}
              variant="secondary"
              data-cta="schedule_call"
            />
          )
        }
      </div>
    </div>
  </div>
</section>
