---
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import Button from "../ui/button.astro";
import NavigateButton from "../ui/navigateButton.astro";

import step1Raw from "../../content/gpu-providers/assets/steps/step1.svg?raw";
import step2Raw from "../../content/gpu-providers/assets/steps/step2.svg?raw";
import step3Raw from "../../content/gpu-providers/assets/steps/step3.svg?raw";
import step4Raw from "../../content/gpu-providers/assets/steps/step4.svg?raw";

const stepSvgs = [step1Raw, step2Raw, step3Raw, step4Raw];

type Props = {
  getStarted: CollectionEntry<"gpuProviders">["data"]["getStarted"];
};

const { getStarted } = Astro.props;

const { badge, heading, description, cta1, cta2, steps } = getStarted;
---

<section class="bg-bg-base w-full px-4 md:px-12" id="get-started-section">
  <div>
    <Badge title={badge.title} />
    <h2 class="text-primary h4 grotesk mt-4 mb-3 max-w-3xl">
      {heading}
    </h2>
    <p class="text-secondary body2 mb-6 md:max-w-xl">
      {description}
    </p>

    <div class="mb-10 flex gap-3">
      {cta1 && <Button title={cta1.title} url={cta1.url} variant="secondary" />}
      {cta2 && <Button title={cta2.title} url={cta2.url} variant="secondary" />}
    </div>
  </div>

  <div
    class="bg-surface/30 border-default/30 relative h-full w-full overflow-hidden"
  >
    {
      steps.map((_step: any, index: number) => (
        <div
          class:list={[
            "step-image",
            index === 0 ? "active" : "",
            index === 1 ? "max-md:scale-110 max-md:overflow-hidden" : "",
          ]}
        >
          <div
            class="step-svg-wrapper"
            set:html={stepSvgs[index]}
          />
        </div>
      ))
    }
  </div>

  <div>
    <div class="w-full">
      <div class="h-px w-full"></div>
      <div class="steps-grid w-full">
        {
          steps.map((step: any, index: number) => (
            <div class="relative">
              <button
                class:list={[
                  "step-tab group relative w-full pt-4 pr-4 pb-2 text-left transition-colors",
                  index === 0 ? "is-active" : "",
                ]}
                data-step-tab={index}
              >
                <div
                  class:list={[
                    "my-4 h-0.5 transition-opacity duration-300",
                    index === 0 ? "bg-primary" : "bg-elevated",
                  ]}
                  data-step-indicator={index}
                />
                <span
                  class:list={[
                    "md:body2 text-md transition-colors",
                    index === 0 ? "text-brand-100" : "text-secondary",
                  ]}
                  data-step-label={index}
                >
                  Step {String(index + 1).padStart(2, "0")}
                </span>
              </button>
              <div
                class:list={[
                  "step-content mt-4 transition-opacity duration-400",
                  index === 0 ? "visible opacity-100" : "invisible opacity-0",
                ]}
                data-step-content={index}
              >
                <h3 class="text-primary h4 grotesk mb-2 max-w-xs">
                  {step.title}
                </h3>
                <p class="text-secondary body2 mb-6 max-w-sm">
                  {step.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div style="height: 0px;"></div>
  </div>

  <div class="mt-6 flex items-center justify-between">
    <div class="h-0.5 w-40 overflow-hidden rounded bg-white/20">
      <div
        class="slider-progress h-full bg-white transition-all duration-500"
        style="width: 0%"
      >
      </div>
    </div>

    <div class="flex gap-2">
      <NavigateButton
        direction="left"
        variant="secondary"
        data-action="prev2"
      />
      <NavigateButton
        direction="right"
        variant="secondary"
        data-action="next2"
      />
    </div>
  </div>
</section>

<style>
  .step-image {
    display: none;
    width: 100%;
  }

  .step-image.active {
    display: block;
  }

  .step-svg-wrapper :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .step-svg-wrapper :global(.step-glow) {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .step-image:hover .step-svg-wrapper :global(.step-glow) {
    opacity: 1;
  }
  .step-content {
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .step-content.invisible {
    opacity: 0;
    transform: translateY(8px);
  }

  .step-content.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
  }

  @media (max-width: 899px) and (min-width: 640px) {
    .steps-grid {
      display: flex;
      flex-direction: row;
    }

    .steps-grid > div {
      flex: 1;
      overflow: hidden;
    }

    .steps-grid > div:has(.step-tab.is-active) {
      flex: 4;
    }

    .steps-grid > div:not(:has(.step-tab.is-active)) .step-content {
      display: none;
    }

    .steps-grid > div:not(:has(.step-tab.is-active)) [data-step-label] {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .steps-grid {
      display: block;
    }

    .steps-grid .step-tab:not(.is-active) {
      display: none;
    }

    .steps-grid .step-tab.is-active [data-step-indicator] {
      display: none;
    }

    .steps-grid {
      min-height: 200px;
      position: relative;
    }

    .steps-grid > div {
      position: absolute;
      width: 100%;
      top: 0;
      left: 0;
    }

    .step-content.invisible {
      display: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById("get-started-section");
    if (!section) return;

    const images = Array.from(
      section.querySelectorAll(".step-image"),
    ) as HTMLElement[];
    const tabs = Array.from(
      section.querySelectorAll("[data-step-tab]"),
    ) as HTMLButtonElement[];
    const contents = Array.from(
      section.querySelectorAll("[data-step-content]"),
    ) as HTMLElement[];
    const indicators = Array.from(
      section.querySelectorAll("[data-step-indicator]"),
    ) as HTMLElement[];
    const labels = Array.from(
      section.querySelectorAll("[data-step-label]"),
    ) as HTMLElement[];
    const progressEl = section.querySelector(".slider-progress") as HTMLElement;
    const prevBtn = section.querySelector(
      '[data-action="prev2"]',
    ) as HTMLButtonElement;
    const nextBtn = section.querySelector(
      '[data-action="next2"]',
    ) as HTMLButtonElement;

    const totalSteps = tabs.length;
    let currentStep = 0;

    function goToStep(index: number) {
      if (index < 0 || index >= totalSteps) return;
      currentStep = index;

      images.forEach((img, i) => {
        img.classList.toggle("active", i === currentStep);
      });

      indicators.forEach((ind, i) => {
        ind.classList.toggle("bg-primary", i === currentStep);
        ind.classList.toggle("bg-elevated", i !== currentStep);
      });

      labels.forEach((label, i) => {
        label.classList.toggle("text-brand-100", i === currentStep);
        label.classList.toggle("text-secondary", i !== currentStep);
      });

      tabs.forEach((tab, i) => {
        tab.classList.toggle("is-active", i === currentStep);
      });

      contents.forEach((content, i) => {
        if (i === currentStep) {
          content.classList.remove("opacity-0", "invisible");
          content.classList.add("opacity-100", "visible");
        } else {
          content.classList.remove("opacity-100", "visible");
          content.classList.add("opacity-0", "invisible");
        }
      });

      if (progressEl) {
        const maxIndex = totalSteps - 1;
        const progress = maxIndex <= 0 ? 100 : (currentStep / maxIndex) * 100;
        progressEl.style.width = `${progress}%`;
      }

      if (prevBtn) prevBtn.disabled = currentStep === 0;
      if (nextBtn) nextBtn.disabled = currentStep === totalSteps - 1;
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => goToStep(i));
    });

    prevBtn?.addEventListener("click", () => goToStep(currentStep - 1));
    nextBtn?.addEventListener("click", () => goToStep(currentStep + 1));
    goToStep(0);
  })();
</script>
