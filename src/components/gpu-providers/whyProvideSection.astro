---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/badge.astro";

type Props = {
  whyProvideSection: CollectionEntry<"gpuProviders">["data"]["whyProvideSection"];
};

const { whyProvideSection } = Astro.props;

const { badge, heading, description, features } = whyProvideSection;

const headingParts = heading.split(" - ");
---

<section class="w-full bg-bg-base px-4 lg:px-12">
  <!-- Badge -->
  <Badge title={badge.title} class="mb-4" />


  <!-- Heading -->
  <h2 class="text-primary h4 grotesk max-w-3xl mb-4">
    {headingParts[0]}
    <span class="text-brand-100">{headingParts[1]}</span>
    {headingParts[2]}
    <span class="text-brand-100">{headingParts[3]}</span>
  </h2>

  <!-- Description -->
  <p class="text-secondary max-w-2xl mb-8 md:mb-16 lg:mb-18 body2">
    {description}
  </p>

  <!-- Features Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3">
      {features.map((feature: any) => (
        <div class={`sm:border-l ${feature.title !== "Real-Time Metrics" ? "border-b" : ""} sm:border-b-0 border-white/20  sm:p-8 py-6 min-h-[280px] md:min-h-[360px] lg:min-h-[440px]`}>
          <!-- Icon -->
          <div class="mb-6">
            <Image
              src={feature.icon}
              alt={feature.title}
              width={100}
              height={100}
              class="invert opacity-70 w-[100px] h-[100px] md:w-[120px] md:h-[120px] pointer-events-none select-none"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Title -->
          <h3 class="text-primary body1 mb-2">
            {feature.title}
          </h3>

          <!-- Description -->
          <p class="text-secondary body3">
            {feature.description}
          </p>
        </div>
      ))}
  </div>
</section>