---
import type { CollectionEntry } from "astro:content";
import nosanaLogoGray from "../../assets/logos/nosanaLogoGray.svg?raw";

type Props = {
  earningSection: CollectionEntry<"gpuProviders">["data"]["earningSection"];
};

const { earningSection } = Astro.props;

const { heading, description } = earningSection;

const headingParts = heading.split(" - ");
---

<section class="bg-bg-base w-full px-4 md:px-12">
  <!-- Heading -->
  <h2 class="text-primary h4 grotesk mb-4 max-w-3xl">
    {headingParts[0]}
    {headingParts[1] && <span class="text-brand-100">{headingParts[1]}</span>}
  </h2>

  <!-- Description -->
  <p class="text-secondary body2 mb-12 max-w-xl lg:mb-20">
    {description}
  </p>

  <!-- Interactive Zone -->
  <div
    class="mx-auto flex max-w-7xl flex-col items-stretch gap-10 lg:flex-row lg:gap-0"
  >
    <!-- Left Column - Form -->
    <div class="flex-1 space-y-8 lg:pr-12 xl:pr-16">
      <!-- GPU Selection -->
      <div>
        <h3 class="text-primary body2 mb-3">What GPU type you have?</h3>
        <div class="bg-surface relative rounded-lg" id="gpuDropdown">
          <button
            type="button"
            id="gpuDropdownBtn"
            class="text-primary body2 md:caption1 hover:border-default relative w-full cursor-pointer appearance-none px-4 py-3 pr-10 text-left transition-colors outline-none focus:outline-none"
          >
            <span id="gpuSelectedText">Loading...</span>
            <div
              class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 transition-transform duration-200"
              id="dropdownArrow"
            >
              <svg
                class="text-secondary h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </button>

          <div id="gpuSeparator" class="border-default mx-4 hidden border-b">
          </div>

          <ul
            id="gpuOptions"
            data-lenis-prevent
            class="bg-surface absolute left-0 z-50 mt-0 hidden max-h-64 w-full overflow-y-auto overscroll-contain rounded-b-lg py-1"
          >
            <li
              class="gpu-option body2 md:caption1 text-secondary hover:bg-bg-base cursor-pointer px-4 py-3 transition-colors"
            >
              Loading GPUs...
            </li>
          </ul>
        </div>
      </div>

      <!-- Hours Slider -->
      <div>
        <h3 class="text-primary body2 mb-3">
          How many available hours do <br /> you have per month?
        </h3>
        <p class="text-secondary body4 mb-6 italic">
          These are the hours when your GPU is not in use. Use the slider to
          indicate the total idle hours you can contribute.
        </p>

        <!-- Slider Container -->
        <div class="relative pt-1 pb-12">
          <div class="bg-surface relative h-2 w-full rounded-lg">
            <div
              id="progressFill"
              class="bg-brand-100/30 pointer-events-none absolute top-0 left-0 h-2 rounded-lg"
              style="width: 22.6%"
            >
            </div>
          </div>
          <input
            type="range"
            id="hoursSlider"
            min="0"
            max="744"
            value="168"
            class="earnings-slider absolute top-0 left-0 z-10 h-3 w-full cursor-pointer appearance-none bg-transparent"
          />
          <div
            id="hoursTooltip"
            class="pointer-events-none absolute z-20 -translate-x-1/2"
            style="left: 22.6%; top: 25px;"
          >
            <div
              class="bg-brand-100 relative rounded-md px-2.5 py-1 text-xs font-medium whitespace-nowrap text-black"
            >
              <div
                class="border-b-brand-100 absolute -top-1 left-1/2 h-0 w-0 -translate-x-1/2 border-r-8 border-b-8 border-l-8 border-r-transparent border-l-transparent"
              >
              </div>
              <span id="hoursTooltipValue">7 Days</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Vertical Separator -->
    <div class="border-default/30 hidden self-stretch border-l lg:block"></div>

    <!-- Right Column - Earnings Card -->
    <div class="flex flex-1 items-start lg:pl-12 xl:pl-16">
      <div
        class="bg-surface border-default flex h-full w-full flex-col justify-between rounded-2xl border p-8"
      >
        <!-- Header -->
        <div class="space-y-12">
          <div
            class="text-default/80 flex items-center justify-center gap-4 text-center text-xs font-medium sm:text-sm"
          >
            <p>Estimated price with</p>
            <div class="h-4">
              <Fragment set:html={nosanaLogoGray} />
            </div>
          </div>

          <!-- Price Display -->
          <div
            class="flex flex-row flex-wrap items-baseline justify-center gap-x-6 gap-y-2 pb-12"
          >
            <span class="flex items-baseline gap-3">
              <span
                id="totalEarnings"
                class="text-primary grotesk text-5xl font-medium sm:text-7xl"
                >...</span
              >
              <span
                class="text-primary grotesk text-2xl font-medium sm:text-4xl"
                >NOS</span
              >
            </span>
            <span
              id="monthlyEarnings"
              class="grotesk text-secondary text-xl font-medium whitespace-nowrap sm:text-2xl"
              >.../month</span
            >
          </div>
        </div>

        <!-- Details -->
        <div
          class="border-default flex flex-row items-start justify-between gap-6 border-t pt-8"
        >
          <div class="flex flex-col gap-1">
            <span class="body4 text-tertiary">GPU type:</span>
            <span id="gpuTypeDisplay" class="body2 text-primary">...</span>
          </div>

          <div class="flex flex-col gap-1 text-right">
            <span class="body4 text-tertiary">Duration:</span>
            <span
              id="durationDisplay"
              class="body2 text-primary whitespace-nowrap">...</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .earnings-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #000000;
    border: 2.5px solid var(--color-brand-100);
    cursor: pointer;
    position: relative;
    z-index: 10;
    margin-top: -3px;
  }

  .earnings-slider::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #000000;
    border: 2.5px solid var(--color-brand-100);
    cursor: pointer;
  }

  .earnings-slider::-webkit-slider-runnable-track {
    background: transparent;
    height: 8px;
  }

  .earnings-slider::-moz-range-track {
    background: transparent;
    height: 8px;
  }

  .earnings-slider:focus {
    outline: none;
  }

  .gpu-option[data-selected="true"] {
    background-color: var(--color-elevated);
  }

  #gpuOptions {
    scrollbar-width: thin;
    scrollbar-color: var(--color-surface) var(--color-surface);
  }

  #gpuOptions::-webkit-scrollbar {
    width: 6px;
  }

  #gpuOptions::-webkit-scrollbar-track {
    background: var(--color-surface);
  }

  #gpuOptions::-webkit-scrollbar-thumb {
    background-color: var(--color-surface);
    border-radius: 3px;
  }

  #gpuOptions:hover {
    scrollbar-color: var(--color-elevated) var(--color-surface);
  }

  #gpuOptions:hover::-webkit-scrollbar-thumb {
    background-color: var(--color-elevated);
  }
</style>

<script>
  // State
  let gpuPrices: Record<string, number> = {};
  let selectedGpu = "";
  let nosPrice = 0;
  let isOpen = false;

  // Elements
  const dropdownBtn = document.getElementById("gpuDropdownBtn");
  const dropdownOptions = document.getElementById("gpuOptions");
  const dropdownArrow = document.getElementById("dropdownArrow");
  const gpuSeparator = document.getElementById("gpuSeparator");
  const selectedText = document.getElementById("gpuSelectedText");
  const gpuTypeDisplay = document.getElementById("gpuTypeDisplay");
  const dropdownContainer = document.getElementById("gpuDropdown");
  const totalEarningsEl = document.getElementById("totalEarnings");
  const monthlyEarningsEl = document.getElementById("monthlyEarnings");
  const durationDisplay = document.getElementById("durationDisplay");
  const hoursSlider = document.getElementById(
    "hoursSlider",
  ) as HTMLInputElement;
  const progressFill = document.getElementById("progressFill");
  const hoursTooltip = document.getElementById("hoursTooltip");
  const hoursTooltipValue = document.getElementById("hoursTooltipValue");

  // Earnings calculation
  function updateEarnings() {
    if (!selectedGpu || !gpuPrices[selectedGpu] || !nosPrice) {
      if (totalEarningsEl) totalEarningsEl.textContent = "...";
      if (monthlyEarningsEl) monthlyEarningsEl.textContent = ".../month";
      return;
    }
    const pricePerHour = gpuPrices[selectedGpu];
    const hours = parseInt(hoursSlider?.value || "0");
    const usdEarnings = pricePerHour * hours;
    const nosEarnings = usdEarnings / nosPrice;

    if (totalEarningsEl) totalEarningsEl.textContent = nosEarnings.toFixed(2);
    if (monthlyEarningsEl)
      monthlyEarningsEl.textContent = `$${usdEarnings.toFixed(2)}/month`;
  }

  // Slider UI
  function updateSliderUI() {
    if (!hoursSlider || !progressFill || !hoursTooltip || !hoursTooltipValue)
      return;

    const value = parseInt(hoursSlider.value);
    const max = parseInt(hoursSlider.max);
    const percentage = (value / max) * 100;

    progressFill.style.width = `${percentage}%`;

    const thumbOffset = 9;
    const sliderWidth = hoursSlider.offsetWidth;
    const pixelPos =
      (percentage / 100) * (sliderWidth - thumbOffset * 2) + thumbOffset;
    const correctedPercentage = (pixelPos / sliderWidth) * 100;
    hoursTooltip.style.left = `${correctedPercentage}%`;
    hoursTooltip.style.top = "25px";

    const days = Math.floor(value / 24);
    const remainingHours = value % 24;
    let label = "";
    if (days > 0 && remainingHours > 0) {
      label = `${days} Days ${remainingHours}h`;
    } else if (days > 0) {
      label = `${days} Days`;
    } else {
      label = `${value} hours`;
    }
    hoursTooltipValue.textContent = label;

    // Duration display in card
    let durationText = "";
    if (days > 0 && remainingHours > 0) {
      durationText = `${days} Days ${remainingHours} hours`;
    } else if (days > 0) {
      durationText = `${days} Days`;
    } else {
      durationText = `${value} hours`;
    }
    if (durationDisplay) durationDisplay.textContent = durationText;
  }

  hoursSlider?.addEventListener("input", () => {
    updateSliderUI();
    updateEarnings();
  });

  window.addEventListener("resize", updateSliderUI);

  // Dropdown logic
  function toggleDropdown() {
    isOpen = !isOpen;
    if (isOpen) {
      dropdownOptions?.classList.remove("hidden");
      gpuSeparator?.classList.remove("hidden");
      dropdownArrow?.classList.add("rotate-180");
      dropdownContainer?.classList.remove("rounded-lg");
      dropdownContainer?.classList.add("rounded-t-lg");
    } else {
      dropdownOptions?.classList.add("hidden");
      gpuSeparator?.classList.add("hidden");
      dropdownArrow?.classList.remove("rotate-180");
      dropdownContainer?.classList.remove("rounded-t-lg");
      dropdownContainer?.classList.add("rounded-lg");
    }
  }

  function closeDropdown() {
    isOpen = false;
    dropdownOptions?.classList.add("hidden");
    gpuSeparator?.classList.add("hidden");
    dropdownArrow?.classList.remove("rotate-180");
    dropdownContainer?.classList.remove("rounded-t-lg");
    dropdownContainer?.classList.add("rounded-lg");
  }

  function selectGpu(value: string) {
    selectedGpu = value;
    if (selectedText) selectedText.textContent = value;
    if (gpuTypeDisplay) gpuTypeDisplay.textContent = value;
    document.querySelectorAll(".gpu-option").forEach((opt) => {
      if (opt.getAttribute("data-value") === value) {
        opt.setAttribute("data-selected", "true");
      } else {
        opt.removeAttribute("data-selected");
      }
    });
    updateEarnings();
    closeDropdown();
  }

  function buildDropdown(prices: Record<string, number>) {
    if (!dropdownOptions) return;
    dropdownOptions.innerHTML = "";
    const gpuTypes = Object.keys(prices);
    gpuTypes.forEach((gpu, i) => {
      const li = document.createElement("li");
      li.className =
        "gpu-option body2 md:caption1 text-primary hover:bg-bg-base cursor-pointer px-4 py-3 transition-colors";
      li.setAttribute("data-value", gpu);
      li.textContent = gpu;
      li.addEventListener("click", () => selectGpu(gpu));
      dropdownOptions.appendChild(li);
      if (i === 0) {
        li.setAttribute("data-selected", "true");
        selectedGpu = gpu;
        if (selectedText) selectedText.textContent = gpu;
        if (gpuTypeDisplay) gpuTypeDisplay.textContent = gpu;
      }
    });
    updateSliderUI();
    updateEarnings();
  }

  dropdownBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggleDropdown();
  });

  document.addEventListener("click", (e) => {
    if (dropdownContainer && !dropdownContainer.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDropdown();
  });

  // Fetch markets + NOS price
  async function loadData() {
    try {
      const [marketsRes, statsRes] = await Promise.all([
        fetch("https://dashboard.k8s.prd.nos.ci/api/markets/?type=PREMIUM"),
        fetch("https://dashboard.k8s.prd.nos.ci/api/stats/"),
      ]);

      const [data, stats] = await Promise.all([
        marketsRes.json(),
        statsRes.json(),
      ]);

      if (stats?.price) nosPrice = stats.price;

      const excludeMarkets = [
        "columbia-uni-4090",
        "sogni-4090",
        "alpha-4090",
        "nvidia-8x-a5000",
      ];
      const markets = data.filter(
        (market: any) =>
          !excludeMarkets.includes(market.slug) &&
          market.type === "PREMIUM" &&
          !market.slug.includes("laptop") &&
          !market.client,
      );

      const pricePerGpu: Record<string, number> = {};
      markets.forEach((market: any) => {
        if (market.name && !market.name.toLowerCase().includes("laptop")) {
          pricePerGpu[market.name] = market.usd_reward_per_hour;
        }
      });

      gpuPrices = pricePerGpu;
      buildDropdown(gpuPrices);
    } catch (error) {
      console.error("Failed to load data:", error);
      if (dropdownOptions)
        dropdownOptions.innerHTML =
          '<li class="gpu-option body2 text-secondary px-4 py-3">Failed to load GPUs</li>';
    }
  }

  loadData();
</script>
