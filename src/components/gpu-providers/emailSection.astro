---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import chevronRightDouble from "../../assets/icons/chevronRightDouble.svg?raw";

const entry = await getEntry("gpuProviders", "index");

if (!entry) {
  throw new Error("GPU Providers content not found");
}

const { emailSection } = entry.data;

const heading = emailSection.heading;
const description = emailSection.description;
const image = emailSection.image;
---

<section class="w-full flex flex-col md:flex-row justify-between items-center bg-bg-base px-6 sm:px-8 md:px-14">
  <!-- Badge -->
   <div class="w-full sm:pr-10">
     <!-- Heading -->
     <h2 class="text-primary text-center sm:text-left h4 grotesk max-w-3xl mb-4">
        {heading}
     </h2>
   
     <!-- Description -->
     <p class="text-secondary text-center sm:text-left md:max-w-xl mb-8  body2">
        {description}
     </p>
     <div class="flex gap-2 bg-[#373737] border border-[#555] rounded-lg p-2 w-full sm:max-w-[460px] max-w-full">
        <input 
          type="email" 
          id="newsletter-email"
          placeholder="Enter your email" 
          class="flex-1 bg-transparent border-none text-white placeholder:text-[#d6d6d6] text-sm sm:px-4 px-2 sm:py-3 py-1 outline-none focus:text-white"
        />
        <button class="flex items-center gap-2 bg-[#555] text-[#e7e7e7] rounded-lg sm:px-5 px-3 py-3 text-sm font-medium cursor-pointer transition-all duration-200 hover:bg-[#333] hover:text-white active:scale-[0.98] whitespace-nowrap w-fit">
          Subscribe <span class="sm:block hidden" >to Newsletter</span>
          <Fragment set:html={chevronRightDouble} />
        </button>
      </div>

   </div>
   <div class="sm:h-[500px] w-full">
    <Image 
      src={image} 
      alt="Email section illustration"
      width={100}
      height={100}
      class="w-full h-full object-cover"
    />
   </div>
</section>