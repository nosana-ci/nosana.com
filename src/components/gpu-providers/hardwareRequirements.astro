---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import Button from "../ui/button.astro";


const entry = await getEntry("gpuProviders", "index");

if (!entry) {
  throw new Error("GPU Providers content not found");
}

const { hardwareRequirementsSection } = entry.data;

const badge = hardwareRequirementsSection.badge;
const heading = hardwareRequirementsSection.heading;
const description = hardwareRequirementsSection.description;
const buttons = hardwareRequirementsSection.buttons;
const requirements = hardwareRequirementsSection.requirements;
---

<section class="w-full bg-bg-base px-6 sm:px-8 md:px-14 flex flex-col lg:flex-row justify-between items-start">
  <div class="lg:w-[45%] w-full lg:pr-10">
    <!-- Badge -->
    <Badge title={badge.title} class="mb-4" />


    <!-- Heading -->
    <h2 class="text-primary h4 grotesk max-w-3xl mb-4">
      {heading}
    </h2>

    <!-- Description -->
    <p class="text-secondary md:max-w-xl  body2">
      {description}
    </p>

    <!-- Buttons -->
    <div class="flex flex-wrap gap-3 my-8">
      <Button
        title={buttons.primary.title}
        url={buttons.primary.url}
        variant="secondary"
      />
      <Button
        title={buttons.secondary.title}
        url={buttons.secondary.url}
        variant="secondary"
      />
    </div>
  </div>
    <!-- Requirements Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full flex-1">
      {requirements.map((requirement) => (
        <div class="bg-surface border border-white/10 rounded-xl px-4 md:px-4 py-4 md:py-8 transition-all duration-300">
          <!-- Icon -->
            <Image
              src={requirement.icon}
              alt={requirement.title}
              width={40}
              height={40}
              class="text-brand-100 h-10 w-10 select-none pointer-events-none"
            />

            <div class="h-[2px] w-full bg-linear-to-r from-white/10 to-transparent my-4"></div>

          <!-- Title -->
          <h3 class="body2 text-primary font-semibold mb-2">
            {requirement.title}
          </h3>

          <!-- Description -->
          <p class="text-secondary body4">
            {requirement.description}
          </p>

          <!-- Optional Link -->
          {
            requirement.link && (
              <Button
                title={requirement.link.title}
                url={requirement.link.url}
                variant="ghost"
                class="mt-4 w-fit"
              />
            )
          }
          
        </div>
      ))}
    </div>

</section>

<!-- Responsive Behavior -->
<style>
  /* Mobile: Stack vertically (1 column) - Image 2 */
  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  /* Desktop: 4 columns in a 2x2 grid - Image 1 */
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3 1fr);
    }
    
    /* Make first 3 items span across top row */
    .grid > div:nth-child(1),
    .grid > div:nth-child(2),
    .grid > div:nth-child(3) {
      /* Normal flow */
    }
    
    /* Make 4th item span 2 columns on bottom */
    .grid > div:nth-child(4) {
      grid-column: span 3;
      padding:32px;
    }
  }
</style>