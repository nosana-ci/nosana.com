---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import chevronRightDouble from "../../assets/icons/chevronRightDouble.svg?raw";

const entry = await getEntry("gpuProviders", "index");

if (!entry) {
  throw new Error("GPU Providers content not found");
}

const { emailSection } = entry.data;

const heading = emailSection.heading;
const description = emailSection.description;
const image = emailSection.image;
---

<section
  class="bg-bg-base flex w-full flex-col items-center justify-between px-6 sm:px-8 md:px-14 lg:flex-row gap-10 lg:gap-20 xl:gap-36"
>
  <div class="w-full">
    <!-- Heading -->
    <h2 class="text-primary h4 grotesk mb-4 max-w-3xl text-center lg:text-left">
      {heading}
    </h2>

    <!-- Description -->
    <p class="text-secondary body2 mb-8 text-center lg:max-w-xl lg:text-left">
      {description}
    </p>
    <div
      class="flex w-full max-w-full gap-2 rounded-lg border border-[#555] bg-[#373737] p-2"
    >
      <input
        type="email"
        id="newsletter-email"
        placeholder="Enter your email"
        class="flex-1 border-none bg-transparent px-2 py-1 text-sm text-white outline-none placeholder:text-[#d6d6d6] focus:text-white sm:px-4 sm:py-3"
      />
      <button
        class="flex w-fit cursor-pointer items-center gap-2 rounded-lg bg-[#555] px-2 py-0.5 text-sm font-medium whitespace-nowrap text-[#e7e7e7] transition-all duration-200 hover:bg-[#333] hover:text-white active:scale-[0.98] sm:px-5 sm:py-3"
      >
        Subscribe <span class="hidden sm:block">to Newsletter</span>
        <Fragment set:html={chevronRightDouble} />
      </button>
    </div>
  </div>
  <div class="mt-2 h-full w-full px-2 lg:h-[500px]">
    <Image
      src={image}
      alt="Email section illustration"
      width={100}
      height={100}
      class="h-full w-full object-cover"
    />
  </div>
</section>
