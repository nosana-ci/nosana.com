<section class="px-4 lg:px-12">
    <!-- Section Header -->
    <div class="mb-8 lg:mb-10">
      <Badge title="Build with Nosana" />
      <h2 class="h4 grotesk text-primary mt-4">
        Where the next wave of AI is emerging<br class="md:block hidden" /> and what's
        worth building next<br class="md:block hidden" />
        (not limited to)
      </h2>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16">
      <!-- Categories List -->
      <div class="space-y-0" id="categories-list">
        {
          categories.map((category, index) => (
            <div class="bc-group" data-index={index}>
              <div
                class="bc-category-row flex items-start flex-row justify-between gap-8 py-4 md:px-6 cursor-pointer"
                data-index={index}
              >
                <div class="flex-1">
                  <h3
                    class={`h6 grotesk mb-2 transition-colors bc-title ${index === 0 ? "text-brand-100" : "text-primary"}`}
                    data-index={index}
                  >
                    {category.title}
                  </h3>
                  <div
                    class="bc-description-wrap"
                    data-index={index}
                    style={index === 0 ? "grid-template-rows:1fr;" : "grid-template-rows:0fr;"}
                  >
                    <div class="bc-description-inner overflow-hidden">
                      <p class="body4 text-secondary pt-1 pb-1">
                        {category.description}
                      </p>
                    </div>
                  </div>
                </div>
                <div class="shrink-0 pt-1">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class={`bc-icon transition-colors ${index === 0 ? "text-primary" : "text-secondary"}`}
                    data-index={index}
                  >
                    <line
                      x1="5"
                      y1="12"
                      x2="19"
                      y2="12"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                    <line
                      class="bc-vertical-line"
                      data-index={index}
                      x1="12"
                      y1="5"
                      x2="12"
                      y2="19"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      style={index === 0 ? "opacity:0;" : "opacity:1;"}
                    />
                  </svg>
                </div>
              </div>
              {index < categories.length - 1 && (
                <div class="h-px bg-default mx-6" />
              )}
            </div>
          ))
        }
      </div>

      <!-- Right Image Panel -->
      <div class="hidden lg:block">
        <div
          class="sticky top-32 rounded-lg border border-default overflow-hidden h-[500px]"
        >
          <div
            class="relative h-full flex items-center justify-center"
            style="background: radial-gradient(89.26% 89.26% at 50% 16.74%, rgba(16, 232, 12, 0.41) 0%, rgba(16, 232, 12, 0.06) 100%);"
          >
            {
              categories.map((category, index) => (
                <div
                  class="bc-panel absolute inset-0 p-4 flex items-center justify-center flex-col gap-6"
                  data-index={index}
                  style={
                    index === 0
                      ? "opacity:1; transform:scale(1);"
                      : "opacity:0; transform:scale(0.9); pointer-events:none;"
                  }
                >
                  <div class="w-1/2 rounded-lg flex items-center justify-center">
                    {category.svg ? (
                       <div class="w-full h-auto flex items-center justify-center" set:html={category.svg} />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-secondary">
                        SVG placeholder
                      </div>
                    )}
                  </div>
                  <h3 class="h6 grotesk text-primary">{category.title}</h3>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
</section>

<style>
  /* Grid-row trick: animates the row track, no JS height reads needed */
  .bc-description-wrap {
    display: grid;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bc-description-inner {
    min-height: 0;
  }

  .bc-panel {
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .bc-vertical-line {
    transition: opacity 0.2s ease;
  }

  .bc-icon {
    transition: color 0.2s ease;
  }

  .bc-title {
    transition: color 0.2s ease;
  }

  .bc-category-row:hover .bc-title:not(.text-brand-100) {
    color: var(--color-brand-100, #10e80c);
  }

  .bc-category-row:hover .bc-icon:not(.text-brand-100) {
    color: var(--color-brand-100, #10e80c);
  }
</style>

<script>
  let selectedIndex = 0;

  const rows = document.querySelectorAll<HTMLElement>(".bc-category-row");
  const titles = document.querySelectorAll<HTMLElement>(".bc-title");
  const descriptionWraps =
    document.querySelectorAll<HTMLElement>(".bc-description-wrap");
  const icons = document.querySelectorAll<SVGElement>(".bc-icon");
  const verticalLines =
    document.querySelectorAll<SVGLineElement>(".bc-vertical-line");
  const panels = document.querySelectorAll<HTMLElement>(".bc-panel");

  function activate(index: number) {
    if (index === selectedIndex) return;

    const old = selectedIndex;
    selectedIndex = index;

    // --- Collapse old ---
    titles[old].classList.remove("text-brand-100");
    titles[old].classList.add("text-primary");
    icons[old].classList.remove("text-brand-100");
    icons[old].classList.add("text-secondary");
    verticalLines[old].style.opacity = "1";
    descriptionWraps[old].style.gridTemplateRows = "0fr";

    // Hide old panel
    panels[old].style.opacity = "0";
    panels[old].style.transform = "scale(0.9)";
    panels[old].style.pointerEvents = "none";

    // --- Expand new ---
    titles[index].classList.add("text-brand-100");
    titles[index].classList.remove("text-primary");
    icons[index].classList.add("text-brand-100");
    icons[index].classList.remove("text-secondary");
    verticalLines[index].style.opacity = "0";
    descriptionWraps[index].style.gridTemplateRows = "1fr";

    // Show new panel
    panels[index].style.opacity = "1";
    panels[index].style.transform = "scale(1)";
    panels[index].style.pointerEvents = "auto";
  }

  rows.forEach((row) => {
    row.addEventListener("click", () => {
      const index = parseInt(row.dataset.index ?? "0");
      activate(index);
    });
  });
</script>
