<section id="how-it-works" class="py-8 md:py-12 px-4 lg:px-12">
    <!-- Section Header -->
    <div class="mb-8 md:mb-16 lg:mb-18 gap-4 flex flex-col">
      <Badge title="How it works" class="w-fit"/>
      <h2 class="h4 text-primary grotesk max-w-xl">
        Grants Program Timeline: How to participate
      </h2>
      <p class="body2 text-secondary">
        A quick look at the journey from application to grant decision.
      </p>
    </div>

    <!-- Timeline Grid -->
    <div
      class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-0 lg:border-x lg:border-b border-default"
    >
      {
        timelineSteps.map((step, index) => (
          <div class="relative flex lg:flex-col gap-6 md:gap-16 lg:gap-0  border-default  lg:border-t-0 lg:border-l   first:border-t-0 first:lg:border-l-0 ">
            <div class="flex lg:hidden items-center w-[25%] md:w-40 relative">
              <Fragment set:html={icons[step.mobileIcon]} />
              {index !== timelineSteps?.length - 1 && (
                <div class="absolute hidden md:block w-[2px] top-32 left-1/2 h-[40%] bg-default -translate-x-1/2" />
              )}
            </div>
            <div class="lg:px-3 md:w-[60%] w-[65%] lg:w-full">
              <span class="text-tertiary h6 grotesk">
                {step.number}
              </span>

              <div class="py-2 border-b border-default mb-4">
                <h3 class="body2 text-primary">{step.title}</h3>
              </div>

              <p class="body4 text-secondary flex-1 whitespace-pre-line">
                {step.description}
              </p>
            </div>

            <div class="mt-auto hidden pt-10 lg:flex flex-col items-center">
              <Fragment set:html={icons[step.icon]} />
            </div>
          </div>
        ))
      }
    </div>
</section>