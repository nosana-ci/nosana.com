---

<section class="px-4 md:px-12">

    <!-- Section Header -->
    <div class="mb-8 lg:mb-12 gap-4 flex flex-col">
      <Badge title="Benefits" class="w-fit" />
      <h2 class="h4 grotesk test-primary">Program Benefits</h2>
      <p class="body2 text-secondary max-w-3xl">
        The Nosana Grants Program supports technically strong teams building AI
        applications, infrastructure, or tooling that run on decentralized GPU
        compute.
      </p>
    </div>

    <!-- Benefits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 ">
      <!-- Featured Card -->
      <div
        class="md:col-span-2 lg:col-span-1 lg:row-span-2 rounded-lg border border-default overflow-hidden relative group"
        style="background: linear-gradient(180deg, #010501 0%, #051300 100%);"
      >
        <div
          class="bg-[url('/benefits-card.png')] aspect-16/23 md:aspect-16/10 lg:aspect-auto h-full lg:bg-cover bg-top-right bg-no-repeat lg:bg-top"
        >
          <div class="relative h-full flex flex-col">
            <div class="p-8">
              <h3 class="h5 text-primary grotesk">
                Fueling the Future of <br class="lg:hidden" /> Decentralized AI <br
                  class="lg:hidden"
                /> Compute
              </h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Benefit Cards -->
      {
        benefits.map((benefit) => (
          <div
            style="background: radial-gradient(217.75% 146.88% at 96.48% -2.9%, #1F1F1F 51.8%, rgba(18, 85, 17, 0.42) 100%);"
            class="rounded-lg border border-default p-6 transition-colors"
          >
            <div
              style="background: linear-gradient(180deg, rgba(199, 199, 199, 0.12) 0%, rgba(97, 97, 97, 0.12) 100%);"
              class="w-[90px] h-[90px] rounded-full border border-default flex items-center justify-center md:mb-10 mb-6 text-primary transition-colors"
            >
              <Fragment set:html={icons[benefit.icon]} />
            </div>
            <h3 class="h6 grotesk mb-4 text-brand-100">
              {benefit.title}
            </h3>
            <p class="body2 text-primary">{benefit.description}</p>
          </div>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="flex md:justify-end mt-5 md:mt-12">
      <Button
        title="Apply for Grants"
        url={formUrl}
        class="w-full md:w-auto"
        variant="secondary"
      />
    </div>
</section>