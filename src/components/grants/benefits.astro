---
import { getEntry } from "astro:content";
import Button from "../ui/button.astro";
import Badge from "../ui/badge.astro";

const entry = await getEntry("grants", "index");

if (!entry) {
  throw new Error("Nosana Token content not found");
}

const { formUrl } = entry.data;

const benefits = [
  {
    title: "$5K-$50K",
    description:
      "Milestone-based financial support provided in USDC, NOS, and GPU credits (compute you can use on Nosana).",
    icon: "dollar",
  },
  {
    title: "Full Ownership & IP",
    description: "Non-dilutive support — everything you create stays yours.",
    icon: "cpu",
  },
  {
    title: "Ecosystem Exposure",
    description:
      "Showcase your work across the Nosana ecosystem. Connect with partners, collaborators, and early adopters.",
    icon: "users",
  },
  {
    title: "Community Access",
    description:
      "Access to a network of developers, contributors, and AI builders using decentralized GPU compute.",
    icon: "megaphone",
  },
];

