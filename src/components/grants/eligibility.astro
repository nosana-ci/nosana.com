<section class="flex w-full flex-col gap-8 md:gap-16 lg:gap-18 px-4 md:px-12">
  
  <!-- Header -->
  <div class="flex flex-col gap-4">
    <Badge title="Eligibility" class="w-fit" />
    <h2 class="h4 grotesk text-primary">
      Who Belongs in This Builder Wave
    </h2>
  </div>

  <!-- Eligibility Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 px-4">
    {eligibilityItems.map((item, index) => (
      <div class="flex items-center gap-5 md:flex-col md:items-start md:gap-4 lg:flex-row lg:items-center">
        
        <!-- Icon Box -->
        <div class="relative w-[45px] md:w-[60px] lg:w-[80px] aspect-square shrink-0 rounded-md md:rounded-lg lg:rounded-2xl border border-default overflow-hidden">
          
          <!-- Grid Pattern -->
          <svg class="absolute inset-0 w-full h-full opacity-30" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <pattern id={`grid-${index}`} width="10" height="10" patternUnits="userSpaceOnUse">
                <path d="M 10 0 L 0 0 0 10" fill="none" stroke="#10e80c" stroke-width="0.3"/>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill={`url(#grid-${index})`} />
          </svg>

          <!-- Icon -->
          <div
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center text-primary size-8 md:size-9 lg:size-12"
            set:html={item.icon}
          />
        </div>
        
        <!-- Text -->
        <p class="body1 text-primary max-w-2xs">
          {item.text}
        </p>

      </div>
    ))}
  </div>
</section>
