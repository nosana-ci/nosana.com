---
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import StakingCalculator from "./stakingCalculator.astro";

const entry = await getEntry("nosanaToken", "index");

if (!entry) {
  throw new Error("Nosana Token content not found");
}

const { stakingCalculator } = entry.data;
---

<section class="flex w-full flex-col gap-8 px-4 lg:px-12">
  <div class="flex flex-col gap-4">
    <Badge title={stakingCalculator.badge} class="w-fit" />
    <h2 class="h4 grotesk text-primary">
      {stakingCalculator.title}
    </h2>
    <p class="body2 text-secondary max-w-2xl">
      {stakingCalculator.description}
    </p>
    <a
      href="https://stake.nosana.com/"
      class="body2 text-brand-100 w-fit underline-offset-2 transition-all duration-300 hover:underline"
      >Go to Staking Dashboard
    </a>
  </div>
  <StakingCalculator />
</section>
