---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";

interface StatsResponse {
  date: string;
  usdValueStaked: string;
  nosStaked: string;
  totalXNosStaked: string;
  stakers: number;
  price: number;
  marketCap: number;
  dailyVolume: number;
  totalSupply: number;
  circulatingSupply: number;
  fullyDilutedMarketCap: number;
  dailyPriceChange: number;
}

const entry = await getEntry("nosanaToken", "index");

if (!entry) {
  throw new Error("Nosana Token content not found");
}

const { community } = entry.data;

// --------------------
// Fetch API (SSR)
// --------------------
let stats: StatsResponse | null = null;

try {
  const res = await fetch("https://dashboard.k8s.prd.nos.ci/api/stats");
  const text = await res.text();
  stats = JSON.parse(text) as StatsResponse;
} catch (e) {
  console.error("FETCH FAILED:", e);
}

// --------------------
// Format Helpers
// --------------------
const formatCurrency = (num: number | string): string =>
  "$" + Number(num).toLocaleString();

const formatNumber = (num: number | string): string =>
  Number(num).toLocaleString();

const formatPrice = (num: number): string =>
  "$" + Number(num).toFixed(4);

// --------------------
// Map Values by Index
// --------------------
function resolveValue(index: number): string {
  if (!stats) return "--";

  switch (index) {
    case 0:
      return formatNumber(stats.stakers);
    case 1:
      return formatCurrency(stats.usdValueStaked);
    case 2:
      return formatCurrency(stats.marketCap);
    case 3:
      return formatPrice(stats.price);
    case 4:
      return formatCurrency(stats.dailyVolume);
    case 5:
      return formatNumber(stats.circulatingSupply);
    case 6:
      return formatNumber(stats.totalSupply);
    case 7:
      return formatCurrency(stats.fullyDilutedMarketCap);
    default:
      return "--";
  }
}

const priceChange: number | null =
  stats?.dailyPriceChange ?? null;

const isNegative = priceChange !== null && priceChange < 0;
const isPositive = priceChange !== null && priceChange > 0;
---

<section class="flex w-full flex-col gap-8 md:gap-16 lg:gap-18 px-4 md:px-12">
  <!-- Header -->
  <div class="flex flex-col gap-4">
    <Badge title={community.badge} class="w-fit" />
    <h2 class="h4 grotesk text-primary">
      {community.title}
    </h2>
    <p class="text-red-500 body2">
      DEBUG: {stats ? "STATS LOADED" : "NO STATS"}
    </p>
  </div>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 px-4">
    {community.metrics.map((metric, index) => (
      <div class="flex items-center gap-5 md:flex-col md:items-start md:gap-4 lg:flex-row lg:items-center">
        
        <!-- Icon -->
        <div class="shrink-0">
          <Image
            src={metric.icon}
            alt={metric.label}
            class="w-[45px] md:w-[60px] lg:w-[80px] aspect-square object-contain select-none pointer-events-none"
          />
        </div>

        <!-- Content -->
        <div>
          <div class="body4 text-secondary mb-1">
            {metric.label}
          </div>

          <div class="flex items-end gap-2">
            <div class="h6 text-primary leading-none grotesk">
              {resolveValue(index)}
            </div>

            {index === 3 && priceChange !== null && (
              <div
                class={`flex items-center body4 ${
                  isNegative
                    ? "text-[#BA2323]"
                    : isPositive
                    ? "text-green-500"
                    : ""
                }`}
              >
                {priceChange.toFixed(2)}%
                <svg
                  class={`w-4 h-4 ml-1 ${
                    isPositive ? "rotate-180" : ""
                  }`}
                  viewBox="0 0 20 20"
                  fill="none"
                >
                  <path
                    d="M6.22686 6.22876L13.7693 13.7712M13.7693 13.7712L13.7693 8.11438M13.7693 13.7712L8.11248 13.7712"
                    stroke="currentColor"
                    stroke-width="1.0625"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>