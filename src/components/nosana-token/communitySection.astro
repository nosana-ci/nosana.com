---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";

const entry = await getEntry("nosanaToken", "index");

if (!entry) {
  throw new Error("Nosana Token content not found");
}

const { community } = entry.data;
---

<section class="flex w-full flex-col gap-8 md:gap-16 lg:gap-18 px-4 md:px-12">
  <!-- Header -->
  <div class="flex flex-col gap-4">
    <Badge title={community.badge} class="w-fit" />
    <h2 class="h4 grotesk text-primary">
      {community.title}
    </h2>
  </div>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 px-4">
    {community.metrics.map((metric) => (
      <div class="flex items-center gap-5 md:flex-col md:items-start md:gap-4 lg:flex-row lg:items-center">
        
        <!-- Icon -->
        <div class="shrink-0">
          <Image
            src={metric.icon}
            alt={metric.label}
            class="w-[45px] md:w-[60px] lg:w-[80px] aspect-square object-contain select-none pointer-events-none"
          />
        </div>

        <!-- Content -->
        <div>
          <div class="body4 text-secondary mb-1">
            {metric.label}
          </div>

          <div class="flex items-end gap-2">
            <div class="h6 text-primary leading-none grotesk">
              {metric.value}
            </div>

            {metric.subvalue && (
              <div class="flex items-center text-[#BA2323] body4">
                {metric.subvalue}
                <svg
                  class="w-5 h-5 mr-1"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M6.22686 6.22876L13.7693 13.7712M13.7693 13.7712L13.7693 8.11438M13.7693 13.7712L8.11248 13.7712" stroke="#BA2323" stroke-width="1.0625" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            )}
          </div>
        </div>

      </div>
    ))}
  </div>
</section>