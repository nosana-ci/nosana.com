---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Button from "../ui/button.astro";
import Badge from "../ui/badge.astro";

const entry = await getEntry("nosanaToken", "index");

if (!entry) {
  throw new Error("Nosana Token content not found");
}

const { nosToken } = entry.data;
const { features } = nosToken;

---

<section
  class="mt-8 md:mt-16 lg:mt-18 flex w-full flex-col gap-8 lg:gap-12 overflow-hidden px-4 md:px-12"
>
  <!-- Header -->
  <div class="flex max-w-[800px] flex-col gap-4">
    <Badge title={nosToken.badge} class="w-fit" />
    <h2 class="h4 grotesk text-primary">
      {nosToken.title}
    </h2>
    <p class="body2 text-secondary">
      {nosToken.description}
    </p>
  </div>

  <!-- Features List -->
  <div class="flex flex-col gap-8 md:gap-16 lg:gap-12 md:py-8 lg:py-12">
    {
      features.map((feature, idx) => {
        const isEven = idx % 2 === 0;

        const rowClass =
          "flex flex-col md:flex-row md:items-start w-full max-w-8xl mx-auto gap-8 " +
          (!isEven ? "md:flex-row-reverse" : "");

        const imageAlignClass =
          "w-full md:w-1/2 flex " +
          (isEven ? "md:justify-start" : "md:justify-end");

        const contentAlignClass =
          "w-full md:w-1/2 flex " +
          (isEven ? "md:justify-end" : "md:justify-start");

        return (
          <div class={rowClass}>
            {/* Image Side */}
            <div class={imageAlignClass}>
              <Image
                src={feature.image}
                alt={feature.title}
                class="w-[350px] h-[300px] lg:w-[600px] lg:h-[500px] object-contain"
              />
            </div>

            {/* Content Side */}
            <div class={contentAlignClass}>
              <div class="flex flex-col gap-4 mt-8 max-w-xl">
                <Badge
                  title={feature.tab.text}
                  icon={feature.tab.icon}
                  class="w-fit"
                />

                <h3 class="h4 grotesk text-primary">
                  {feature.title}
                </h3>

                <p class="body3 text-secondary">
                  {feature.description}
                </p>

                {
                  feature.cta && (
                    <div class="pt-4">
                      <Button
                        title={feature.cta.title}
                        url={feature.cta.url}
                        variant="secondary"
                        data-cta="staking"
                      />
                    </div>
                  )
                }
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

</section>