---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import chevronRightDouble from "../../assets/icons/chevronRightDouble.svg?raw";

const entry = await getEntry("nosanaToken", "index");

if (!entry) {
  throw new Error("Nosana Token content not found");
}

const { exchange } = entry.data;
---

<section class="flex w-full flex-col gap-8 px-4 md:px-12">
  <!-- Header -->
  <div class="flex max-w-[800px] flex-col gap-4">
    <Badge title={exchange.badge} class="mb-4 w-max" />
    <h2 class="h4 grotesk text-primary">
      {exchange.heading}
    </h2>
    <p class="body2 text-secondary">
      {exchange.description}
    </p>
  </div>

  <!-- Logos Grid -->
  <div class="grid w-full max-w-5xl grid-cols-2 place-items-center gap-6">
    {
      exchange.images.map((img) => (
        <div class="bg-surface border-default flex w-full flex-col items-center rounded-lg border">
          <div class="flex aspect-16/7 w-full items-center justify-center py-3 opacity-60 grayscale transition-all duration-300 hover:opacity-100 hover:grayscale-0">
            <Image src={img} alt="Exchiange Logo" class="h-6" />
          </div>
          <div class="border-default flex w-full justify-end border-t p-1">
            <Fragment class="h-72 w-2" set:html={chevronRightDouble} />
          </div>
        </div>
      ))
    }
  </div>
</section>
