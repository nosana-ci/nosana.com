---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Button from "../ui/button.astro";
import Badge from "../ui/badge.astro";

const entry = await getEntry("nosanaToken", "index");

if (!entry) {
  throw new Error("Nosana Token content not found");
}

const { heroSection } = entry.data;

const { badge, title, description, cta1, cta2, image_1, image_2 } = heroSection;
---

<section
  class="h-[calc(100vh-5rem)] max-h-[900px] min-h-[785px] w-full overflow-hidden p-4 lg:p-12"
>
  <div
    class="relative h-full w-full overflow-hidden rounded-xl bg-[#191919] p-4 md:p-6 lg:rounded-3xl lg:p-12 lg:pr-0 lg:pb-0"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <Image
        src={image_2}
        alt="Background Pattern"
        class="pointer-events-none h-full w-full object-cover opacity-60 select-none"
      />
    </div>

    <!-- Foreground Hero Image -->
    <Image
      src={image_1}
      alt="Nosana Token Hero"
      class="pointer-events-none absolute right-0 -bottom-20 z-0 h-auto w-full object-contain drop-shadow-2xl select-none max-md:right-20 max-md:bottom-10 max-md:scale-[1.6] xl:w-[90%]"
    />

    <!-- Content -->
    <div
      class="relative z-20 flex max-w-xl flex-col items-start gap-4 text-left"
    >
      <Badge title={badge.text} icon={badge.icon} />

      <h1 class="h4 grotesk text-primary">
        {title}
      </h1>

      <p class="body2 text-secondary max-w-lg">
        {description}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button
          title={cta1.text}
          url={cta1.url}
          variant="secondary"
          data-cta="explore"
        />
        <Button
          title={cta2.text}
          url={cta2.url}
          variant="secondary"
          data-cta="staking"
        />
      </div>
    </div>
  </div>
</section>
