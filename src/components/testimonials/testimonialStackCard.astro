---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import testimonialCardTint from "../../content/homepage/assets/testimonialCardTint.webp";

interface Props {
  name: string;
  username: string;
  logo: ImageMetadata;
  message: string;
  rating: number;
}

const { name, username, logo, message, rating } = Astro.props;
---

<div class="relative w-full max-w-[600px]">
  {/* Shape */}
  <svg
    viewBox="0 0 601 375"
    class="w-full h-auto block"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M414 18C414 27.9411 422.059 36 432 36H576C589.807 36 601 47.1929 601 61V350C601 363.807 589.807 375 576 375H213C200.297 375 190 364.703 190 352C190 339.297 179.703 329 167 329H25C11.1929 329 0 317.807 0 304V25C0 11.1929 11.1929 0 25 0H396C405.941 0 414 8.05888 414 18Z"
      fill="#2A2A2A"
      filter="drop-shadow(2px 4px 10px rgba(0, 0, 0, 0.25))"></path>
  </svg>

  <Image
    src={testimonialCardTint}
    alt={name}
    width={601}
    height={375}
    class="absolute bottom-0 right-0 w-2/3 h-auto object-cover pointer-events-none select-none"
    loading="lazy"
    decoding="async"
  />

  {/* Content */}
  <div class="absolute inset-0 p-4 md:p-6 flex flex-col justify-between">
    {/* Header */}
    <div class="flex items-center gap-6">
      <div class="w-16 h-16 rounded-full overflow-hidden shrink-0 bg-black">
        <Image src={logo} alt={name} class="w-full h-full object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="leading-tight">
        <p class="text-primary font-semibold h6 grotesk">
          {name}
        </p>
        <p class="body3">
          @{username}
        </p>
      </div>
    </div>

    {/* Message */}
    <p class="body3 line-clamp-4 md:line-clamp-6 lg:-mt-12">
      {message}
    </p>

    {/* Rating */}
    <div class="flex items-center gap-2 self-end">
      <span class="body4 -mt-1">
        {rating.toFixed(1)}
      </span>

      <div class="flex gap-1">
        {
          Array.from({ length: 5 }).map((_, i) => (
            <svg
              viewBox="0 0 20 20"
              class:list={[
                "w-5 h-5",
                i < Math.round(rating)
                  ? "fill-current text-primary"
                  : "fill-current text-default/30",
              ]}
              aria-hidden="true"
            >
              <path
                d="M0.34522 6.57083L3.19522 9.18333L2.40355 12.825C2.32439 13.3 2.48272 13.775 2.87855 14.0125C3.03689 14.1708 3.27439 14.25 3.51189 14.25C3.67022 14.25 3.82855 14.25 3.98689 14.1708C3.98689 14.1708 4.06605 14.1708 4.06605 14.0917L7.31189 12.2708L10.5577 14.0917C10.5577 14.0917 10.6369 14.0917 10.6369 14.1708C11.0327 14.3292 11.5077 14.3292 11.8244 14.0917C12.2202 13.8542 12.3786 13.3792 12.2994 12.9042L11.5077 9.2625C11.8244 9.025 12.2994 8.55 12.7744 8.075L14.2786 6.72917L14.3577 6.65C14.6744 6.33333 14.7536 5.85833 14.5952 5.4625C14.4369 5.06667 14.1202 4.75 13.6452 4.67083H13.5661L9.84522 4.275L8.34105 0.870833C8.34105 0.870833 8.34105 0.791667 8.26189 0.791667C8.18272 0.2375 7.78689 0 7.39105 0C6.99522 0 6.59939 0.2375 6.36189 0.633333C6.36189 0.633333 6.36189 0.7125 6.28272 0.7125L4.77855 4.11667L1.05772 4.5125H0.978554C0.582721 4.59167 0.186887 4.90833 0.0285538 5.30417C-0.0506128 5.77917 0.0285537 6.25417 0.34522 6.57083Z"
                fill="#FAFAFA"
              />
            </svg>
          ))
        }
      </div>
    </div>
  </div>
</div>
