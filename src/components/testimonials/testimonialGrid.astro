---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import NavigateButton from "../ui/navigateButton.astro";
import collabBg from "../../assets/testimonialGridTopBg.webp";

interface Props {
  variant?: "default" | "collaboration";
}

const { variant = "default" } = Astro.props;

/* Load ALL SVGs inside testimonials */
const rawSvgs = import.meta.glob(
  "../../content/testimonials/**/*.svg",
  {
    query: "?raw",
    import: "default",
    eager: true,
  }
);

/* Load Nosana logo as raw */
const nosanaRawMap = import.meta.glob(
  "../../public/nosanaWhite.svg",
  {
    query: "?raw",
    import: "default",
    eager: true,
  }
);

const nosanaRaw = Object.values(nosanaRawMap)[0] as string | undefined;

const testimonials = await getCollection("testimonials", ({ data }) => {
  return data.type === "grid";
});

/* Include slug (t.id) so we can resolve nested asset folder */
const testimonialGridData = testimonials.map((t) => ({
  ...t.data,
  _slug: t.id,
})) as Array<{
  type: "grid";
  icon: string;
  iconWhite?: string;
  title: string;
  description: string;
  _slug: string;
}>;

function getRawSvg(path?: unknown, slug?: string) {
  if (typeof path !== "string") return undefined;
  if (!slug) return undefined;

  const cleaned = path.startsWith("./")
    ? path.slice(2)
    : path;

  const fullPath = `../../content/testimonials/${slug}/${cleaned}`;

  return rawSvgs[fullPath];
}
---

<section class="w-full" id="grid-pagination-section">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-default">
    {
      testimonialGridData.map((item, index) => {
        const { icon, iconWhite, title, description, _slug } = item;

        const displayIconRaw =
          variant === "collaboration"
            ? getRawSvg(iconWhite, _slug) ?? getRawSvg(icon, _slug)
            : getRawSvg(icon, _slug);

        return (
          <div class="case-card hidden border border-default p-6" data-index={index}>
            <div class="flex flex-col gap-4 h-full">
              <div class={`flex items-center gap-3 relative ${variant === "collaboration" ? "justify-center h-[78px]" : ""}`}>

                {variant === "collaboration" && (
                  <Image
                    src={collabBg}
                    alt=""
                    quality={100}
                    class="absolute inset-0 w-full h-full object-cover select-none pointer-events-none"
                  />
                )}

                <div class="relative z-10 flex items-center gap-3">

                  {/* Main Icon */}
                  {displayIconRaw && (
                    <div
                      class={`${variant === "collaboration" ? "h-[30px]" : "w-12 h-12"}
                              select-none pointer-events-none
                              [&>svg]:w-full [&>svg]:h-full`}
                      set:html={displayIconRaw}
                    />
                  )}

                  {/* Collaboration Mode */}
                  {variant === "collaboration" && (
                    <>
                      <span class="text-primary body2">x</span>

                      {nosanaRaw && (
                        <div
                          class="h-[30px] select-none pointer-events-none
                                 [&>svg]:w-full [&>svg]:h-full"
                          set:html={nosanaRaw}
                        />
                      )}
                    </>
                  )}
                </div>
              </div>

              <h3 class="text-primary body2 font-semibold">{title}</h3>
              <p class="text-secondary body4">{description}</p>
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="flex items-center justify-center py-8 md:py-16 lg:py-18 gap-4">
    <NavigateButton
      id="grid-case-prev"
      variant="secondary"
      direction="left"
      text="Back"
      class="cursor-pointer"
    />

    <div id="grid-case-pages" class="flex gap-2"></div>

    <NavigateButton
      id="grid-case-next"
      variant="secondary"
      direction="right"
      text="Next"
      class="cursor-pointer"
    />
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("grid-pagination-section");
    if (!container) return;

    const cards = Array.from(container.querySelectorAll(".case-card"));

    const prevBtn = container.querySelector(
      "#grid-case-prev",
    ) as HTMLButtonElement | null;
    const nextBtn = container.querySelector(
      "#grid-case-next",
    ) as HTMLButtonElement | null;
    const pagesContainer = container.querySelector("#grid-case-pages");

    const ITEMS_PER_PAGE = 6;
    const totalPages = Math.ceil(cards.length / ITEMS_PER_PAGE);

    let currentPage = 0;

    function renderPages() {
      if (!pagesContainer) return;
      pagesContainer.innerHTML = "";

      for (let i = 0; i < totalPages; i++) {
        const btn = document.createElement("button");
        btn.textContent = String(i + 1);
        btn.className =
          "w-10 h-10 body4 rounded-[5px] transition cursor-pointer " +
          (i === currentPage
            ? "bg-brand-100 text-bg-base"
            : "bg-white/15 text-secondary hover:bg-brand-100/50 hover:text-primary");

        btn.addEventListener("click", () => {
          currentPage = i;
          update();
        });

        pagesContainer.appendChild(btn);
      }
    }

    function update() {
      const start = currentPage * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;

      cards.forEach((card, index) => {
        if (index < start || index >= end) {
          card.classList.add("hidden");
        } else {
          card.classList.remove("hidden");
        }
      });

      renderPages();

      // Disable state
      if (prevBtn) {
        const disabled = currentPage === 0;
        prevBtn.disabled = disabled;
        prevBtn.classList.toggle("opacity-40", disabled);
        prevBtn.classList.toggle("pointer-events-none", disabled);
      }

      if (nextBtn) {
        const disabled = currentPage === totalPages - 1;
        nextBtn.disabled = disabled;
        nextBtn.classList.toggle("opacity-40", disabled);
        nextBtn.classList.toggle("pointer-events-none", disabled);
      }
    }

    prevBtn?.addEventListener("click", () => {
      if (currentPage > 0) {
        currentPage--;
        update();
      }
    });

    nextBtn?.addEventListener("click", () => {
      if (currentPage < totalPages - 1) {
        currentPage++;
        update();
      }
    });

    update();
  });
</script>
