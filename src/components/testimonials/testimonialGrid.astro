import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import NavigateButton from "../ui/navigateButton.astro";
import collabBg from "../../assets/testimonialGridTopBg.webp";
import nosanaRaw from "/nosanaWhite.svg?raw";

interface Props {
  variant?: "default" | "collaboration";
}

const { variant = "default" } = Astro.props;

/* Load ALL SVGs inside testimonials */
const rawSvgs = import.meta.glob(
  "../../content/testimonials/**/*.svg",
  {
    query: "?raw",
    import: "default",
    eager: true,
  }
);


const testimonials = await getCollection("testimonials", ({ data }) => {
  return data.type === "grid";
});

/* Include slug (t.id) so we can resolve nested asset folder */
const testimonialGridData = testimonials.map((t) => ({
  ...t.data,
  _slug: t.id,
})) as Array<{
  type: "grid";
  icon: unknown;
  title: string;
  description: string;
  _slug: string;
}>;

const ITEMS_PER_PAGE = 6;

function getRawSvg(path?: unknown, slug?: string) {
  if (!path || !slug || typeof path !== "string") return undefined;
  
  const cleaned = path.startsWith("./")
    ? path.slice(2)
    : path;

  const fullPath = `../../content/testimonials/${slug}/${cleaned}`;

  return rawSvgs[fullPath];
}
