---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const entry = await getEntry("testimonialsHomepage", "index");
const { features = [] } = entry?.data || {};
---

<section class="w-full bg-bg-base px-4 md:px-12 pt-8 md:pt-16 lg:pt-18">
  <div class="grid grid-cols-1 md:grid-cols-3">
    {features.map((feature, index) => (
      <div 
        class="border-t md:border-t-0 md:border-l border-elevated md:px-6 py-8 md:py-6 flex flex-col justify-start"
      >
        <!-- Icon -->
        <div class="mb-8 lg:mb-12">
          <Image 
            src={feature.icon} 
            alt={feature.title}
            width={120}
            height={120}
            class="h-[100px] lg::h-[125px] w-auto aspect-square pointer-events-none select-none text-tertiary"
          />
        </div>

        <!-- Title -->
        <h3 class="text-primary body1 max-w-sm">
          {feature.title}
        </h3>
      </div>
    ))}
  </div>
</section>