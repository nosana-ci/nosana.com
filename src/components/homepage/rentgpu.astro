---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import GPUGrid from "../ui/gpuGrid.astro";
import { getGPUMarkets } from "../../utils/gpuMarkets";

import searchIcon from "../../assets/icons/search.svg";
import filterIcon from "../../assets/icons/filter.svg";
import closeIcon from "../../assets/icons/close.svg";
import gpuHero from "../../content/homepage/assets/gpuhalf.webp";
// import gpuCircle from "../../content/homepage/assets/gpuCircle.png";

const entry = await getEntry("homepage", "index");
if (!entry) {
  throw new Error("Homepage content not found");
}

const { rentGPU } = entry.data;
const { premium, community, others } = await getGPUMarkets();
---

<section id="gpu-on-rent" class="bg-bg-base h-fit w-full px-4 lg:px-12">
  <Badge title={rentGPU.badge.title} class="mb-4" />

  <h2 class="text-primary h4 grotesk mb-4 max-w-xl">
    {rentGPU.heading}
  </h2>

  <p class="text-secondary body2 leading-relaxed md:max-w-2xl">
    {rentGPU.description}
  </p>

  <!-- Search -->
  <div class="flex w-full items-center gap-4 py-8 lg:py-10">
    <div class="flex h-14 w-full items-center rounded-xl bg-white/5 px-4">
      <Image
        src={searchIcon}
        alt="Search"
        width={24}
        height={24}
        class="mr-4 opacity-60"
        loading="lazy"
        decoding="async"
      />
      <input
        id="gpu-search-input"
        type="text"
        placeholder="Search here"
        class="body2 text-primary w-full bg-transparent outline-none placeholder:text-white/60"
      />
    </div>

    <button
      type="button"
      id="gpu-filter-btn"
      data-filter-icon={filterIcon.src}
      data-close-icon={closeIcon.src}
      class="flex h-14 w-14 items-center justify-center rounded-full border border-white/10 transition hover:bg-white/10 cursor-pointer"
      aria-label="Filter"
    >
      <Image
        id="gpu-filter-icon"
        src={filterIcon}
        alt="Filter"
        width={20}
        height={20}
        class="opacity-60"
      />
    </button>
  </div>

  <!-- EXPANDABLE FILTER PANEL -->
  <div
    id="gpu-filter-panel"
    class="hidden w-full mb-8 lg:mb-10"
  >
    <div class="w-full max-w-6xl mx-auto bg-surface rounded-xl p-6">

      <!-- container flex changes on larger screens -->
      <div class="flex flex-col gap-8 md:flex-row md:gap-8">

        <!-- PRICE RANGE SECTION -->
        <div class="md:w-1/2">
          <div class="flex justify-between items-center mb-4">
            <h4 class="text-secondary body3">
              Price Range ($/h)
            </h4>
            <!-- <span id="price-range-display" class="text-brand-100 text-xs grotesk"></span> -->
          </div>

          <!-- Price inputs -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <div class="text-tertiary text-xs mb-2">Min Price</div>
              <div class="flex items-center gap-2">
                <span class="text-primary font-semibold">$</span>
                <input
                  type="number"
                  id="filter-price-min-input"
                  min="0"
                  step="0.001"
                  value="0.000"
                  class="flex-1 px-3 py-2 bg-white/10 border border-white/20 rounded text-primary text-base outline-none focus:border-brand-100 transition"
                />
              </div>
            </div>
            
            <div>
              <div class="text-tertiary text-xs mb-2">Max Price</div>
              <div class="flex items-center gap-2">
                <span class="text-primary font-semibold">$</span>
                <input
                  type="number"
                  id="filter-price-max-input"
                  min="0"
                  step="0.001"
                  value="1.000"
                  class="flex-1 px-3 py-2 bg-white/10 border border-white/20 rounded text-primary text-base outline-none focus:border-brand-100 transition"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- GPU SERIES SECTION -->
        <div class="md:w-1/2">
          <h4 class="text-secondary body3 mb-4">
            GPU Series
          </h4>

          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {["30", "40", "50", "Enterprise"].map((series) => (
              <label class="flex items-center gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  class="gpu-series-checkbox accent-brand-100"
                  value={series}
                />
                <span class="text-primary body4">
                  {series === "Enterprise" ? "Enterprise" : `${series} Series`}
                </span>
              </label>
            ))}
          </div>
        </div>

      </div>

      <!-- ACTIONS -->
      <div class="flex justify-end gap-4 mt-8">
        <button
          id="filter-reset"
          title="Reset filters"
          class="w-fit px-4 py-2 lg:px-6 lg:py-3 bg-white/10 hover:bg-white/20 border border-default text-primary rounded-sm font-semibold transition-all cursor-pointer"
        >
          Reset
        </button>

        <button
          id="filter-apply"
          title="Apply filters"
          class="w-fit px-4 py-2 lg:px-6 lg:py-3 bg-primary text-black! hover:bg-primary/90 rounded-sm font-semibold transition-all cursor-pointer"
        >
          Apply
        </button>
      </div>

    </div>
  </div>

  <div class="w-full">
    <!-- GPU image -->
    <div class="relative w-full overflow-hidden">
      <Image
        src={gpuHero}
        alt="GPU"
        quality={85}
        class="pointer-events-none h-auto w-full select-none"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Premium GPUs -->
    <div class="panel premium">
      <GPUGrid items={premium} />
      <div class="no-results text-secondary hidden py-10 text-center">
        No GPUs found matching your search.
      </div>
      <div class="show-more-wrap flex w-full justify-center">
        <button
          type="button"
          class="show-more-btn text-primary body2 bg-transparent w-full cursor-pointer py-4 transition border-b border-default hover:bg-surface"
        >
          Show More
        </button>
      </div>
    </div>
  </div>

  <template id="gpu-row-template">
    <div class="gpu-row px-4 md:px-6 py-6 body2 md:grid md:grid-cols-3">
      <div class="gpu-name text-primary font-medium mb-2 md:mb-0 truncate min-w-0"></div>
      <div class="gpu-mobile-info flex justify-between gap-4 md:hidden">
        <div class="text-primary truncate min-w-0">
          <span class="text-secondary">Price: </span>
          <span class="gpu-price-mobile"></span>
        </div>
        <div class="text-primary text-right shrink-0">
          <span class="text-secondary">Availability: </span>
          <span class="availability-value gpu-availability-mobile"></span>
        </div>
      </div>
      <div class="gpu-price-desktop hidden md:block md:text-center text-primary"></div>
      <div class="hidden md:block md:text-right text-primary">
        <span class="availability-value gpu-availability-desktop"></span>
      </div>
    </div>
  </template>

</section>

<!-- <style>
  .slow-spin {
    animation: slow-spin 20s linear infinite;
  }

  @keyframes slow-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style> -->

<script>
  import { getGPUMarkets } from "../../utils/gpuMarkets";

  function createGPURow(item: {
    address: string;
    gpu: string;
    priceDisplay: string;
    priceValue: number | null;
    series: string | null;
    availability: string;
  }) {
    const template = document.getElementById("gpu-row-template") as HTMLTemplateElement | null;
    const row = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;

    if (!row) return null;

    row.dataset.marketAddress = item.address;
    row.dataset.gpuName = item.gpu.toLowerCase();
    row.dataset.gpuPrice = item.priceDisplay.toLowerCase();
    row.dataset.priceValue = item.priceValue == null ? "" : String(item.priceValue);
    row.dataset.series = item.series ?? "";

    const name = row.querySelector(".gpu-name");
    const mobilePrice = row.querySelector(".gpu-price-mobile");
    const desktopPrice = row.querySelector(".gpu-price-desktop");
    const mobileAvailability = row.querySelector(".gpu-availability-mobile");
    const desktopAvailability = row.querySelector(".gpu-availability-desktop");

    if (name) name.textContent = item.gpu;
    if (mobilePrice) mobilePrice.textContent = item.priceDisplay;
    if (desktopPrice) desktopPrice.textContent = item.priceDisplay;
    if (mobileAvailability) mobileAvailability.textContent = item.availability;
    if (desktopAvailability) desktopAvailability.textContent = item.availability;

    return row;
  }

  async function refreshRenderedGPUMarkets() {
    try {
      const { premium } = await getGPUMarkets();
      const premiumPanel = document.querySelector(".panel.premium");
      const rowsContainer = premiumPanel?.querySelector("[data-gpu-rows]");

      if (!(rowsContainer instanceof HTMLElement)) return null;

      const rows = premium
        .map((item) => createGPURow(item))
        .filter((row): row is HTMLElement => row instanceof HTMLElement);

      rowsContainer.replaceChildren(...rows);

      const noResults = premiumPanel?.querySelector(".no-results");
      if (noResults instanceof HTMLElement) {
        noResults.classList.add("hidden");
      }

      const showMoreWrap = premiumPanel?.querySelector(".show-more-wrap");
      if (showMoreWrap instanceof HTMLElement) {
        showMoreWrap.classList.remove("hidden");
      }

      return premium;
    } catch (error) {
      console.error("Error refreshing rendered GPU markets:", error);
      return null;
    }
  }

  function initSearch() {
    const searchInput = document.getElementById(
      "gpu-search-input",
    ) as HTMLInputElement;
    if (!searchInput) return;

    searchInput.addEventListener("input", (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      const panels = document.querySelectorAll(".panel");

      panels.forEach((panel) => {
        const rows = panel.querySelectorAll(".gpu-row");
        const noResults = panel.querySelector(".no-results");
        let hasVisibleRows = false;

        rows.forEach((row) => {
          const name = (row as HTMLElement).dataset.gpuName || "";
          const price = (row as HTMLElement).dataset.gpuPrice || "";

          if (name.includes(query) || price.includes(query)) {
            (row as HTMLElement).classList.remove("hidden");
            (row as HTMLElement).classList.add("md:grid"); // Restore grid layout
            hasVisibleRows = true;
          } else {
            (row as HTMLElement).classList.add("hidden");
            (row as HTMLElement).classList.remove("md:grid");
          }
        });

        if (noResults) {
          if (hasVisibleRows || query === "") {
            noResults.classList.add("hidden");
          } else {
            noResults.classList.remove("hidden");
          }
        }
        
        // Update show more button visibility
        updateShowMoreButton(panel as HTMLElement);
      });
    });
  }

  const MAX_VISIBLE = 10;
  const INCREMENT = 5;

  // Function to update show more button visibility
  function updateShowMoreButton(panel: HTMLElement) {
    const wrap = panel.querySelector(".show-more-wrap") as HTMLElement;
    const matchedRows = panel.querySelectorAll(".gpu-row.matched");
    const visibleMatches = panel.querySelectorAll(".gpu-row.matched:not(.hidden)");

    if (!wrap) return;

    // hide when all matched rows are already visible
    if (visibleMatches.length >= matchedRows.length) {
      wrap.classList.add("hidden");
    } else {
      wrap.classList.remove("hidden");
    }
  }

  function initShowMore() {
    const panels = document.querySelectorAll(".panel");
    panels.forEach((panel) => {
      const rows = Array.from(panel.querySelectorAll(".gpu-row")) as HTMLElement[];
      const wrap = panel.querySelector(".show-more-wrap") as HTMLElement;
      const btn = panel.querySelector(".show-more-btn") as HTMLButtonElement;
      if (!wrap || !btn) return;

      // mark all rows as matched initially
      rows.forEach(r => r.classList.add("matched"));

      let visibleCount = MAX_VISIBLE;

      // Initial state: Hide rows beyond visibleCount among matched
      const updateRows = () => {
        const matchedRows = Array.from(panel.querySelectorAll(".gpu-row.matched")) as HTMLElement[];

        matchedRows.forEach((row, i) => {
          if (i < visibleCount) {
            row.classList.remove("hidden");
            row.classList.add("md:grid");
          } else {
            row.classList.add("hidden");
            row.classList.remove("md:grid");
          }
        });

        // Update show more button visibility
        updateShowMoreButton(panel as HTMLElement);
      };

      updateRows();

      btn.addEventListener("click", () => {
        visibleCount += INCREMENT;
        updateRows();
      });
    });
  }

  await refreshRenderedGPUMarkets();

  // Initialize on page load and after swaps (Astro view transitions)
  initSearch();
  initShowMore();
  document.addEventListener("astro:after-swap", async () => {
    await refreshRenderedGPUMarkets();
    initSearch();
    initShowMore();
  });

  function initFilterPanel() {
    const btn = document.querySelector<HTMLButtonElement>("#gpu-filter-btn");
    const panel = document.querySelector<HTMLDivElement>("#gpu-filter-panel");
    const icon = document.querySelector<HTMLImageElement>("#gpu-filter-icon");

    if (!btn || !panel || !icon || btn.dataset.initialized === "true") return;
    btn.dataset.initialized = "true";

    const filterIconUrl = btn.dataset.filterIcon;
    const closeIconUrl = btn.dataset.closeIcon;

    if (!filterIconUrl || !closeIconUrl) return;

    let isOpen = false;

    const open = () => {
      panel.classList.remove("hidden");
      // force reflow to ensure transition
      // eslint-disable-next-line @typescript-eslint/no-unused-expressions
      panel.offsetWidth;
      panel.classList.add("open");
      icon.src = closeIconUrl;
      icon.classList.add("panel-open");
      isOpen = true;
    };

    const close = () => {
      // immediately hide without animation
      panel.classList.remove("open");
      panel.classList.add("hidden");
      icon.src = filterIconUrl;
      icon.classList.remove("panel-open");
      isOpen = false;
    };

    const toggle = () => {
      isOpen ? close() : open();
    };

    btn.addEventListener("click", toggle);

    // Expose close function for other initializers if needed
    (btn as any)._closePanel = close;
  }

  function initFilterFunctionality() {
    const minInput = document.querySelector<HTMLInputElement>("#filter-price-min-input");
    const maxInput = document.querySelector<HTMLInputElement>("#filter-price-max-input");
    const applyBtn = document.querySelector<HTMLButtonElement>("#filter-apply");
    const resetBtn = document.querySelector<HTMLButtonElement>("#filter-reset");
    const seriesCheckboxes = document.querySelectorAll<HTMLInputElement>(".gpu-series-checkbox");
    if (!minInput || !maxInput || !applyBtn || !resetBtn) return;

    // Determine actual price bounds from data-price-value attributes on GPU rows
    const allRows = Array.from(document.querySelectorAll<HTMLElement>(".gpu-row"));
    const priceValues = allRows
      .map(r => r.dataset.priceValue)
      .filter(Boolean)
      .map(v => parseFloat(v as string))
      .filter(n => !Number.isNaN(n));

    const RANGE_MIN = 0; // Always 0
    const RANGE_MAX = priceValues.length ? Math.max(...priceValues) : 1; // use list max

    // Configure sliders/inputs to use real bounds
    // initialize inputs bounds
    minInput.min = String(RANGE_MIN);
    minInput.max = String(RANGE_MAX);
    maxInput.min = String(RANGE_MIN);
    maxInput.max = String(RANGE_MAX);
    minInput.value = RANGE_MIN.toFixed(3);
    maxInput.value = RANGE_MAX.toFixed(3);

    // helper no slider updates needed
    const updateAllDisplays = () => {
      const minValue = parseFloat(minInput.value);
      const maxValue = parseFloat(maxInput.value);
      // const displayEl = document.querySelector("#price-range-display");
      // if (displayEl) {
      //   displayEl.textContent = `$${minValue.toFixed(3)} - $${maxValue.toFixed(3)}`;
      // }
    };

    // Handle input changes
    const handleMinInput = () => {
      let minValue = parseFloat(minInput.value);
      const maxValue = parseFloat(maxInput.value);

      minValue = Math.max(RANGE_MIN, Math.min(RANGE_MAX, minValue));
      if (minValue > maxValue) {
        minValue = maxValue;
        minInput.value = minValue.toFixed(3);
      }
      updateAllDisplays();
    };

    const handleMaxInput = () => {
      const minValue = parseFloat(minInput.value);
      let maxValue = parseFloat(maxInput.value);

      maxValue = Math.max(RANGE_MIN, Math.min(RANGE_MAX, maxValue));
      if (maxValue < minValue) {
        maxValue = minValue;
        maxInput.value = maxValue.toFixed(3);
      }
      updateAllDisplays();
    };

    // Add event listeners
    minInput.addEventListener("input", handleMinInput);
    maxInput.addEventListener("input", handleMaxInput);

    // Initialize displays
    updateAllDisplays();

    // Apply filters
    const applyFilters = () => {
      const minPrice = parseFloat(minInput.value);
      const maxPrice = parseFloat(maxInput.value);
      const selectedSeries: string[] = [];

      seriesCheckboxes.forEach(checkbox => {
        if (checkbox.checked) {
          selectedSeries.push(checkbox.value);
        }
      });

      const panels = document.querySelectorAll(".panel");

      panels.forEach(panel => {
        const rows = panel.querySelectorAll(".gpu-row");
        const noResults = panel.querySelector(".no-results");
        let hasVisibleRows = false;

        let matchCount = 0;
        rows.forEach(row => {
          const name = (row as HTMLElement).dataset.gpuName || "";

          // Prefer numeric data-price-value if available
          const priceValAttr = (row as HTMLElement).dataset.priceValue;
          let price = priceValAttr ? parseFloat(priceValAttr) : NaN;

          // Fallback to parsing display string (legacy)
          if (Number.isNaN(price)) {
            const priceStr = (row as HTMLElement).dataset.gpuPrice || "";
            
            // Treat N/A as 0
            if (priceStr.toUpperCase().includes("N/A")) {
              price = 0;
            } else {
              const priceMatch = priceStr.match(/\$([\d.]+)/);
              price = priceMatch ? parseFloat(priceMatch[1]) : Infinity;
            }
          }

          // Determine series from GPU name by extracting leading numeric group
          const seriesMatch = name.match(/(\d{2,4})/);
          const detectedSeries = seriesMatch ? String(seriesMatch[0]).slice(0,2) : "";

          // Check if GPU matches selected series
          // Enterprise means any series not 30, 40, or 50
          let matchesSeries = selectedSeries.length === 0;
          if (!matchesSeries) {
            const hasEnterprise = selectedSeries.includes("Enterprise");
            const seriesOnly = selectedSeries.filter(s => s !== "Enterprise");
            const isKnownSeries = ["30", "40", "50"].includes(detectedSeries);

            if (hasEnterprise && !isKnownSeries) {
              matchesSeries = true;
            } else if (seriesOnly.includes(detectedSeries)) {
              matchesSeries = true;
            }
          }

          // Check if price is within range (with small tolerance for floating point)
          const tolerance = 0.0001;
          const matchesPrice = price >= minPrice - tolerance && price <= maxPrice + tolerance;

          const isMatch = matchesSeries && matchesPrice;
          row.classList.toggle("matched", isMatch);

          if (isMatch) {
            matchCount += 1;
            (row as HTMLElement).classList.remove("hidden");
            (row as HTMLElement).classList.add("md:grid");
            hasVisibleRows = true;
          } else {
            (row as HTMLElement).classList.add("hidden");
            (row as HTMLElement).classList.remove("md:grid");
          }
        });

        if (noResults) {
          if (hasVisibleRows) {
            noResults.classList.add("hidden");
          } else {
            noResults.classList.remove("hidden");
          }
        }

        // after filtering we only want the first MAX_VISIBLE matched rows visible
        const matchedRows = Array.from(panel.querySelectorAll(".gpu-row.matched")) as HTMLElement[];
        matchedRows.forEach((row, i) => {
          if (i >= MAX_VISIBLE) {
            row.classList.add("hidden");
            row.classList.remove("md:grid");
          }
        });

        // Update show more button visibility
        updateShowMoreButton(panel as HTMLElement);
      });
    };

    // Reset filters
    const resetFilters = () => {
      // Restore to full detected range
      minInput.value = RANGE_MIN.toFixed(3);
      maxInput.value = RANGE_MAX.toFixed(3);
      updateAllDisplays();

      seriesCheckboxes.forEach(checkbox => {
        checkbox.checked = false;
      });

      // Show all GPUs
      const panels = document.querySelectorAll(".panel");
      panels.forEach(panel => {
        const rows = panel.querySelectorAll(".gpu-row");
        const noResults = panel.querySelector(".no-results");

        rows.forEach((row, i) => {
          (row as HTMLElement).classList.remove("hidden");
          (row as HTMLElement).classList.add("md:grid");
          row.classList.add("matched");
          if (i >= MAX_VISIBLE) {
            (row as HTMLElement).classList.add("hidden");
            (row as HTMLElement).classList.remove("md:grid");
          }
        });

        if (noResults) {
          noResults.classList.add("hidden");
        }
      });
      document.querySelectorAll('.panel').forEach(p => updateShowMoreButton(p as HTMLElement));
    };

    applyBtn.addEventListener("click", () => {
      applyFilters();
      // Optional: close panel on apply for better UX
      const filterBtn = document.querySelector<HTMLButtonElement>("#gpu-filter-btn");
      if (filterBtn && (filterBtn as any)._closePanel) {
        (filterBtn as any)._closePanel();
      }
    });

    resetBtn.addEventListener("click", () => {
      resetFilters();
      // Optional: close panel on reset for better UX
      const filterBtn = document.querySelector<HTMLButtonElement>("#gpu-filter-btn");
      if (filterBtn && (filterBtn as any)._closePanel) {
        (filterBtn as any)._closePanel();
      }
    });
  }

  initFilterPanel();
  initFilterFunctionality();
  document.addEventListener("astro:after-swap", () => {
    initFilterPanel();
    initFilterFunctionality();
  });

</script>

<style>
  .panel {
    display: block;
  }



/* Close icon styling */
#gpu-filter-icon.panel-open {
  width: 16px !important;
  height: 16px !important;
  opacity: 0.8 !important;
}
/* filter panel slide/fade animation */
#gpu-filter-panel {
  opacity: 0;
  transform: translateY(-10px);
}

#gpu-filter-panel.open {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.3s ease, transform 0.3s ease;
}</style>
