---
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import PathCard from "../ui/pathCard.astro";

const entry = await getEntry("homepage", "index");
if (!entry) {
  throw new Error("Homepage content not found");
}
const { pathSection } = entry.data;
---

<section id="path" class="w-full min-h-screen bg-bg-base px-4 md:px-12">
  <Badge title={pathSection.badge.title} class="mb-4" />
  <h2
    class="text-primary h4 grotesk max-w-2xl md:max-w-3xl mb-8 md:mb-16 lg:mb-18"
  >
    {pathSection.heading}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <PathCard
      image={pathSection.path1.image}
      title={pathSection.path1.title}
      description={pathSection.path1.description}
      caption={pathSection.path1.caption}
      url={pathSection.path1.url}
    />
    <PathCard
      image={pathSection.path2.image}
      title={pathSection.path2.title}
      description={pathSection.path2.description}
      caption={pathSection.path2.caption}
      url={pathSection.path2.url}
    />
  </div>
</section>
