---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

import heroBg from "../../content/homepage/assets/heroBg.webp";
import heroVideo from "../../content/homepage/assets/heroBg.mp4";
import gpuRaw from "../../content/homepage/assets/gpu.svg?raw";
import texture from "../../content/homepage/assets/texture.webp";

import Button from "../ui/button.astro";
import Badge from "../ui/badge.astro";

const entry = await getEntry("homepage", "index");

if (!entry) {
  throw new Error("Homepage content not found");
}

const { heroSection } = entry.data;

const badge = heroSection.badge;
const heading = heroSection.heading;
const description = heroSection.description;
const cta1 = heroSection.cta1;
const cta2 = heroSection.cta2;

const gpuSvg = gpuRaw.replace(
  "<svg ",
  '<svg preserveAspectRatio="xMaxYMax slice" ',
);
---

<section
  class="relative h-[calc(100vh-5rem)] w-full overflow-hidden px-4 pt-10 lg:pt-20 lg:h-[110vh] lg:px-12 2xl:h-[calc(100vh-5rem)]"
>
  <video
    autoplay
    loop
    muted
    playsinline
    poster={heroBg.src}
    class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover select-none"
  >
    <source src={heroVideo} type="video/mp4" />
  </video>

  <div
    class="bg-bg-base relative z-10 h-full overflow-hidden rounded-t-xl p-6 lg:p-20"
  >
    <div class="pointer-events-none absolute inset-0 z-0 mix-blend-hard-light">
      <Image
        src={texture}
        alt="texture"
        class="pointer-events-none h-full w-full object-cover select-none"
      />
    </div>

    <div class="pointer-events-none absolute inset-0 z-0">
      <div
        class="absolute right-0 bottom-0 h-full w-full md:right-[25%] md:bottom-[20%] lg:bottom-0 lg:right-20 lg:w-full"
      >
        <div
          class="pointer-events-none h-full w-full select-none [&>svg]:h-full [&>svg]:w-full scale-100 md:scale-140 lg:scale-100"
          set:html={gpuSvg}
        />
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-1 [background-image:linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] [background-size:72px_72px] opacity-5"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-3xl">
      {badge && <Badge title={badge.title} icon={badge.icon} class="mb-4" />}

      <h1 class="text-primary grotesk h4 mb-4">{heading}</h1>
      <p class="text-secondary body2 mb-6 leading-relaxed md:max-w-xl lg:mb-10">
        {description}
      </p>

      <div class="flex flex-wrap gap-4">
        {
          cta1 && (
            <Button
              title={cta1.title}
              url={cta1.url}
              icon={cta1.icon}
              variant="colored"
            />
          )
        }

        {
          cta2 && (
            <Button
              title={cta2.title}
              url={cta2.url}
              icon={cta2.icon}
              variant="secondary"
            />
          )
        }
      </div>
    </div>
  </div>
</section>
