---
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import TestimonialGrid from "../testimonials/testimonialGrid.astro";

const entry = await getEntry("homepage", "index");
if (!entry) {
  throw new Error("Homepage content not found");
}
const { production } = entry.data;
---

<section class="bg-bg-base min-h-screen w-full px-4 md:px-12">
  <Badge
    title={production.badge.title}
    icon={production.badge.icon}
    class="mb-4"
  />

  <h2 class="text-primary h4 grotesk mb-4 max-w-3xl">
    {production.heading}
  </h2>

  <p class="text-secondary body2 mb-10 leading-relaxed md:max-w-xl">
    {production.description}
  </p>

  <TestimonialGrid />
</section>
