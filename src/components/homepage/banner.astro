---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import Button from "../ui/button.astro";

const entry = await getEntry("homepage", "index");
if (!entry) {
  throw new Error("Homepage content not found");
}

const { banner } = entry.data as {
  banner: {
    heading: string;
    description: string;
    cta?: {
      title: string;
      url: string;
      icon?: ImageMetadata;
    };
    image: ImageMetadata;
  };
};
---

<section class="w-full px-4 lg:px-12 flex flex-col md:flex-row h-112.5 md:h-75 lg:h-87.5 mt-8 lg:mt-10">
  <div class="flex-6 bg-surface rounded-3xl p-4 md:p-8 flex flex-col justify-center gap-4">
    <h4 class="text-primary grotesk h4 max-w-sm">
      {banner.heading}
    </h4>

    <p class="body2 text-secondary max-w-md mb-4">
      {banner.description}
    </p>

    {banner.cta && (
      <Button
        title={banner.cta.title}
        url={banner.cta.url}
        icon={banner.cta.icon}
        class="w-fit"
        data-cta="free_credits"
      />
    )}
  </div>

  <div class="block md:hidden h-px w-[calc(100%-48px)] mx-auto bg-default"></div>
  <div class="hidden md:block w-px h-[calc(100%-48px)] my-auto bg-default"></div>

  <div class="flex-4 bg-surface rounded-3xl overflow-hidden flex">
    <Image
      src={banner.image}
      alt={banner.heading}
      class="w-full h-full object-contain object-bottom pointer-events-none select-none"
      loading="eager"
    />
  </div>
</section>
