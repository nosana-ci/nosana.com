---
import { getEntry, getCollection } from "astro:content";
import TestimonialCard from "../ui/testimonialCard.astro";
import NavigateButton from "../ui/navigateButton.astro";

const homepageEntry = await getEntry("homepage", "index");
if (!homepageEntry) {
  throw new Error("Homepage content not found");
}

const testimonialsCollection = await getCollection(
  "testimonials",
  ({ data }) => {
    return data.type === "card";
  },
);

const { testimonials } = homepageEntry.data;
const cardsData = testimonialsCollection.map((t) => t.data).slice(0, 5);
---

<section
  class="w-full flex flex-col items-center justify-center bg-bg-base px-4 md:px-12"
>
  <h2 class="text-primary h1 grotesk text-center mb-4">
    {testimonials.heading}
  </h2>

  <p
    class="text-secondary body2 text-center mb-20 md:mb-50"
    set:html={testimonials.description.join("<br />")}
  />

  <div class="relative w-[600px] max-w-full">
    <div class="relative h-[220px] md:h-[380px]">
      {
        cardsData.map((t, i) => {
          const { name, username, logo, message, rating } = t;
          if (!name || !username || !logo || !message || rating === undefined) {
            return null;
          }

          return (
            <div
              data-testimonial
              class="absolute inset-0 transition-all duration-300 ease-out"
              style={`
              z-index: ${cardsData.length - i};
              transform: translate(0px, ${-i * 40}px) scale(${1 - i * 0.08});
            `}
            >
              <TestimonialCard
                name={name}
                username={username}
                logo={logo}
                message={message}
                rating={rating}
              />
            </div>
          );
        })
      }
    </div>

    <div
      class="hidden md:flex absolute right-[-56px] top-1/2 -translate-y-1/2 flex-col gap-2"
    >
      <div data-nav="prev">
        <NavigateButton direction="up" variant="secondary" />
      </div>
      <div data-nav="next">
        <NavigateButton direction="down" variant="secondary" />
      </div>
    </div>
  </div>

  <div class="md:hidden w-full flex justify-end mt-6">
    <div class="flex gap-3">
      <div data-nav="prev">
        <NavigateButton direction="left" variant="secondary" />
      </div>
      <div data-nav="next">
        <NavigateButton direction="right" variant="secondary" />
      </div>
    </div>
  </div>

  <script>
    let index = 0;

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-testimonial]"),
    );

    const prevBtn = document.querySelectorAll<HTMLElement>('[data-nav="prev"]');
    const nextBtn = document.querySelectorAll<HTMLElement>('[data-nav="next"]');

    function getStackOffset() {
      return window.matchMedia("(min-width: 768px)").matches ? 40 : 30;
    }

    function update() {
      const total = cards.length;

      cards.forEach((card, i) => {
        const pos = (i - index + total) % total;

        card.style.zIndex = String(total - pos);
        card.style.transform = `translate(0px, ${-pos * getStackOffset()}px) scale(${1 - pos * 0.08})`;
        card.style.pointerEvents = pos === 0 ? "auto" : "none";
      });
    }

    prevBtn.forEach((btn) => {
      btn.addEventListener("click", () => {
        index = (index - 1 + cards.length) % cards.length;
        update();
      });
    });

    nextBtn.forEach((btn) => {
      btn.addEventListener("click", () => {
        index = (index + 1) % cards.length;
        update();
      });
    });

    window.addEventListener("resize", update);
    update();
  </script>
</section>
