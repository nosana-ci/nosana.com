---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import whynosanaBg from "../../content/homepage/assets/whynosanaBg.png";
import Features from "../ui/features.astro";

const entry = await getEntry("homepage", "index");
if (!entry) {
  throw new Error("Homepage content not found");
}

const { whyNosanaSection } = entry.data;
---

<section class="w-full h-screen max-h-[1240px] bg-bg-base px-4 md:px-12">
  <div class="relative w-full h-full rounded-xl overflow-hidden">
    <Image
      src={whynosanaBg}
      alt=""
      class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
    />
    <div class="absolute inset-0 flex flex-col justify-between p-4 md:p-8">
      <div>
        <Badge title={whyNosanaSection.badge.title} class="mb-4" />

        <h2 class="text-primary h4 grotesk max-w-3xl mb-4">
          {whyNosanaSection.heading}
        </h2>

        <p class="text-secondary md:max-w-xl leading-relaxed body2">
          {whyNosanaSection.description}
        </p>
      </div>
      <div>
        <Features />
      </div>
    </div>
  </div>
</section>
