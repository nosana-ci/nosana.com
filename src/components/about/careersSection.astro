---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import Button from "../ui/button.astro";

const entry = await getEntry("about", "index");

if (!entry) {
  throw new Error("About content not found");
}

const { careersSection } = entry.data;
const { badge, title, description, button, remoteSection } = careersSection;
---

<section class="relative w-full overflow-hidden">
  <div class="grid items-start gap-8 md:gap-16 lg:gap-18 px-4 lg:px-12 lg:grid-cols-[1fr_1.4fr]">
    <!-- Left Column: Careers Text -->
    <div class="flex flex-col items-start gap-4">
      <Badge title={badge.title} />
      <h2 class="h4 grotesk">
        {title}
      </h2>
      <p class="body2 text-secondary">
        {description}
      </p>

      {
        button && (
          <Button
            title={button.text}
            url={button.url}
            class="mt-4 w-fit"
            variant="secondary"
            iconColor="#fafafa"
            data-cta="careers"
          />
        )
      }
    </div>

    <!-- Right Column: Remote Section Card -->
    <!-- Design: Dark card, Green Text for work from anywhere, Map image -->
    <div
      class="border-default/10 relative flex w-full flex-col gap-6 overflow-hidden rounded-md border bg-[#1A1A1A] p-8 md:p-12"
    >
      <div class="relative z-10 flex flex-col gap-4">
        <!-- Badge Style adjustment for this specific card -->
        <p
          class="body1 grotesk bg-linear-to-r from-brand-100 to-[#078205BA] text-center bg-clip-text text-transparent"
        >
          [{remoteSection.badge.title}]
        </p>

        <p class="body4 text-center text-secondary max-w-lg mx-auto leading-relaxed">
          {remoteSection.description}
        </p>
      </div>

      <div class="relative mt-8 flex w-full justify-center">
        <Image
          src={remoteSection.image}
          alt="Remote Work Distribution"
          class="h-auto w-full object-contain select-none pointer-events-none"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
