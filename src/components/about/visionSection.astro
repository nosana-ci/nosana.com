---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";

const entry = await getEntry("about", "index");

if (!entry) {
  throw new Error("About content not found");
}

const { visionSection } = entry.data;
const { badge, title, description, image } = visionSection;
---

<section class="w-full relative overflow-hidden">
  <div class="px-4 lg:px-12 flex flex-col gap-8 md:gap-16 lg:gap-18">
    <div class="flex flex-col items-start gap-4">
      <Badge title={badge.title} />
      <h2 class="h4 text-primary grotesk">
        {title}
      </h2>
      <p class="body2 text-secondary max-w-2xl">
        {description}
      </p>
    </div>
    <Image
      src={image}
      alt={title}
      class="w-full h-auto object-contain pointer-events-none select-none"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
