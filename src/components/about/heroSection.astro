---
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("about", "index");

if (!entry) {
  throw new Error("About content not found");
}

const { heroSection } = entry.data;

const badge = heroSection.badge;
const heading = heroSection.heading;
const heroImage = heroSection.heroImage;
---

<section class="flex flex-col items-center pt-16 md:pt-24 lg:pt-32 px-4 md:px-12 w-full xl:h-[900px] lg:h-[800px] md:h-[600px] h-[550px] relative overflow-hidden">
    <div class="flex flex-col items-center text-center gap-4 md:gap-6 max-w-[888px] px-4 z-10">
      <p class="body1 bg-gradient-to-r from-green-500 to-green-700 bg-clip-text text-transparent ">
        [{badge.title}]
      </p>
      <h1 class="h4 grotesk">
        {heading}
      </h1>
    </div>
  
    <div class="w-full max-w-full mt-10 md:mt-16 mx-auto absolute md:bottom-0 bottom-10 left-0 right-0 z-0  max-md:scale-[1.2]">
      <Image 
        src={heroImage} 
        alt="Nosana Network" 
        class="w-full h-auto object-contain"
      />
      
      <!-- Gradient fade at bottom to blend with next section -->
      <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-bg-base via-bg-base/50 to-transparent pointer-events-none"></div>
    </div>
</section>
