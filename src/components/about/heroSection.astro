---
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("about", "index");

if (!entry) {
  throw new Error("About content not found");
}

const { heroSection } = entry.data;

const badge = heroSection.badge;
const heading = heroSection.heading;
const heroImage = heroSection.heroImage;
---

<section
  class="relative flex h-[60vh] max-h-[900px] min-h-[500px] lg:min-h-[785px] w-full items-end overflow-hidden lg:h-[110vh] 2xl:h-[calc(100vh-5rem)]"
>
  <div
    class="absolute inset-x-0 top-16 z-10 mx-auto flex max-w-4xl flex-col items-center gap-4 px-4 text-center md:top-24 md:gap-6 lg:top-32"
  >
    <p
      class="body1 grotesk from-brand-100 bg-linear-to-r to-[#078205BA] bg-clip-text text-transparent"
    >
      [{badge.title}]
    </p>
    <h1 class="h4 grotesk">
      {heading}
    </h1>
  </div>

  <div class="relative z-0 flex w-full items-end justify-center">
    <Image
      src={heroImage}
      alt="Nosana Network"
      class="pointer-events-none mx-auto block h-auto w-full scale-200 object-contain select-none lg:scale-100"
      loading="eager"
      decoding="async"
    />
  </div>
</section>
