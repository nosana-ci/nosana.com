---
import { Image } from "astro:assets";
import Badge from "../ui/badge.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("about", "index");

if (!entry) {
  throw new Error("About content not found");
}

const { heroSection } = entry.data;

const badge = heroSection.badge;
const heading = heroSection.heading;
const heroImage = heroSection.heroImage;
---

<section class="relative w-full h-[60vh] max-h-[900px] lg:h-[110vh] 2xl:h-[calc(100vh-5rem)] flex items-end overflow-hidden">
    <div class="absolute top-16 md:top-24 lg:top-32 inset-x-0 flex flex-col items-center text-center gap-4 md:gap-6 max-w-4xl mx-auto px-4 z-10">
      <p class="body1 grotesk bg-linear-to-r from-brand-100 to-[#078205BA] bg-clip-text text-transparent ">
        [{badge.title}]
      </p>
      <h1 class="h4 grotesk">
        {heading}
      </h1>
    </div>
  
    <div class="relative w-full flex justify-center items-end z-0">
      <Image 
        src={heroImage} 
        alt="Nosana Network" 
        class="w-full h-auto block object-contain pointer-events-none scale-200 lg:scale-100 mx-auto select-none"
      />
    </div>
</section>
