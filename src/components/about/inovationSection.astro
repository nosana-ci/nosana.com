---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
const entry = await getEntry("about", "index");

if (!entry) {
  throw new Error("About content not found");
}

const { innovationSection } = entry.data;

const heading = innovationSection.heading
const description = innovationSection.description
const image = innovationSection.image;
---

<section class="grid grid-cols-1 grid-rows-1 w-full max-w-7xl mx-auto overflow-hidden">
  <div class="col-start-1 row-start-1 z-0 flex items-center justify-center">
    <Image 
      src={image} 
      alt="Globe Network" 
      class="w-full h-auto min-h-full object-cover select-none pointer-events-none" 
    />
  </div>

  <div class="col-start-1 row-start-1 z-10 flex flex-col items-center justify-center text-center gap-6 py-10 md:py-20 px-4 lg:px-12">
    <h2 class="h24 text-primary grotesk max-w-5xl">
      {heading}
    </h2>
    <p class="body2 text-primary max-w-4xl">
      {description}
    </p>
  </div>
</section>
