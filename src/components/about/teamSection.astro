---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import Button from "../ui/button.astro";

const entry = await getEntry("about", "index");

if (!entry) {
  throw new Error("About content not found");
}

const { teamSection } = entry.data;
const { badge, title, members } = teamSection;
---

<section id="team" class="relative w-full overflow-hidden bg-bg-base scroll-mt-8 md:scroll-mt-16 lg:scroll-mt-18">
  <div class="flex flex-col gap-8 px-4 md:gap-16 md:px-12 lg:gap-18">
    <!-- Header -->
    <div class="flex flex-col items-start gap-4">
      <Badge title={badge.title} />
      <h2 class="h4 text-primary">
        {title}
      </h2>
    </div>

    <!-- Cards Grid -->
    <div class="grid w-full gap-y-16 md:grid-cols-2 md:gap-x-12 lg:gap-x-24">
      {
        members.map((member) => (
          <div class="group flex flex-col items-start gap-5">
            <div class="aspect-7/9 w-full shrink-0 overflow-hidden grayscale transition-all duration-500 md:w-[85%] lg:w-[60%] group-hover:grayscale-0">
              <Image
                src={member.image}
                alt={member.name}
                class="h-full w-full object-cover"
              />
            </div>
            <div class="flex items-baseline gap-4">
              <h3 class="h6 text-primary">{member.name}</h3>
              <p class="body2 text-secondary">{member.role}</p>
            </div>

            <p class="body2 text-secondary max-w-xl grow">
              {member.bio}
            </p>

            <div class="mt-auto flex flex-col gap-3 pt-4">
              {member.button_1 && (
                <Button
                  title={member.button_1.text}
                  url={member.button_1.url}
                  target="_blank"
                  class="w-fit"
                  variant="secondary"
                  iconColor="#fafafa"
                  data-cta="team_social"
                />
              )}
              {member.button_2 && (
                <Button
                  title={member.button_2.text}
                  url={member.button_2.url}
                  target="_blank"
                  class="w-fit"
                  variant="secondary"
                  iconColor="#fafafa"
                  data-cta="team_social"
                />
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
