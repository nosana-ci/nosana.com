---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";

const entry = await getEntry("about", "index");

if (!entry) {
  throw new Error("About content not found");
}

const { teamSection } = entry.data;
const { badge, title, members } = teamSection;
---

<section class="w-full py-16 md:py-24 relative overflow-hidden bg-[#141414]"> 
  <!-- Assuming dark/bg-base background -->
  
  <div class="max-w-[1400px] mx-auto px-4 flex flex-col gap-12 md:gap-16">
    <!-- Header -->
    <div class="flex flex-col items-start gap-4">
      <Badge title={badge.title} />
      <h2 class="h4 md:text-5xl font-medium text-primary tracking-tight">
        {title}
      </h2>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 gap-6 w-full">
      {members.map((member) => (
        <div class="bg-[#1A1A1A] rounded-2xl p-6 md:p-8 flex flex-col gap-6 group border border-default/10 hover:border-default/30 transition-colors">
          <!-- Member Info Top -->
          <div class="flex flex-row items-center gap-6">
             <div class="w-24 h-24 md:w-32 md:h-32 shrink-0 rounded-xl overflow-hidden grayscale group-hover:grayscale-0 transition-all duration-500">
                <Image 
                  src={member.image} 
                  alt={member.name} 
                  class="w-full h-full object-cover"
                />
             </div>
             <div class="flex flex-col gap-1">
                <h3 class="text-2xl md:text-3xl font-medium text-primary">{member.name}</h3>
                <p class="text-brand-100 font-medium">{member.role}</p>
             </div>
          </div>
          
          <p class="body2 text-secondary leading-relaxed grow">
            {member.bio}
          </p>

          <div class="pt-4 mt-auto">
            {member.button_1 && (
              <a href="#" class="inline-flex items-center gap-2 text-sm text-secondary hover:text-brand-100 transition-colors border border-default/30 px-4 py-2 rounded-lg hover:border-brand-100/50">
                {member.button_1.text}
                <Image src={member.button_1.icon} alt="" class="w-3 h-3 invert group-hover:invert-0 group-hover:sepia group-hover:saturate-200 group-hover:hue-rotate-50" />
              </a>
            )}
             {/* If there's a second button (Jesse) */}
             {member.button_2 && (
              <a href="#" class="inline-flex items-center gap-2 text-sm text-secondary hover:text-brand-100 transition-colors border border-default/30 px-4 py-2 rounded-lg hover:border-brand-100/50">
                {member.button_2.text}
                 <Image src={member.button_2.icon} alt="" class="w-3 h-3 invert group-hover:invert-0 group-hover:sepia group-hover:saturate-200 group-hover:hue-rotate-50" />
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
