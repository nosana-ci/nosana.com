---
import { getCollection } from "astro:content";
import CaseStudyCard from "./latestCaseStudyCard.astro";

const allBlogs = await getCollection("blogs");

const caseStudies = allBlogs
  .filter(
    (entry): entry is typeof entry & {
      data: Extract<typeof entry.data, { category: "case-study" }>;
    } => entry.data.category === "case-study"
  )
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime())
  .slice(0, 4);

if (!caseStudies.length) return null;
---

<section
  class="case-study-slider relative w-full overflow-hidden"
  aria-label="Latest Case Studies"
>
  <!-- Slider Container -->
  <div class="relative w-full">
    <!-- Track -->
    <div class="flex transition-transform duration-500 ease-out slider-track will-change-transform">
      {
        caseStudies.map((blog) => (
          <div class="w-full shrink-0 slider-item">
            <CaseStudyCard
              title={blog.data.title}
              description={blog.data.description}
              thumbnail={blog.data.thumbnail}
              logo={blog.data.logo}
              author={blog.data.author}
              role={blog.data.role}
              blogUrl={`/case-study/${blog.id}`}
            />
          </div>
        ))
      }
    </div>

    <!-- Navigation Dots -->
    <div class="flex px-4 md:px-12 gap-2 mt-8 slider-dots">
      {
        caseStudies.map((_, index) => (
          <button
            class="w-2 h-2 rounded-full transition-all duration-300 bg-secondary hover:bg-primary/50 aria-current:bg-primary"
            aria-label={`Go to slide ${index + 1}`}
            aria-current={index === 0 ? "true" : "false"}
            data-index={index}
          />
        ))
      }
    </div>
  </div>

  <script>
    function initSliders() {
      const sliders = document.querySelectorAll(".case-study-slider");

      sliders.forEach((slider) => {
        const track = slider.querySelector(".slider-track") as HTMLElement;
        const dots = slider.querySelectorAll("[data-index]");
        let currentIndex = 0;
        let startX = 0;
        let currentTranslate = 0;
        let prevTranslate = 0;
        let isDragging = false;
        let interval: any;

        const updateSlider = (index: number) => {
          currentIndex = index;
          prevTranslate = -currentIndex * 100;
          currentTranslate = prevTranslate;
          track.style.transition = 'transform 0.5s ease-out';
          track.style.transform = `translateX(${currentTranslate}%)`;
          
          dots.forEach((dot, i) => {
            dot.setAttribute("aria-current", i === currentIndex ? "true" : "false");
          });
        };

        const nextSlide = () => {
          currentIndex = (currentIndex + 1) % dots.length;
          updateSlider(currentIndex);
        };

        const startAutoPlay = () => {
          clearInterval(interval);
          interval = setInterval(nextSlide, 5000);
        };

        const stopAutoPlay = () => clearInterval(interval);

        // Dot Navigation
        dots.forEach((dot, index) => {
          dot.addEventListener("click", () => {
             updateSlider(index);
             startAutoPlay();
          });
        });

        // dragging logic
        const getPositionX = (event: MouseEvent | TouchEvent) => {
          return event instanceof MouseEvent ? event.pageX : event.touches[0].clientX;
        };

        const touchStart = (event: MouseEvent | TouchEvent) => {
          startX = getPositionX(event);
          isDragging = true;
          stopAutoPlay();
          track.style.transition = 'none';
        };

        const touchMove = (event: MouseEvent | TouchEvent) => {
          if (!isDragging) return;
          const currentX = getPositionX(event);
          const diff = ((currentX - startX) / track.offsetWidth) * 100;
          currentTranslate = prevTranslate + diff;
          track.style.transform = `translateX(${currentTranslate}%)`;
        };

        const touchEnd = (event: MouseEvent | TouchEvent) => {
          if (!isDragging) return;
          isDragging = false;
          track.style.transition = 'transform 0.5s ease-out';
          
          const movedBy = currentTranslate - prevTranslate;

          if (movedBy < -10 && currentIndex < dots.length - 1) {
            currentIndex += 1;
          } else if (movedBy > 10 && currentIndex > 0) {
            currentIndex -= 1;
          }
          
          updateSlider(currentIndex);
          startAutoPlay();
        };

        // Mouse Events
        track.addEventListener('mousedown', touchStart);
        window.addEventListener('mousemove', touchMove);
        window.addEventListener('mouseup', touchEnd);

        // Touch Events
        track.addEventListener('touchstart', touchStart, { passive: true });
        track.addEventListener('touchmove', touchMove, { passive: true });
        track.addEventListener('touchend', touchEnd);

        // Prevent context menu on long press
        track.addEventListener('contextmenu', (e) => {
          if (isDragging) e.preventDefault();
        });

        // Pause on hover
        slider.addEventListener("mouseenter", stopAutoPlay);
        slider.addEventListener("mouseleave", startAutoPlay);

        // Initialize
        updateSlider(0);
        startAutoPlay();
      });
    }

    // Run on load and after Astro swaps
    document.addEventListener("DOMContentLoaded", initSliders);
    document.addEventListener("astro:page-load", initSliders);
  </script>
</section>
