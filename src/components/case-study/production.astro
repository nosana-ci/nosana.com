---
import { getEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import TestimonialGrid from "../testimonials/testimonialGrid.astro";

const entry = await getEntry("homepage", "index");
if (!entry) {
  throw new Error("Homepage content not found");
}
const { production } = entry.data;
---

<section class="w-full bg-bg-base px-4 lg:px-12">
  <Badge
    title={production.badge.title}
    icon={production.badge.icon}
    variant="filled"
    class="mb-4"
  />

  <h2 class="text-primary h4 grotesk max-w-3xl mb-4">
    {production.heading}
  </h2>

  <p class="text-secondary md:max-w-xl leading-relaxed mb-10 body2">
    {production.description}
  </p>

  <TestimonialGrid variant="collaboration" />
</section>
