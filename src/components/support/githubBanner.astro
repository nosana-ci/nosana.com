---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

import Button from "../ui/button.astro";

const entry = await getEntry("support", "index");
if (!entry) {
  throw new Error("Support content not found");
}

const { github } = entry.data;
---

<section class="w-full min-h-[30vh] lg:h-[45vh] px-4 lg:px-12">
  <div
    class="flex flex-col md:flex-row
           w-full min-h-[30vh] lg:h-[45vh]
           overflow-hidden"
  >
    <div class="w-full md:w-[55%] relative">
      <Image
        src={github.image}
        alt="GitHub"
        class="w-full h-full object-cover border border-elevated select-none pointer-events-none"
      />
    </div>

    <div
      class="w-full md:w-[45%]
             flex flex-col
             justify-between
             px-6 md:px-10 py-8
             border border-elevated"
    >
      <div>
        <h3 class="text-primary body1">GitHub</h3>

        <p class="text-secondary body3 mt-2">
          {github.text}
        </p>
      </div>

      <div>
        <div class="w-full py-8">
          <div class="w-full h-px bg-elevated"></div>
        </div>

        <Button
          title="Github"
          url={github.url}
          target="_blank"
          icon={github.icon}
          iconColor="#fafafa"
          iconSize={32}
          class="w-full"
          variant="secondary"
          data-cta="github"
        />
      </div>
    </div>
  </div>
</section>
