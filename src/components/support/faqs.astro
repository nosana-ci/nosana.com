---
import { getEntry } from "astro:content";

const entry = await getEntry("support", "index");
if (!entry) {
  throw new Error("Support content not found");
}

const { faqs } = entry.data;
---

<section class="w-full px-4 md:px-12">
  <div class="max-w-5xl mx-auto">
    <!-- Heading -->
    <h2 class="text-primary h4 grotesk mb-10">
      Frequently Asked Questions
    </h2>

    {faqs.map((faq, index) => (
      <details
        class="group border-b border-elevated"
        data-faq
        open={index === 0}
      >
        <summary
          class="flex items-center justify-between
                 py-6 cursor-pointer select-none
                 list-none"
        >
          <span class="text-primary body2">
            {faq.question}
          </span>

          <!-- Icons -->
          <span class="flex items-center justify-center w-5 h-5">
            <!-- PLUS -->
            <svg
              class="block group-open:hidden"
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18 9C18 9.19891 17.921 9.38968 17.7803 9.53033C17.6397 9.67098 17.4489 9.75 17.25 9.75H9.75V17.25C9.75 17.4489 9.67098 17.6397 9.53033 17.7803C9.38968 17.921 9.19891 18 9 18C8.80109 18 8.61032 17.921 8.46967 17.7803C8.32902 17.6397 8.25 17.4489 8.25 17.25V9.75H0.75C0.551088 9.75 0.360322 9.67098 0.21967 9.53033C0.0790178 9.38968 0 9.19891 0 9C0 8.80109 0.0790178 8.61032 0.21967 8.46967C0.360322 8.32902 0.551088 8.25 0.75 8.25H8.25V0.75C8.25 0.551088 8.32902 0.360322 8.46967 0.21967C8.61032 0.0790178 8.80109 0 9 0C9.19891 0 9.38968 0.0790178 9.53033 0.21967C9.67098 0.360322 9.75 0.551088 9.75 0.75V8.25H17.25C17.4489 8.25 17.6397 8.32902 17.7803 8.46967C17.921 8.61032 18 8.80109 18 9Z"
                fill="#C9C9C9"
              />
            </svg>

            <!-- MINUS -->
            <svg
              class="hidden group-open:block"
              width="18"
              height="2"
              viewBox="0 0 18 2"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18 0.75C18 0.948912 17.921 1.13968 17.7803 1.28033C17.6397 1.42098 17.4489 1.5 17.25 1.5H0.75C0.551088 1.5 0.360322 1.42098 0.21967 1.28033C0.0790178 1.13968 0 0.948912 0 0.75C0 0.551088 0.0790178 0.360322 0.21967 0.21967C0.360322 0.0790178 0.551088 0 0.75 0H17.25C17.4489 0 17.6397 0.0790178 17.7803 0.21967C17.921 0.360322 18 0.551088 18 0.75Z"
                fill="#C9C9C9"
              />
            </svg>
          </span>
        </summary>

        <div class="pb-6 text-secondary body2">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>

<script>
  const faqs = document.querySelectorAll<HTMLDetailsElement>('[data-faq]');

  faqs.forEach((faq) => {
    faq.addEventListener('toggle', () => {
      if (faq.open) {
        faqs.forEach((other) => {
          if (other !== faq) other.open = false;
        });
      }
    });
  });
</script>
