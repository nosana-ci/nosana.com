---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import NavigateButton from "../ui/navigateButton.astro";
import searchIcon from "../../assets/icons/search.svg";

const blogs = await getCollection("blogs", ({ data }) => {
  return data.category === "blog";
});

// Sort by date descending
const sortedBlogs = blogs.sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());

const blogsHomepage = await getEntry("blogsHomepage", "index");
const filters = blogsHomepage?.data.filters || [];

const formattedBlogs = sortedBlogs.map(blog => {
  const data = blog.data;
  const tags = 'tags' in data ? data.tags || [] : [];
  return {
    ...data,
    tags,
    slug: blog.id,
    formattedDate: blog.data.createdAt.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }),
    timestamp: blog.data.createdAt.getTime()
  };
});
---

<section class="w-full pb-20" id="blogs-grid-section">
  <div class="px-4 md:px-12 flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 lg:mb-12">
    <!-- Filters -->
    <div class="flex flex-wrap items-center border border-default rounded-sm p-2">
      <button 
        class="filter-tab px-4 py-2 rounded-xs transition body3 cursor-pointer active-tab bg-white/10 text-primary"
        data-filter="all"
      >
        All posts
      </button>
      {filters.map(filter => (
        <button 
          class="filter-tab px-4 py-2 rounded-xs transition body3 cursor-pointer text-secondary hover:text-primary capitalize"
          data-filter={filter}
        >
          {filter === 'aiml' ? 'AI & ML' : filter}
        </button>
      ))}
    </div>

    <!-- Search -->
    <div class="relative w-full md:w-1/4">
      <input 
        type="text" 
        id="blog-search"
        placeholder="Search for Blogs..." 
        class="w-full bg-surface rounded-sm p-4 pr-10 text-primary placeholder:text-tertiary body4 outline-none focus:border-brand-100/50 transition"
      />
      <Image 
        src={searchIcon} 
        alt="search" 
        class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 opacity-50"
      />
    </div>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-white/10 mx-4 md:mx-12">
    {formattedBlogs.map((blog, index) => (
      <a 
        href={`/blog/${blog.slug}`}
        class="blog-card border-r border-b border-white/10 pt-4 px-4 lg:pt-10 lg:px-6 flex flex-col gap-4 hover:bg-white/2 transition group h-full overflow-hidden"
        data-category={blog.category}
        data-tags={JSON.stringify(blog.tags || [])}
        data-title={blog.title.toLowerCase()}
        data-date={blog.formattedDate.toLowerCase()}
      >
        <div class="w-full aspect-video overflow-hidden">
          <Image 
            src={blog.thumbnail} 
            alt={blog.title} 
            class="w-full h-full object-cover select-none pointer-events-none"
          />
        </div>
        
        <div class="flex flex-col relative overflow-hidden">
          <!-- Sliding Container -->
          <div class="flex flex-col transition-transform duration-500 ease-out group-hover:-translate-y-8">
            <!-- Date Area -->
            <div class="flex items-center gap-2 text-secondary caption1 opacity-60 h-6 mb-4 group-hover:opacity-0 transition-opacity duration-300">
              <span>{blog.formattedDate}</span>
              <span class="-mt-1">|</span>
            </div>

            <!-- Title Area -->
            <h3 class="text-primary body2 line-clamp-2 min-h-[3.2em] transition-colors duration-300">
              {blog.title}
            </h3>
            
            <!-- Description Area (Slides into view) -->
            <div class="mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
              <p class="text-secondary body4 line-clamp-3">
                {blog.description}
              </p>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- Empty State -->
  <div id="no-results" class="hidden text-center py-20 px-4">
    <p class="text-secondary body1">No blogs found matching your criteria.</p>
  </div>

  <!-- Pagination -->
  <div id="blog-pagination" class="flex items-center justify-center py-12 md:py-16 gap-4">
    <NavigateButton
      id="blog-prev"
      variant="secondary"
      direction="left"
      text="Back"
      class="cursor-pointer"
    />

    <div id="blog-pages" class="flex gap-2"></div>

    <NavigateButton
      id="blog-next"
      variant="secondary"
      direction="right"
      text="Next"
      class="cursor-pointer"
    />
  </div>
</section>

<style>
  .active-tab {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-primary);
  }
</style>

<script>
  function initBlogsGrid() {
    const section = document.getElementById("blogs-grid-section");
    if (!section) return;

    const cards = Array.from(section.querySelectorAll(".blog-card")) as HTMLElement[];
    const searchInput = section.querySelector("#blog-search") as HTMLInputElement;
    const filterTabs = section.querySelectorAll(".filter-tab");
    const pagesContainer = section.querySelector("#blog-pages");
    const prevBtn = section.querySelector("#blog-prev") as HTMLButtonElement;
    const nextBtn = section.querySelector("#blog-next") as HTMLButtonElement;
    const noResults = section.querySelector("#no-results");
    const paginationContainer = section.querySelector("#blog-pagination");

    let currentFilter = "all";
    let searchQuery = "";
    let currentPage = 0;
    const ITEMS_PER_PAGE = 6;

    let visibleCards: HTMLElement[] = cards;

    function filterCards() {
      searchQuery = searchInput.value.toLowerCase().trim();
      
      visibleCards = cards.filter(card => {
        const category = card.getAttribute("data-category");
        const tags = JSON.parse(card.getAttribute("data-tags") || "[]");
        const title = card.getAttribute("data-title") || "";
        const date = card.getAttribute("data-date") || "";

        const matchesFilter = currentFilter === "all" || 
                             category === currentFilter || 
                             tags.includes(currentFilter);
        
        const matchesSearch = !searchQuery || 
                             title.includes(searchQuery) || 
                             date.includes(searchQuery) || 
                             tags.some((t: string) => t.toLowerCase().includes(searchQuery));

        return matchesFilter && matchesSearch;
      });

      currentPage = 0;
      updateDisplay();
    }

    function updateDisplay() {
      const totalPages = Math.ceil(visibleCards.length / ITEMS_PER_PAGE);
      
      // Toggle card visibility
      cards.forEach(card => card.classList.add("hidden"));
      
      const start = currentPage * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;
      
      visibleCards.slice(start, end).forEach(card => card.classList.remove("hidden"));

      // Update Pagination
      if (visibleCards.length === 0) {
        noResults?.classList.remove("hidden");
        paginationContainer?.classList.add("hidden");
      } else {
        noResults?.classList.add("hidden");
        paginationContainer?.classList.remove("hidden");
        renderPagination(totalPages);
      }

      // Update button states
      if (prevBtn) {
        prevBtn.disabled = currentPage === 0;
        prevBtn.classList.toggle("opacity-40", currentPage === 0);
        prevBtn.classList.toggle("pointer-events-none", currentPage === 0);
      }
      if (nextBtn) {
        nextBtn.disabled = currentPage === totalPages - 1 || totalPages === 0;
        nextBtn.classList.toggle("opacity-40", currentPage === totalPages - 1 || totalPages === 0);
        nextBtn.classList.toggle("pointer-events-none", currentPage === totalPages - 1 || totalPages === 0);
      }
    }

    function renderPagination(totalPages: number) {
      if (!pagesContainer) return;
      pagesContainer.innerHTML = "";

      if (totalPages <= 1) {
        paginationContainer?.classList.add("hidden");
        return;
      }
      paginationContainer?.classList.remove("hidden");

      for (let i = 0; i < totalPages; i++) {
        const btn = document.createElement("button");
        btn.textContent = String(i + 1);
        btn.className = "w-10 h-10 body4 rounded-[5px] transition cursor-pointer " +
          (i === currentPage
            ? "bg-brand-100 text-bg-base"
            : "bg-white/15 text-secondary hover:bg-brand-100/50 hover:text-primary");

        btn.addEventListener("click", () => {
          currentPage = i;
          updateDisplay();
          if (section) {
            window.scrollTo({ top: section.offsetTop - 100, behavior: 'smooth' });
          }
        });

        pagesContainer.appendChild(btn);
      }
    }

    // Event Listeners
    searchInput?.addEventListener("input", filterCards);

    filterTabs.forEach(tab => {
      tab.addEventListener("click", () => {
        filterTabs.forEach(t => {
          t.classList.remove("active-tab", "bg-white/10", "text-primary");
          t.classList.add("text-secondary");
        });
        tab.classList.add("active-tab", "bg-white/10", "text-primary");
        tab.classList.remove("text-secondary");
        
        currentFilter = tab.getAttribute("data-filter") || "all";
        filterCards();
      });
    });

    prevBtn?.addEventListener("click", () => {
      if (currentPage > 0) {
        currentPage--;
        updateDisplay();
        if (section) {
          window.scrollTo({ top: section.offsetTop - 100, behavior: 'smooth' });
        }
      }
    });

    nextBtn?.addEventListener("click", () => {
      const totalPages = Math.ceil(visibleCards.length / ITEMS_PER_PAGE);
      if (currentPage < totalPages - 1) {
        currentPage++;
        updateDisplay();
        if (section) {
          window.scrollTo({ top: section.offsetTop - 100, behavior: 'smooth' });
        }
      }
    });

    // Initial render
    updateDisplay();
  }

  // Run on first load
  initBlogsGrid();

  // Run on subsequent navigations (if using View Transitions)
  document.addEventListener('astro:after-swap', initBlogsGrid);
</script>
