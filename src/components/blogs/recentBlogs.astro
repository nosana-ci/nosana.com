---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Pagination from "../ui/pagination.astro";

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

const blogs = await getCollection("blogs", ({ data }) => {
  return data.category === "blog";
});

// Sort by date descending and filter out current slug
const filteredBlogs = blogs
  .filter(blog => blog.id !== currentSlug)
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());

const ITEMS_PER_PAGE = 3;

const formattedBlogs = filteredBlogs.map(blog => {
  const data = blog.data;
  const tags = 'tags' in data ? data.tags || [] : [];
  return {
    ...data,
    tags,
    slug: blog.id,
    formattedDate: blog.data.createdAt.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }),
    timestamp: blog.data.createdAt.getTime()
  };
});

const totalPages = Math.ceil(formattedBlogs.length / ITEMS_PER_PAGE);
const pageItems = Array.from({ length: totalPages }, (_, i) => String(i + 1));
---

<section class="w-full" id="blogs-grid-section">
  <div class="px-4 lg:px-12 mb-8 lg:mb-12">
    <h2 class="h4 text-primary grotesk mb-4">
      Catch Up on Nosana&apos;s Recent Blogs
    </h2>
    <p class="body2 text-secondary max-w-5xl">
      Run your AI jobs across a decentralized GPU grid. No lock-ins, no downtime, no inflated cloud bills just pure compute power, when you need it.
    </p>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-white/10 mx-4 md:mx-12">
    {formattedBlogs.map((blog, index) => (
      <a 
        href={`/blog/${blog.slug}`}
        class="blog-card border-r border-b border-white/10 pt-4 px-4 lg:pt-10 lg:px-6 flex flex-col gap-4 hover:bg-white/2 transition group h-full overflow-hidden"
      >
        <div class="w-full aspect-video overflow-hidden">
          <Image 
            src={blog.thumbnail} 
            alt={blog.title} 
            class="w-full h-full object-cover select-none pointer-events-none"
          />
        </div>
        
        <div class="flex flex-col relative overflow-hidden">
          <!-- Sliding Container -->
          <div class="flex flex-col transition-transform duration-500 ease-out group-hover:-translate-y-8">
            <!-- Date Area -->
            <div class="flex items-center gap-2 text-secondary caption1 opacity-60 h-6 mb-4 group-hover:opacity-0 transition-opacity duration-300">
              <span>{blog.formattedDate}</span>
              <span class="-mt-1">|</span>
            </div>

            <!-- Title Area -->
            <h3 class="text-primary body2 line-clamp-2 min-h-[3.2em] transition-colors duration-300">
              {blog.title}
            </h3>
            
            <!-- Description Area (Slides into view) -->
            <div class="mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
              <p class="text-secondary body4 line-clamp-3">
                {blog.description}
              </p>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- Empty State -->
  <div id="no-results" class="hidden text-center py-20 px-4">
    <p class="text-secondary body1">No blogs found.</p>
  </div>

  <!-- Pagination -->
  <div id="recent-pagination-wrapper" class="flex items-center justify-center py-12 md:py-16">
    <Pagination id="recent-pagination" items={pageItems} />
  </div>
</section>

<style>
</style>

<script>
  function initRecentBlogs() {
    const section = document.getElementById("blogs-grid-section");
    if (!section) return;

    const cards = Array.from(section.querySelectorAll(".blog-card")) as HTMLElement[];
    const noResults = section.querySelector("#no-results");
    const paginationWrapper = section.querySelector("#recent-pagination-wrapper");
    const paginationEl = section.querySelector<HTMLElement>("#recent-pagination");

    let currentPage = 0;
    const ITEMS_PER_PAGE = 3;

    function updateDisplay() {
      const totalPages = Math.ceil(cards.length / ITEMS_PER_PAGE);

      cards.forEach(card => card.classList.add("hidden"));
      const start = currentPage * ITEMS_PER_PAGE;
      cards.slice(start, start + ITEMS_PER_PAGE).forEach(card =>
        card.classList.remove("hidden")
      );

      if (cards.length === 0) {
        noResults?.classList.remove("hidden");
        paginationWrapper?.classList.add("hidden");
      } else {
        noResults?.classList.add("hidden");
        if (totalPages <= 1) {
          paginationWrapper?.classList.add("hidden");
        } else {
          paginationWrapper?.classList.remove("hidden");
        }
      }
    }

    paginationEl?.addEventListener("pagination:change", (e) => {
      currentPage = (e as CustomEvent).detail.index;
      updateDisplay();
      window.scrollTo({ top: section.offsetTop - 100, behavior: "smooth" });
    });

    updateDisplay();
  }

  initRecentBlogs();
  document.addEventListener("astro:after-swap", initRecentBlogs);
</script>
