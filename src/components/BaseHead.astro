---
interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
  type?: "website" | "article";
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title,
  description,
  image = "/og-image.png",
  noIndex = false,
  type = "website",
  ogTitle,
  ogDescription,
} = Astro.props;

const formattedTitle = title.includes("Nosana") ? title : `${title} | Nosana`;
const resolvedOgTitle = ogTitle || formattedTitle;
const resolvedOgDescription = ogDescription || description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<title>{formattedTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL.href} />

{noIndex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={resolvedOgTitle} />
<meta property="og:description" content={resolvedOgDescription} />
<meta property="og:image" content={ogImageURL.href} />
<meta property="og:site_name" content="Nosana - GPU Cloud" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@nosana_ai" />
<meta name="twitter:title" content={resolvedOgTitle} />
<meta name="twitter:description" content={resolvedOgDescription} />
<meta name="twitter:image" content={ogImageURL.href} />
<meta name="twitter:url" content={canonicalURL.href} />
