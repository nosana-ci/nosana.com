---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import Button from "../ui/button.astro";

import officialLogo from "../../content/brand-assets/assets/official_logo.svg";
import logoMark from "../../content/brand-assets/assets/logo.svg";
import wordmark from "../../content/brand-assets/assets/wordmark.svg";
import safezone from "../../content/brand-assets/assets/safezone.svg";
import safezoneSmall from "../../content/brand-assets/assets/safezone-small.svg";
import Divider from "../ui/divider.astro";

type Props = {
  heroSection: CollectionEntry<"brandAssets">["data"]["heroSection"];
  logoSection: CollectionEntry<"brandAssets">["data"]["logoSection"];
};

const { heroSection, logoSection } = Astro.props;
---

<div class="px-4 md:px-12">
  <section class="bg-bg-base w-full pt-8 md:pt-16 lg:pt-18">
    <div
      class="flex flex-col-reverse gap-8 md:flex-row md:items-start md:justify-between lg:gap-10"
    >
      <div class="flex flex-col gap-4">
        <Badge title={heroSection.badge} class="w-fit"/>
        <h1 class="text-primary h4 grotesk">{heroSection.heading}</h1>
        <p class="text-secondary body2 max-w-3xl">{heroSection.description}</p>
        <div>
          <Button
            title="Download Full Brand Kit (.zip)"
            url={heroSection.downloadUrl}
            variant="secondary"
          />
        </div>
      </div>

      <Image
        src={safezoneSmall}
        alt="Nosana Logo"
        class="mx-auto select-none md:mx-0"
      />
    </div>
  </section>

  <div class="bg-elevated my-12 h-px w-full md:my-18"></div>

  <section class="bg-bg-base w-full">
    <div
      class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between"
    >
      <div class="flex flex-col gap-3">
        <h2 class="text-primary h4 grotesk">{logoSection.heading}</h2>
        <p class="text-secondary body2 max-w-2xl">{logoSection.description}</p>
      </div>
      <div class="lg:my-auto lg:h-full">
        <Button
          title="Download Logo File"
          url="/logo.svg"
          download="logo.svg"
          variant="secondary"
        />
      </div>
    </div>

    <div class="bg-elevated my-12 h-px w-full md:my-18"></div>

    <div class="grid grid-cols-1 gap-y-16 sm:grid-cols-3 sm:gap-y-0">
      <!-- Official Logo -->
      <div class="border-elevated sm:border-r">
        <div
          class="border-elevated flex items-center justify-center px-6 py-5 sm:h-40 sm:items-end sm:border-b md:h-44"
        >
          <span class="text-primary body3">Nosana Official Logo</span>
        </div>
        <div
          class="border-elevated flex h-28 items-center justify-center border-y px-4 sm:border-t-0 sm:border-b md:h-36"
        >
          <Image
            src={officialLogo}
            alt="Nosana Official Logo"
            class="h-full py-4 select-none"
          />
        </div>
        <div class="hidden h-32 sm:block"></div>
      </div>

      <!-- Logo -->
      <div class="border-elevated sm:border-r">
        <div
          class="border-elevated flex items-center justify-center px-6 py-5 sm:h-40 sm:items-end sm:border-b md:h-44"
        >
          <span class="text-primary body3">Nosana-logo</span>
        </div>
        <div
          class="border-elevated flex h-28 items-center justify-center border-y px-4 sm:border-t-0 sm:border-b md:h-36"
        >
          <Image
            src={logoMark}
            alt="Nosana Logo Mark"
            class="h-full py-4 select-none"
          />
        </div>
        <div class="hidden h-32 sm:block"></div>
      </div>

      <!-- Wordmark -->
      <div>
        <div
          class="border-elevated flex items-center justify-center px-6 py-5 sm:h-40 sm:items-end sm:border-b md:h-44"
        >
          <span class="text-primary body3">Nosana-Wordmark</span>
        </div>
        <div
          class="border-elevated flex h-28 items-center justify-center border-y px-4 sm:border-t-0 sm:border-b md:h-36"
        >
          <Image
            src={wordmark}
            alt="Nosana Wordmark"
            class="h-full py-4 select-none"
          />
        </div>
        <div class="hidden h-32 sm:block"></div>
      </div>
    </div>

    <div class="hidden sm:block">
      <Divider />
    </div>

    <div
      class="grid grid-cols-1 gap-y-16 max-sm:mt-16 sm:grid-cols-2 sm:gap-y-0"
    >
      <!-- Safezone -->
      <div class="border-elevated sm:border-r">
        <div
          class="border-elevated flex items-center justify-center px-6 py-5 sm:h-44 sm:items-end sm:border-b"
        >
          <span class="text-primary body3">Safezone</span>
        </div>
        <div
          class="border-elevated flex h-28 items-center justify-center border-y px-4 sm:h-36 sm:border-t-0 sm:border-b"
        >
          <Image
            src={safezone}
            alt="Nosana Safezone"
            class="h-full w-auto py-4 select-none"
          />
        </div>
        <div class="hidden h-32 sm:block"></div>
      </div>

      <!-- Safe Zone -->
      <div>
        <div
          class="border-elevated flex items-center justify-center px-6 py-5 sm:h-44 sm:items-end sm:border-b"
        >
          <span class="text-primary body3">Safe Zone</span>
        </div>
        <div
          class="border-elevated flex h-28 items-center justify-center border-y px-4 sm:h-36 sm:border-t-0 sm:border-b"
        >
          <Image
            src={safezoneSmall}
            alt="Nosana Safe Zone Small"
            class="h-full w-auto py-4 select-none"
          />
        </div>
        <div class="hidden h-32 sm:block"></div>
      </div>
    </div>
  </section>
</div>
