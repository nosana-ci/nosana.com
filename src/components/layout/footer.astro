---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import NavColumn from "../../components/ui/footerNavColumn.astro";
import Socials from "../../components/ui/socials.astro";

const entry = await getEntry("footer", "index");
if (!entry) {
  throw new Error("content not found");
}

const footer = entry.data;

const {
  logo,
  description,
  navigation,
  copyright,
  termsAndConditionsUrl,
  privacyPolicyUrl,
} = footer;
---

<footer class="bg-bg-base text-primary mx-auto w-full max-w-[1728px]" data-footer>
  <div class="mx-auto px-4 py-8 md:px-12 md:py-16 lg:py-18">
    <div class="mb-14 w-full">
      <a href="/"
        ><Image
          src={logo}
          alt="Nosana logo"
          class="mb-4 h-5 w-auto cursor-pointer"
          loading="lazy"
          decoding="async"
        /></
      >

      <p class="body2 text-secondary mb-8 max-w-lg md:mb-16 lg:mb-18">
        {description}
      </p>
      <Socials />
    </div>

    <div
      class="grid w-full grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4 lg:grid-cols-6"
    >
      <NavColumn title="Product" items={navigation.product} />
      <NavColumn title="Network" items={navigation.network} />
      <NavColumn title="Grants" items={navigation.grants} />
      <NavColumn title="Learning Center" items={navigation.learningCenter} />
      <NavColumn title="Community" items={navigation.community} />
      <NavColumn title="Resources" items={navigation.resources} />
    </div>
  </div>

  <div class="border-t border-white/15"></div>

  <div class="mx-auto px-4 py-6 md:px-12">
    <div
      class="body4 text-secondary flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
    >
      <span>{copyright}</span>

      <div class="body4 flex gap-6">
        <a href={termsAndConditionsUrl} class="hover:text-brand-100 transition">
          Terms & Conditions
        </a>
        <a href={privacyPolicyUrl} class="hover:text-brand-100 transition">
          Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>
