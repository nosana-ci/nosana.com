---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import NavColumn from "../../components/ui/footerNavColumn.astro";
import Socials from "../../components/ui/socials.astro";

const entry = await getEntry("footer", "index");
if (!entry) {
  throw new Error("content not found");
}

const footer = entry.data;

const {
  logo,
  description,
  navigation,
  copyright,
  termsAndConditionsUrl,
  privacyPolicyUrl,
} = footer;
---

<footer class="w-full bg-bg-base text-primary">
  <div class="mx-auto px-4 md:px-12 py-8 md:py-16 lg:py-18">
    <div class="w-full mb-14">
      <a href="/"
        ><Image
          src={logo}
          alt="Nosana logo"
          class="h-5 w-auto mb-4 cursor-pointer"
        /></a
      >

      <p class="body2 text-secondary max-w-lg mb-8 md:mb-16 lg:mb-18">
        {description}
      </p>
      <Socials />
    </div>

    <div
      class="w-full grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-x-8 gap-y-10"
    >
      <NavColumn title="Product" items={navigation.product} />
      <NavColumn title="Network" items={navigation.network} />
      <NavColumn title="Grants" items={navigation.grants} />
      <NavColumn title="Learning Center" items={navigation.learningCenter} />
      <NavColumn title="Community" items={navigation.community} />
      <NavColumn title="Resources" items={navigation.resources} />
    </div>
  </div>

  <div class="border-t border-white/15"></div>

  <div class="mx-auto px-4 md:px-12 py-6">
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 body4 text-secondary"
    >
      <span>{copyright}</span>

      <div class="flex gap-6 body4">
        <a href={termsAndConditionsUrl} class="hover:text-brand-100 transition">
          Terms & Conditions
        </a>
        <a href={privacyPolicyUrl} class="hover:text-brand-100 transition">
          Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>
