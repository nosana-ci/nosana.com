---
import { getEntry } from "astro:content";
import chevronDownDouble from "../../assets/icons/chevronDownDouble.svg?raw";

const entry = await getEntry("layout", "index");

if (!entry) {
  throw new Error("content not found");
}

const { newsletter } = entry.data;
const { heading, description, formUrl } = newsletter;
---

<div
  class="w-full h-fit
         bg-surface
         rounded-lg
         p-5
         flex flex-col gap-5"
>

  <!-- Content -->
  <div class="flex flex-col gap-2">
    <h3 class="text-primary body4">
      {heading}
    </h3>

    <p class="text-secondary caption1">
      {description}
    </p>
  </div>

  <!-- Form -->
  <form
    id="newsletter-form-secondary"
    data-form-url={formUrl}
    class="flex flex-col gap-3 w-full"
  >
    <input
      type="email"
      name="email"
      placeholder="Enter your email"
      class="w-full
             bg-primary
             text-secondarydark
             placeholder:text-secondarydark/60
             border border-default
             rounded-sm
             px-4 py-2.5
             outline-none
             focus:border-white/40
             transition-colors"
    />

    <button
      type="submit"
      class="group inline-flex items-stretch w-full
             overflow-hidden
             rounded-sm font-semibold
             bg-white/15 hover:bg-white/20
             border border-default
             text-primary
             transition-all cursor-pointer"
    >
      <span class="flex items-center justify-center gap-2 py-2.5 px-4 body4 w-full">
        Subscribe <span class="hidden sm:inline">to Newsletter</span>
      </span>

      <span class="flex items-center justify-center border-l border-default px-3">
        <span class="w-4 h-4 relative">
          <span
            class="flex transition-transform duration-300
                   -translate-x-4
                   group-hover:translate-x-0"
          >
            <span
              class="w-4 h-4 flex items-center justify-center
                     shrink-0 opacity-0 group-hover:opacity-100
                     transition-opacity duration-300
                     [&_path]:fill-current -rotate-90
                     pointer-events-none select-none"
            >
              <Fragment set:html={chevronDownDouble} />
            </span>

            <span
              class="w-4 h-4 flex items-center justify-center
                     shrink-0 opacity-100 group-hover:opacity-0
                     transition-opacity duration-300
                     [&_path]:fill-current -rotate-90
                     pointer-events-none select-none"
            >
              <Fragment set:html={chevronDownDouble} />
            </span>
          </span>
        </span>
      </span>
    </button>
  </form>

</div>

<script>
  const form = document.getElementById("newsletter-form-secondary");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const button = form.querySelector("button[type='submit']");
    const buttonText = button.querySelector("span");

    const originalText = buttonText.innerHTML;

    button.disabled = true;
    buttonText.innerHTML = "Subscribing...";

    try {
      const emailValue = formData.get("email");
      const apiBase = import.meta.env.PUBLIC_API_BASE_URL || "https://dashboard.k8s.prd.nos.ci";
      const res = await fetch(`${apiBase}/api/newsletter/subscribe`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: emailValue }),
      });

      if (!res.ok) throw new Error();

      window.dispatchEvent(
        new CustomEvent("toast", {
          detail: {
            type: "success",
            message: "Thank you for signing up. You'll start receiving the latest updates from Nosana shortly."
          }
        })
      );

      form.reset();
    } catch {
      window.dispatchEvent(
        new CustomEvent("toast", {
          detail: {
            type: "error",
            message: "Failed to subscribe. Please try again."
          }
        })
      );
    } finally {
      setTimeout(() => {
        button.disabled = false;
        buttonText.innerHTML = originalText;
      }, 400);
    }
  });
</script>