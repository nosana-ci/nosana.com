---
import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import externalLink from "../../assets/icons/externalLink.svg";
import hamburgerIcon from "../../assets/icons/hamburger.svg?raw";
import closeIcon from "../../assets/icons/close.svg?raw";
import Button from "../ui/button.astro";
import FeaturedEvent from "../events/featuredEvent.astro";

const navbarEntry = await getEntry("navbar", "index");
if (!navbarEntry) {
  throw new Error("content not found");
}
const { navLogo, navItems, navCTA } = navbarEntry.data;
const currentPath = Astro.url.pathname;

// Get featured content title
const events = await getCollection("events");
const blogs = await getCollection("blogs");
const now = new Date();

const upcomingEvents = events.filter(event => new Date(event.data.createdAt) >= now);
const sortedUpcomingEvents = upcomingEvents.sort(
  (a, b) => new Date(a.data.createdAt).getTime() - new Date(b.data.createdAt).getTime()
);

const sortedBlogs = blogs.sort(
  (a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime()
);
const latestBlog = sortedBlogs[0];

let featuredTitle = "";
if (sortedUpcomingEvents.length > 0) {
  featuredTitle = "Upcoming Event";
} else if (latestBlog) {
  featuredTitle = latestBlog.data.category === 'blog' ? "Latest Blog" : "Latest Case Study";
}

const normalizePath = (path: string) => {
  if (!path) return "";
  // Strip hash for comparison
  const base = path.split("#")[0];
  // Remove trailing slash except for root
  return base === "/" ? "/" : base.replace(/\/$/, "");
};

const normalizedCurrentPath = normalizePath(currentPath);
const isGrantsPage = normalizedCurrentPath === "/grants";
---

<nav-container class="z-100 block w-full max-w-[1728px] mx-auto" data-navbar>
  <nav
    class="bg-bg-base relative z-50 flex h-fit w-full items-center justify-between px-4 py-4 lg:px-12"
  >
    <div class="flex items-center">
      <a href={navLogo.url} class="flex items-center py-4">
        {
          isGrantsPage ? (
            <img
              src="/nosanaFoundation.svg"
              alt="Nosana Foundation"
              class="h-[20px] w-auto select-none md:h-[30px]"
            />
          ) : (
            <Image
              src={navLogo.darkImage}
              alt={navLogo.alt}
              class="h-[20px] w-auto select-none md:h-[30px]"
            />
          )
        }
      </a>
    </div>

    <div class="hidden h-full items-center gap-6 xl:flex">
      {
        navItems.map((item: any) => {
          const itemUrl = normalizePath(item.url);
          const isBaseActive = normalizedCurrentPath === itemUrl;
          const isSubActive = item.subItems?.items?.some(
            (sub: any) => normalizePath(sub.url) === normalizedCurrentPath,
          );
          const isActive = isBaseActive || isSubActive;
          const isDropdown = item.type === "dropdown";

          const commonClasses = [
            "flex items-center font-semibold body4 gap-2 h-full transition-colors cursor-pointer whitespace-nowrap",
            isActive
              ? "text-brand-100!"
              : "text-primary group-hover:text-brand-100!",
          ];

          return (
            <div
              class="nav-item group flex h-full items-center"
              data-type={item.type}
              data-url={item.url}
              data-target={item.target}
            >
              {isDropdown ? (
                <button class:list={commonClasses}>
                  {item.title}
                  {item.icon && (
                    <div
                      class:list={[
                        "flex h-4 w-4 items-center justify-center transition-all duration-300",
                        "group-hover:rotate-180",
                      ]}
                    >
                      <div
                        class="h-4 w-4 bg-current transition-colors"
                        style={`mask: url(${item.icon.src}) no-repeat center; -webkit-mask: url(${item.icon.src}) no-repeat center;`}
                      />
                    </div>
                  )}
                </button>
              ) : (
                <a
                  href={item.url}
                  target={item.target}
                  rel={
                    item.target === "_blank" ? "noopener noreferrer" : undefined
                  }
                  class:list={commonClasses}
                >
                  {item.title}
                  {item.icon && (
                    <div class="flex h-4 w-4 items-center justify-center">
                      <div
                        class="h-4 w-4 bg-current transition-colors"
                        style={`mask: url(${item.icon.src}) no-repeat center; -webkit-mask: url(${item.icon.src}) no-repeat center;`}
                      />
                    </div>
                  )}
                </a>
              )}

              {item.type === "dropdown" && (
                <div class="mega-menu bg-bg-base animate-in fade-in slide-in-from-top-2 absolute top-full left-0 z-40 hidden w-full duration-300">
                  <div class="mx-auto px-4 py-10 lg:px-12">
                    {/* community dropdown */}
                    {item.title === "Community" ? (
                      <div class="grid grid-cols-14 gap-12">
                        <div class="col-span-4">
                          <h3 class="body1 grotesk text-primary mb-2 font-medium">
                            {item.subItems.sectionTitle}
                          </h3>
                          <p class="text-secondary body4">
                            {item.subItems.sectionSubtitle}
                          </p>
                        </div>
                        <div class="col-span-6 grid grid-cols-2 gap-x-10 gap-y-8">
                          {item.subItems.items.map((subItem: any) => {
                            const isSubActive =
                              normalizePath(subItem.url) ===
                              normalizedCurrentPath;
                            return (
                              <a
                                href={subItem.url}
                                target={subItem.target}
                                rel={
                                  subItem.target === "_blank"
                                    ? "noopener noreferrer"
                                    : undefined
                                }
                                class="group/subitem flex flex-col items-start transition-all duration-200"
                              >
                                {subItem.icon && (
                                  <Image
                                    src={subItem.icon}
                                    alt={subItem.title}
                                    width={32}
                                    height={32}
                                    class="mb-2 shrink-0 select-none"
                                    loading="eager"
                                    decoding="async"
                                  />
                                )}

                                <div>
                                  <div
                                    class:list={[
                                      "body4 flex items-center gap-1 font-semibold transition-colors",
                                      isSubActive
                                        ? "text-brand-100!"
                                        : "text-primary group-hover/subitem:text-brand-100!",
                                    ]}
                                  >
                                    {subItem.title}

                                    {subItem.target === "_blank" && (
                                      <Image
                                        src={externalLink}
                                        alt="External link"
                                        width={14}
                                        height={14}
                                        class="text-brand-100 select-none"
                                      />
                                    )}
                                  </div>
                                  <p class="text-secondary body4 mt-1">
                                    {subItem.description}
                                  </p>
                                </div>
                              </a>
                            );
                          })}
                        </div>

                        <div class="col-span-4">
                          <div class="h-full">
                            <h3 class="body4 text-secondary mb-4">{featuredTitle}</h3>
                            <div class="h-full w-full pb-4">
                              <FeaturedEvent />
                            </div>
                          </div>
                        </div>
                      </div>
                    ) : (
                      // ecosystem dropdown
                      <div class="grid grid-cols-14 gap-12">
                        <div class="col-span-4">
                          <h3 class="body1 grotesk text-primary mb-2 font-medium">
                            {item.subItems.sectionTitle}
                          </h3>
                          <p class="text-secondary body4">
                            {item.subItems.sectionSubtitle}
                          </p>
                        </div>
                        <div class="col-span-9 grid grid-cols-3 gap-x-12 gap-y-8">
                          {item.subItems.items.map((subItem: any) => {
                            const isSubActive =
                              normalizePath(subItem.url) ===
                              normalizedCurrentPath;
                            return (
                              <a
                                href={subItem.url}
                                target={subItem.target}
                                rel={
                                  subItem.target === "_blank"
                                    ? "noopener noreferrer"
                                    : undefined
                                }
                                class="group/subitem flex flex-col items-start transition-all duration-200"
                              >
                                {subItem.icon && (
                                  <Image
                                    src={subItem.icon}
                                    alt={subItem.title}
                                    class="mb-2 h-8 w-8 shrink-0 select-none"
                                    loading="eager"
                                    decoding="async"
                                  />
                                )}

                                <div>
                                  <div
                                    class:list={[
                                      "body4 flex items-center gap-1 font-semibold transition-colors",
                                      isSubActive
                                        ? "text-brand-100!"
                                        : "text-primary group-hover/subitem:text-brand-100!",
                                    ]}
                                  >
                                    {subItem.title}

                                    {subItem.target === "_blank" && (
                                      <Image
                                        src={externalLink}
                                        alt="External link"
                                        width={14}
                                        height={14}
                                        class="text-brand-100 select-none"
                                      />
                                    )}
                                  </div>

                                  <p class="text-secondary body4 mt-1">
                                    {subItem.description}
                                  </p>
                                </div>
                              </a>
                            );
                          })}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </div>

    <div class="flex items-center gap-2 lg:gap-4">
      {
        navCTA.map((cta: any) => (
          <Button
            variant="secondary"
            title={cta.title}
            url={cta.url}
            data-cta="nav_deploy"
          />
        ))
      }

      <button
        id="mobile-toggle"
        class="text-primary hover:text-brand-100 cursor-pointer p-2 transition-colors xl:hidden"
        aria-label="Toggle Menu"
      >
        <span id="hamburger-icon" class="block">
          <Fragment set:html={hamburgerIcon} />
        </span>
        <span id="close-icon" class="hidden">
          <Fragment set:html={closeIcon} />
        </span>
      </button>
    </div>
  </nav>

  <!-- Mobile Nav -->
  <div
    id="mobile-menu"
    class="bg-bg-base fixed inset-0 top-20 z-40 hidden overflow-y-auto overscroll-contain pt-4 xl:hidden"
  >
    <div class="flex flex-col px-6 pb-20">
      {
        navItems.map((item: any) => {
          const itemUrl = normalizePath(item.url);
          const isBaseActive = normalizedCurrentPath === itemUrl;
          const isSubActive = item.subItems?.items?.some(
            (sub: any) => normalizePath(sub.url) === normalizedCurrentPath,
          );
          const isActive = isBaseActive || isSubActive;
          const isDropdown = item.type === "dropdown";

          return (
            <div
              class="mobile-nav-item border-elevated/30 body4 border-b py-4 last:border-0"
              data-type={item.type}
              data-url={item.url}
              data-target={item.target}
            >
              {isDropdown ? (
                <div class="group mobile-trigger flex w-full cursor-pointer items-center justify-start gap-2">
                  <span
                    class:list={[
                      "text-lg font-semibold transition-colors",
                      isActive
                        ? "text-brand-100!"
                        : "text-primary group-hover:text-brand-100!",
                    ]}
                  >
                    {item.title}
                  </span>
                  {item.icon && (
                    <div
                      class:list={[
                        "mobile-icon flex h-5 w-5 items-center justify-center transition-transform duration-300",
                      ]}
                    >
                      <div
                        class="h-full w-full bg-current"
                        style={`mask: url(${item.icon.src}) no-repeat center; -webkit-mask: url(${item.icon.src}) no-repeat center;`}
                      />
                    </div>
                  )}
                </div>
              ) : (
                <a
                  href={item.url}
                  target={item.target}
                  rel={
                    item.target === "_blank" ? "noopener noreferrer" : undefined
                  }
                  class="group flex w-full cursor-pointer items-center justify-start gap-2"
                >
                  <span
                    class:list={[
                      "text-lg font-semibold transition-colors",
                      isActive
                        ? "text-brand-100!"
                        : "text-primary group-hover:text-brand-100!",
                    ]}
                  >
                    {item.title}
                  </span>
                  {item.icon && (
                    <div class="flex h-5 w-5 items-center justify-center">
                      <div
                        class="h-full w-full bg-current"
                        style={`mask: url(${item.icon.src}) no-repeat center; -webkit-mask: url(${item.icon.src}) no-repeat center;`}
                      />
                    </div>
                  )}
                </a>
              )}

              {isDropdown && item.subItems && (
                <div class="mobile-dropdown-content mt-4 hidden">
                  <div class="flex flex-col gap-6 pt-2 pb-4">
                    {item.subItems.items.map((subItem: any) => {
                      const isSubItemActive =
                        normalizePath(subItem.url) === normalizedCurrentPath;
                      return (
                        <a
                          href={subItem.url}
                          target={subItem.target}
                          rel={
                            subItem.target === "_blank"
                              ? "noopener noreferrer"
                              : undefined
                          }
                          class="group/sub flex items-start gap-2"
                        >
                          {subItem.icon && (
                            <Image
                              src={subItem.icon}
                              alt={subItem.title}
                              width={34}
                              height={34}
                              class="shrink-0 rounded-lg select-none"
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                          <div class="flex flex-col">
                            <span
                              class:list={[
                                "body4 font-semibold transition-colors",
                                isSubItemActive
                                  ? "text-brand-100!"
                                  : "text-primary group-hover/sub:text-brand-100!",
                              ]}
                            >
                              {subItem.title}
                              {subItem.target === "_blank" && (
                                <Image
                                  src={externalLink}
                                  alt="External link"
                                  width={12}
                                  height={12}
                                  class="ml-1 inline-block align-baseline opacity-70"
                                />
                              )}
                            </span>
                            {subItem.description && (
                              <p class="text-secondary body4 mt-1 leading-snug">
                                {subItem.description}
                              </p>
                            )}
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
      <div class="mt-12">
        <h3 class="body4 text-secondary mb-4">{featuredTitle}</h3>
        <FeaturedEvent />
      </div>
    </div>
  </div>
</nav-container>

<script>
  class NavContainer extends HTMLElement {
    constructor() {
      super();
      const mobileToggle = this.querySelector("#mobile-toggle");
      const mobileMenu = this.querySelector("#mobile-menu");
      const hamburgerIcon = this.querySelector("#hamburger-icon");
      const closeIcon = this.querySelector("#close-icon");
      const desktopNavItems = this.querySelectorAll(".nav-item");
      const mobileNavItems = this.querySelectorAll(".mobile-nav-item");

      let isMobileMenuOpen = false;
      let activeDropdown: Element | null = null;

      const normalizePath = (p: string | null) => {
        if (!p) return "";
        const base = p.split("#")[0];
        return base === "/" ? "/" : base.replace(/\/$/, "");
      };

      // Mobile Toggle Logic
      mobileToggle?.addEventListener("click", () => {
        isMobileMenuOpen = !isMobileMenuOpen;

        if (isMobileMenuOpen) {
          mobileMenu?.classList.remove("hidden");
          hamburgerIcon?.classList.add("hidden");
          closeIcon?.classList.remove("hidden");
          document.body.style.overflow = "hidden";
          document.documentElement.style.overflow = "hidden";
        } else {
          mobileMenu?.classList.add("hidden");
          hamburgerIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
          document.body.style.overflow = "";
          document.documentElement.style.overflow = "";
        }
      });

      // Mobile Item Clicks
      mobileNavItems.forEach((item) => {
        const type = item.getAttribute("data-type");
        const trigger = item.querySelector(".mobile-trigger");
        const dropdown = item.querySelector(".mobile-dropdown-content");
        const icon = item.querySelector(".mobile-icon");

        if (type === "dropdown") {
          trigger?.addEventListener("click", () => {
            const isHidden = dropdown?.classList.contains("hidden");

            // Close all other dropdowns
            mobileNavItems.forEach((otherItem) => {
              if (otherItem !== item) {
                const otherDropdown = otherItem.querySelector(
                  ".mobile-dropdown-content",
                );
                const otherIcon = otherItem.querySelector(".mobile-icon");
                otherDropdown?.classList.add("hidden");
                otherIcon?.classList.remove("rotate-180");
              }
            });

            dropdown?.classList.toggle("hidden");
            icon?.classList.toggle("rotate-180");
          });
        }
      });

      // Mobile Menu Link Clicks (Submenus, Featured Articles, etc.)
      const mobileMenuLinks = this.querySelectorAll("#mobile-menu a");
      mobileMenuLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          const url = link.getAttribute("href");
          if (!url) return;

          const isExternal =
            url.startsWith("http") || link.getAttribute("target") === "_blank";
          const hasHash = url.includes("#");
          const [baseUrl, hash] = url.split("#");

          if (
            !isExternal &&
            hasHash &&
            normalizePath(window.location.pathname) === normalizePath(baseUrl)
          ) {
            e.preventDefault();
            const element = document.getElementById(hash);
            if (element) {
              mobileToggle?.dispatchEvent(new Event("click"));
              setTimeout(() => {
                element.scrollIntoView({ behavior: "smooth" });
                history.pushState(null, "", url);
              }, 300);
            }
          } else {
            // Close menu on any other link click
            mobileToggle?.dispatchEvent(new Event("click"));
          }
        });
      });

      // Desktop Hover Logic
      desktopNavItems.forEach((item) => {
        const type = item.getAttribute("data-type");
        const button = item.querySelector("button") as HTMLButtonElement | null;
        const megaMenu = item.querySelector(".mega-menu") as HTMLElement | null;
        const url = item.getAttribute("data-url");
        let timeout: any = null;

        if (type === "dropdown") {
          const showMenu = () => {
            clearTimeout(timeout);
            if (activeDropdown && activeDropdown !== megaMenu) {
              activeDropdown.classList.add("hidden");
              const prevButton = activeDropdown
                .closest(".nav-item")
                ?.querySelector("button");
              if (prevButton) {
                const prevUrl = activeDropdown
                  .closest(".nav-item")
                  ?.getAttribute("data-url");
                const isPageActive =
                  normalizePath(window.location.pathname) ===
                  normalizePath(prevUrl || "");
                prevButton.style.color = isPageActive
                  ? "var(--color-brand-100)"
                  : "";
              }
            }
            megaMenu?.classList.remove("hidden");
            if (button) button.style.color = "var(--color-brand-100)";
            activeDropdown = megaMenu;
          };

          const hideMenu = () => {
            timeout = setTimeout(() => {
              megaMenu?.classList.add("hidden");
              const isPageActive =
                normalizePath(window.location.pathname) ===
                normalizePath(url || "");
              if (button)
                button.style.color = isPageActive
                  ? "var(--color-brand-100)"
                  : "";
              if (activeDropdown === megaMenu) activeDropdown = null;
            }, 100);
          };

          item.addEventListener("mouseenter", showMenu);
          item.addEventListener("mouseleave", hideMenu);
          megaMenu?.addEventListener("mouseenter", showMenu);
          megaMenu?.addEventListener("mouseleave", hideMenu);
        }
      });

      // Handle Smooth Scroll on Page Load
      if (window.location.hash) {
        const hash = window.location.hash;
        // Small delay to ensure layout is ready
        setTimeout(() => {
          const element = document.getElementById(hash.substring(1));
          if (element) {
            element.scrollIntoView({ behavior: "smooth" });
          }
        }, 100);
      }
    }
  }

  customElements.define("nav-container", NavContainer);
</script>

<style is:global>
  /* Ensure icons inherit color if needed, though they are Image tags now */
  .nav-item button:hover div {
    filter: none;
    opacity: 1;
  }
</style>
