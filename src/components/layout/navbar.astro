---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import externalLink from "../../assets/icons/externalLink.svg";
import hamburgerIcon from "../../assets/icons/hamburger.svg?raw";
import closeIcon from "../../assets/icons/close.svg?raw";
import Button from "../ui/button.astro";
import FeaturedEvent from "../events/featuredEvent.astro";

const navbarEntry = await getEntry("navbar", "index");
if (!navbarEntry) {
  throw new Error("content not found");
}
const { navLogo, navItems, navCTA } = navbarEntry.data;
const currentPath = Astro.url.pathname;

const normalizePath = (path: string) => {
  if (!path) return "";
  // Strip hash for comparison
  const base = path.split('#')[0];
  // Remove trailing slash except for root
  return base === "/" ? "/" : base.replace(/\/$/, "");
};

const normalizedCurrentPath = normalizePath(currentPath);
---

<nav-container class="block w-full z-100">
  <nav
    class="h-fit py-4 w-full bg-bg-base flex items-center justify-between px-4 lg:px-12 relative z-50"
  >
    <div class="flex items-center">
      <a href={navLogo.url} class="flex items-center py-4">
        <!-- <Image
          src={navLogo.lightImage}
          alt={navLogo.alt}
          class="h-[30px] w-auto dark:hidden"
        /> -->
        <Image
          src={navLogo.darkImage}
          alt={navLogo.alt}
          class="md:h-[30px] h-[20px] w-auto"
        />
      </a>
    </div>

    <div class="hidden lg:flex items-center gap-6 h-full">
      {
        navItems.map((item: any) => {
          const itemUrl = normalizePath(item.url);
          const isBaseActive = normalizedCurrentPath === itemUrl;
          const isSubActive = item.subItems?.items?.some((sub: any) => normalizePath(sub.url) === normalizedCurrentPath);
          const isActive = isBaseActive || isSubActive;
          return (
            <div
              class="nav-item group h-full flex items-center"
              data-type={item.type}
              data-url={item.url}
              data-target={item.target}
            >
              <button
                class:list={[
                  "flex items-center font-semibold body4 gap-2 h-full transition-colors cursor-pointer whitespace-nowrap",
                  isActive
                    ? "text-brand-100"
                    : "text-primary group-hover:text-brand-100",
                ]}
              >
                {item.title}
                {item.icon && (
                  <div
                    class:list={[
                      "w-4 h-4 flex items-center justify-center transition-all duration-300",
                      item.type === "dropdown" ? "group-hover:rotate-180" : "",
                    ]}
                  >
                    <div
                      class="w-4 h-4 bg-current transition-colors"
                      style={`mask: url(${item.icon.src}) no-repeat center; -webkit-mask: url(${item.icon.src}) no-repeat center;`}
                    />
                  </div>
                )}
              </button>

              {item.type === "dropdown" && (
                <div class="mega-menu absolute left-0 top-full w-full bg-bg-base hidden animate-in fade-in slide-in-from-top-2 duration-300 z-40">
                  <div class="mx-auto px-4 md:px-12 py-10">

                    {/* community dropdown */}
                    {item.title === "Community" ? (
                      <div class="grid grid-cols-14 gap-12">
                        <div class="col-span-4">
                          <h3 class="body1 grotesk font-medium text-primary mb-2">
                            {item.subItems.sectionTitle}
                          </h3>
                          <p class="text-secondary body4">
                            {item.subItems.sectionSubtitle}
                          </p>
                        </div>
                        <div class="col-span-6 grid grid-cols-2 gap-x-10 gap-y-8">
                          {item.subItems.items.map((subItem: any) => {
                            const isSubActive = normalizePath(subItem.url) === normalizedCurrentPath;
                            return (
                              <a
                                href={subItem.url}
                                target={subItem.target}
                                rel={subItem.target === "_blank" ? "noopener noreferrer" : undefined}
                                class="group/subitem flex flex-col items-start transition-all duration-200"
                              >
                                {subItem.icon && (
                                  <Image
                                    src={subItem.icon}
                                    alt={subItem.title}
                                    width={32}
                                    height={32}
                                    class="mb-2 shrink-0 select-none"
                                  />
                                )}

                                <div>
                                  <div 
                                    class:list={[
                                      "flex items-center gap-1 font-semibold body4 transition-colors",
                                      isSubActive ? "text-brand-100" : "text-primary group-hover/subitem:text-brand-100"
                                    ]}
                                  >
                                    {subItem.title}

                                    {subItem.target === "_blank" && (
                                      <Image
                                        src={externalLink}
                                        alt="External link"
                                        width={14}
                                        height={14}
                                        class="select-none text-brand-100"
                                      />
                                    )}
                                  </div>
                                  <p class="text-secondary body4 mt-1">
                                    {subItem.description}
                                  </p>
                                </div>
                              </a>
                            );
                          })}
                        </div>

                        <div class="col-span-4">
                          <div class="h-full">
                            <h3 class="body4 text-secondary mb-4">
                              Featured event
                            </h3>
                            <div class="h-full w-full pb-4">
                              <FeaturedEvent />
                            </div>
                          </div>
                        </div>

                      </div>

                    ) : (
                      // ecosystem dropdown
                      <div class="grid grid-cols-14 gap-12">
                        <div class="col-span-4">
                          <h3 class="body1 grotesk font-medium text-primary mb-2">
                            {item.subItems.sectionTitle}
                          </h3>
                          <p class="text-secondary body4">
                            {item.subItems.sectionSubtitle}
                          </p>
                        </div>
                        <div class="col-span-9 grid grid-cols-3 gap-x-12 gap-y-8">
                          {item.subItems.items.map((subItem: any) => {
                            const isSubActive = normalizePath(subItem.url) === normalizedCurrentPath;
                            return (
                              <a
                                href={subItem.url}
                                target={subItem.target}
                                rel={subItem.target === "_blank" ? "noopener noreferrer" : undefined}
                                class="group/subitem flex flex-col items-start transition-all duration-200"
                              >
                                {subItem.icon && (
                                  <Image
                                    src={subItem.icon}
                                    alt={subItem.title}
                                    class="w-8 h-8 mb-2 shrink-0 select-none"
                                  />
                                )}

                                <div>
                                  <div 
                                    class:list={[
                                      "flex items-center gap-1 font-semibold body4 transition-colors",
                                      isSubActive ? "text-brand-100" : "text-primary group-hover/subitem:text-brand-100"
                                    ]}
                                  >
                                    {subItem.title}

                                    {subItem.target === "_blank" && (
                                      <Image
                                        src={externalLink}
                                        alt="External link"
                                        width={14}
                                        height={14}
                                        class="text-brand-100 select-none"
                                      />
                                    )}
                                  </div>

                                  <p class="text-secondary body4 mt-1">
                                    {subItem.description}
                                  </p>
                                </div>
                              </a>
                            );
                          })}
                        </div>

                      </div>
                    )}

                  </div>
                </div>
              )}

            </div>
          );
        })
      }
    </div>

    <div class="flex items-center gap-2 lg:gap-4">
      {
        navCTA.map((cta: any) => (
          <Button variant="secondary" title={cta.title} url={cta.url} />
        ))
      }

      <button
        id="mobile-toggle"
        class="lg:hidden p-2 text-primary hover:text-brand-100 transition-colors cursor-pointer"
        aria-label="Toggle Menu"
      >
        <span id="hamburger-icon" class="block">
          <Fragment set:html={hamburgerIcon} />
        </span>
        <span id="close-icon" class="hidden">
          <Fragment set:html={closeIcon} />
        </span>
      </button>
    </div>
  </nav>

  <!-- Mobile Nav -->
  <div
    id="mobile-menu"
    class="fixed inset-0 top-20 bg-bg-base z-40 hidden lg:hidden overflow-y-auto overscroll-contain pt-4"
  >
    <div class="flex flex-col px-6 pb-20">
      {
        navItems.map((item: any) => {
          const itemUrl = normalizePath(item.url);
          const isBaseActive = normalizedCurrentPath === itemUrl;
          const isSubActive = item.subItems?.items?.some((sub: any) => normalizePath(sub.url) === normalizedCurrentPath);
          const isActive = isBaseActive || isSubActive;
          return (
            <div
              class="mobile-nav-item border-b border-elevated/30 py-4 last:border-0 body4"
              data-type={item.type}
              data-url={item.url}
              data-target={item.target}
            >
              <div class="flex items-center justify-start gap-2 w-full group cursor-pointer mobile-trigger">
                <span
                  class:list={[
                    "text-lg font-semibold transition-colors",
                    isActive
                      ? "text-brand-100"
                      : "text-primary group-hover:text-brand-100",
                  ]}
                >
                  {item.title}
                </span>
              {item.icon && (
                <div
                  class:list={[
                    "w-5 h-5 flex items-center justify-center transition-transform duration-300 mobile-icon",
                  ]}
                >
                  <div
                    class="w-full h-full bg-current"
                    style={`mask: url(${item.icon.src}) no-repeat center; -webkit-mask: url(${item.icon.src}) no-repeat center;`}
                  />
                </div>
              )}
            </div>

            {item.type === "dropdown" && item.subItems && (
              <div class="mobile-dropdown-content hidden mt-4">
                <div class="flex flex-col gap-6 pt-2 pb-4">
                  {item.subItems.items.map((subItem: any) => {
                    const isSubItemActive = normalizePath(subItem.url) === normalizedCurrentPath;
                    return (
                      <a
                        href={subItem.url}
                        target={subItem.target}
                        rel={subItem.target === "_blank" ? "noopener noreferrer" : undefined}
                        class="flex items-start gap-2 group/sub"
                      >
                        {subItem.icon && (
                          <Image
                            src={subItem.icon}
                            alt={subItem.title}
                            width={34}
                            height={34}
                            class="shrink-0 select-none rounded-lg"
                          />
                        )}
                        <div class="flex flex-col">
                          <span 
                            class:list={[
                              "font-semibold body4 transition-colors",
                              isSubItemActive ? "text-brand-100" : "text-primary group-hover/sub:text-brand-100"
                            ]}
                          >
                            {subItem.title}
                            {subItem.target === "_blank" && (
                              <Image
                                src={externalLink}
                                alt="External link"
                                width={12}
                                height={12}
                                class="inline-block ml-1 align-baseline opacity-70"
                              />
                            )}
                          </span>
                          {subItem.description && (
                            <p class="text-secondary body4 leading-snug mt-1">
                              {subItem.description}
                            </p>
                          )}
                        </div>
                      </a>
                    );
                  })}

                </div>
              </div>
            )}
            </div>
          );
        })
      }
      <div class="mt-12">
        <h3 class="body4 text-secondary mb-4">Featured Article</h3>
        <FeaturedEvent />
      </div>
    </div>
  </div>
</nav-container>

<script>
  class NavContainer extends HTMLElement {
    constructor() {
      super();
      const mobileToggle = this.querySelector("#mobile-toggle");
      const mobileMenu = this.querySelector("#mobile-menu");
      const hamburgerIcon = this.querySelector("#hamburger-icon");
      const closeIcon = this.querySelector("#close-icon");
      const desktopNavItems = this.querySelectorAll(".nav-item");
      const mobileNavItems = this.querySelectorAll(".mobile-nav-item");

      let isMobileMenuOpen = false;
      let activeDropdown: Element | null = null;

      const normalizePath = (p: string | null) => {
        if (!p) return "";
        const base = p.split('#')[0];
        return base === "/" ? "/" : base.replace(/\/$/, "");
      };

      // Mobile Toggle Logic
      mobileToggle?.addEventListener("click", () => {
        isMobileMenuOpen = !isMobileMenuOpen;

        if (isMobileMenuOpen) {
          mobileMenu?.classList.remove("hidden");
          hamburgerIcon?.classList.add("hidden");
          closeIcon?.classList.remove("hidden");
          document.body.style.overflow = "hidden";
          document.documentElement.style.overflow = "hidden";
        } else {
          mobileMenu?.classList.add("hidden");
          hamburgerIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
          document.body.style.overflow = "";
          document.documentElement.style.overflow = "";
        }
      });

      // Mobile Item Clicks
      mobileNavItems.forEach((item) => {
        const type = item.getAttribute("data-type");
        const trigger = item.querySelector(".mobile-trigger");
        const dropdown = item.querySelector(".mobile-dropdown-content");
        const icon = item.querySelector(".mobile-icon");

        trigger?.addEventListener("click", () => {
          if (type === "dropdown") {
            const isHidden = dropdown?.classList.contains("hidden");
            dropdown?.classList.toggle("hidden");
            icon?.classList.toggle("rotate-180");
          } else {
            const url = item.getAttribute("data-url") || "/";
            const target = item.getAttribute("data-target");
            const isExternal = url?.startsWith("http");
            const hasHash = url?.includes("#");
            const [baseUrl, hash] = url?.split("#") || [];

            if (target === "_blank") {
              window.open(url, "_blank");
            } else if (!isExternal && hasHash && normalizePath(window.location.pathname) === normalizePath(baseUrl)) {
              // Same page anchor: scroll and close menu
              const element = document.getElementById(hash);
              if (element) {
                // Close menu first
                mobileToggle?.dispatchEvent(new Event('click'));
                setTimeout(() => {
                  element.scrollIntoView({ behavior: "smooth" });
                  history.pushState(null, "", url);
                }, 300);
              }
            } else {
              // Regular link: close menu then navigate
              mobileToggle?.dispatchEvent(new Event('click'));
              setTimeout(() => {
                window.location.href = url;
              }, 150); // Small delay to allow menu animation
            }
          }
        });
      });

      // Mobile Menu Link Clicks (Submenus, Featured Articles, etc.)
      const mobileMenuLinks = this.querySelectorAll("#mobile-menu a");
      mobileMenuLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          const url = link.getAttribute("href");
          if (!url) return;

          const isExternal = url.startsWith("http") || link.getAttribute("target") === "_blank";
          const hasHash = url.includes("#");
          const [baseUrl, hash] = url.split("#");

          if (!isExternal && hasHash && normalizePath(window.location.pathname) === normalizePath(baseUrl)) {
            e.preventDefault();
            const element = document.getElementById(hash);
            if (element) {
              mobileToggle?.dispatchEvent(new Event('click'));
              setTimeout(() => {
                element.scrollIntoView({ behavior: "smooth" });
                history.pushState(null, "", url);
              }, 300);
            }
          } else {
            // Close menu on any other link click
            mobileToggle?.dispatchEvent(new Event('click'));
          }
        });
      });

      // Desktop Hover Logic
      desktopNavItems.forEach((item) => {
        const type = item.getAttribute("data-type");
        const button = item.querySelector("button") as HTMLButtonElement | null;
        const megaMenu = item.querySelector(".mega-menu") as HTMLElement | null;
        const url = item.getAttribute("data-url");
        let timeout: any = null;

        if (type === "link") {
          button?.addEventListener("click", () => {
            const target = item.getAttribute("data-target");
            const isExternal = url?.startsWith("http");
            const hasHash = url?.includes("#");
            const [baseUrl, hash] = url?.split("#") || [];

            if (target === "_blank") {
              window.open(url || "/", "_blank");
            } else if (!isExternal && hasHash && normalizePath(window.location.pathname) === normalizePath(baseUrl)) {
              // Same page anchor link
              const element = document.getElementById(hash);
              if (element) {
                element.scrollIntoView({ behavior: "smooth" });
                // Update URL without reload
                history.pushState(null, "", url);
              }
            } else {
              window.location.href = url || "/";
            }
          });
        }

        if (type === "dropdown") {
          const showMenu = () => {
            clearTimeout(timeout);
            if (activeDropdown && activeDropdown !== megaMenu) {
              activeDropdown.classList.add("hidden");
              const prevButton = activeDropdown
                .closest(".nav-item")
                ?.querySelector("button");
              if (prevButton) {
                const prevUrl = activeDropdown
                  .closest(".nav-item")
                  ?.getAttribute("data-url");
                const isPageActive = normalizePath(window.location.pathname) === normalizePath(prevUrl || "");
                prevButton.style.color = isPageActive
                  ? "var(--color-brand-100)"
                  : "";
              }
            }
            megaMenu?.classList.remove("hidden");
            if (button) button.style.color = "var(--color-brand-100)";
            activeDropdown = megaMenu;
          };

          const hideMenu = () => {
            timeout = setTimeout(() => {
              megaMenu?.classList.add("hidden");
              const isPageActive = normalizePath(window.location.pathname) === normalizePath(url || "");
              if (button)
                button.style.color = isPageActive
                  ? "var(--color-brand-100)"
                  : "";
              if (activeDropdown === megaMenu) activeDropdown = null;
            }, 100);
          };

          item.addEventListener("mouseenter", showMenu);
          item.addEventListener("mouseleave", hideMenu);
          megaMenu?.addEventListener("mouseenter", showMenu);
          megaMenu?.addEventListener("mouseleave", hideMenu);
        }
      });

      // Handle Smooth Scroll on Page Load
      if (window.location.hash) {
        const hash = window.location.hash;
        // Small delay to ensure layout is ready
        setTimeout(() => {
          const element = document.getElementById(hash.substring(1));
          if (element) {
            element.scrollIntoView({ behavior: "smooth" });
          }
        }, 100);
      }
    }
  }

  customElements.define("nav-container", NavContainer);
</script>

<style is:global>
  /* Ensure icons inherit color if needed, though they are Image tags now */
  .nav-item button:hover div {
    filter: none;
    opacity: 1;
  }
</style>
