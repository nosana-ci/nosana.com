---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

const entry = await getEntry("layout", "index");

if (!entry) {
  throw new Error("brands not found");
}

const brands = entry.data.brands ?? [];
const loopBrands = [...brands, ...brands];
---

{
  brands.length > 0 && (
    <div class="w-full h-full relative marquee-container">
      <div class="flex gap-10 md:gap-24 w-max animate-marquee">
        {loopBrands.map((brand) => (
          <div class="shrink-0 items-center justify-center opacity-60 transition-all duration-300 hover:opacity-100">
            <Image
              src={brand.logo}
              alt={brand.name}
              class="h-4 md:h-6 lg:h-8 w-auto object-contain select-none pointer-events-none grayscale"
              loading="eager"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  )
}

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 80s linear infinite;
    will-change: transform;
  }

  .marquee-container {
    overflow: hidden;
  }

  .marquee-container:hover .animate-marquee,
  .marquee-container:hover .animate-marquee-fast,
  .marquee-container:hover .animate-marquee-slow {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {

    .animate-marquee,
    .animate-marquee-fast,
    .animate-marquee-slow {
      animation: none;
    }
  }
</style>