---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const entry = await getEntry("layout", "index");
if (!entry) {
  throw new Error("Layout content not found");
}

const { socialBannerMarquee } = entry.data;

type Item = {
  image: ImageMetadata;
  value: string;
  label: string;
};

const items: Item[] = socialBannerMarquee.items ?? [];

const mid = Math.ceil(items.length / 2);
const firstHalf = items.slice(0, mid);
const secondHalf = items.slice(mid);
---

<section class="w-full overflow-hidden bg-bg-base py-4 space-y-4">
  {
    firstHalf.length > 0 && (
      <div class="relative w-full overflow-hidden">
        <div class="marquee flex gap-4 w-max">
          {[...firstHalf, ...firstHalf].map((item) => (
            <div class="flex gap-4">
              <Image
                src={item.image}
                alt="social banner image"
                class="w-[200px] md:w-[280px] lg:w-[360px] h-[160px] md:h-[210px] lg:h-[280px] object-cover rounded-lg bg-elevated"
              />

              <div class="w-[160px] md:w-[210px] lg:w-[280px] aspect-square rounded-lg bg-elevated flex flex-col items-center justify-center text-center px-6">
                <p class="text-primary h4 grotesk">{item.value}</p>
                <p class="text-primary h6 grotesk mt-2">{item.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    secondHalf.length > 0 && (
      <div class="relative w-full overflow-hidden">
        <div class="marquee flex gap-4 w-max">
          {[...secondHalf, ...secondHalf].map((item) => (
            <div class="flex gap-4">
              <div class="w-[160px] md:w-[210px] lg:w-[280px] aspect-square rounded-lg bg-elevated flex flex-col items-center justify-center text-center px-6">
                <p class="text-primary h4 grotesk">{item.value}</p>
                <p class="text-primary h6 grotesk mt-2">{item.label}</p>
              </div>

              <Image
                src={item.image}
                alt="social banner image"
                class="w-[200px] md:w-[280px] lg:w-[360px] h-[160px] md:h-[210px] lg:h-[280px] object-cover rounded-lg"
              />
            </div>
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  .marquee {
    animation: scroll 60s linear infinite;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
