---
import Button from "../ui/button.astro";
import playIcon from "../../assets/icons/play.svg?raw";
import pauseIcon from "../../assets/icons/pause.svg?raw";
import muteIcon from "../../assets/icons/mute.svg?raw";
import speakerIcon from "../../assets/icons/speaker.svg?raw";

interface Props {
  heading?: string;
  videoSrc?: string;
  youtubeId?: string;
  poster?: string;
  cta?: {
    title: string;
    url: string;
  };
  darkControls?: boolean;
}

const { heading, videoSrc, youtubeId, poster, cta, darkControls = false } = Astro.props;
---

<section class="bg-bg-base w-full px-4 lg:px-12" data-video-section>
  {
    heading && (
      <h2 class="text-primary grotesk h4 mb-16 max-w-3xl">{heading}</h2>
    )
  }

  <div class="relative aspect-video w-full overflow-hidden rounded-lg bg-black">
    {youtubeId ? (
      <iframe
        class="h-full w-full pointer-events-none"
        src={`https://www.youtube.com/embed/${youtubeId}?enablejsapi=1&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0`}
        allow="autoplay; encrypted-media"
        allowfullscreen={false}
        data-youtube
      />
    ) : (
      <video
        class="h-full w-full object-cover pointer-events-none"
        poster={poster}
        preload="metadata"
        muted
        data-video
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    )}

    <div class="absolute inset-0 z-10 cursor-pointer" data-video-overlay></div>

    <div
      class="pointer-events-none absolute right-0 bottom-0 left-0 z-20 flex items-end justify-between bg-linear-to-t from-black/50 to-transparent p-2 sm:p-4 md:p-10"
    >
      <button
        class="pointer-events-auto flex h-8 w-8 cursor-pointer items-center justify-center text-white transition-opacity"
        aria-label="Toggle mute"
        data-mute-btn
      >
        <span
          data-muted-icon
          class:list={["[&_svg]:h-5 [&_svg]:w-5 md:[&_svg]:h-8 md:[&_svg]:w-8"]}
        >
          <Fragment set:html={muteIcon} />
        </span>
        <span
          data-unmuted-icon
          class:list={[
            "hidden [&_svg]:h-5 [&_svg]:w-5 md:[&_svg]:h-8 md:[&_svg]:w-8",
          ]}
        >
          <Fragment set:html={speakerIcon} />
        </span>
      </button>

      <div class="pointer-events-auto flex items-center gap-3">
        <button
          class="flex cursor-pointer items-center justify-center text-white [&_svg]:h-5 [&_svg]:w-5 md:[&_svg]:h-9 md:[&_svg]:w-9"
          aria-label="Play / Pause"
          data-play-btn
        >
          <span data-play-icon class:list={[darkControls && "invert"]}
            ><Fragment set:html={playIcon} /></span
          >
          <span
            data-pause-icon
            class:list={["hidden", darkControls && "invert"]}
            ><Fragment set:html={pauseIcon} /></span
          >
        </button>

        {
          cta && (
            <div class="hidden items-center gap-3 md:flex">
              <div
                class:list={[
                  "h-9 w-px",
                  darkControls ? "bg-black/20" : "bg-white/20",
                ]}
              />
              <Button
                title={cta.title}
                url={cta.url}
                variant="secondary"
                class={darkControls ? "text-black!" : undefined}
                data-cta="deploy"
              />
            </div>
          )
        }
      </div>
    </div>
  </div>

  {
    cta && (
      <div class="mt-2 flex w-full md:hidden">
        <Button title={cta.title} url={cta.url} variant="secondary" data-cta="deploy" />
      </div>
    )
  }
</section>

<script>
  // Load YouTube IFrame API if any YouTube sections exist
  const youtubeSections = document.querySelectorAll("[data-youtube]");
  if (youtubeSections.length > 0 && !(window as any).YT) {
    const tag = document.createElement("script");
    tag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(tag);
  }

  document.querySelectorAll("[data-video-section]").forEach((section) => {
    const video = section.querySelector("[data-video]") as HTMLVideoElement | null;
    const youtubeIframe = section.querySelector("[data-youtube]") as HTMLIFrameElement | null;
    const overlay = section.querySelector("[data-video-overlay]") as HTMLElement | null;
    const playBtn = section.querySelector("[data-play-btn]") as HTMLButtonElement | null;
    const muteBtn = section.querySelector("[data-mute-btn]") as HTMLButtonElement | null;
    const playIconEl = section.querySelector("[data-play-icon]") as HTMLElement | null;
    const pauseIconEl = section.querySelector("[data-pause-icon]") as HTMLElement | null;
    const mutedIconEl = section.querySelector("[data-muted-icon]") as HTMLElement | null;
    const unmutedIconEl = section.querySelector("[data-unmuted-icon]") as HTMLElement | null;

    const videoTitle = section.querySelector("h2")?.textContent?.trim() || "Video";

    function syncPlayIcons(playing: boolean) {
      playIconEl?.classList.toggle("hidden", playing);
      pauseIconEl?.classList.toggle("hidden", !playing);
    }

    function syncMuteIcons(muted: boolean) {
      mutedIconEl?.classList.toggle("hidden", !muted);
      unmutedIconEl?.classList.toggle("hidden", muted);
    }

    // --- YouTube path ---
    if (youtubeIframe) {
      let ytPlayer: any = null;
      let isMuted = true;
      let videoStarted = false;

      function initYT() {
        ytPlayer = new (window as any).YT.Player(youtubeIframe, {
          events: {
            onReady: () => {
              ytPlayer.mute();
              syncMuteIcons(true);
              syncPlayIcons(false);
            },
            onStateChange: (e: any) => {
              const YT = (window as any).YT.PlayerState;
              const playing = e.data === YT.PLAYING;
              syncPlayIcons(playing);
              const dl = (window as any).dataLayer || [];
              if (playing) {
                if (!videoStarted) {
                  videoStarted = true;
                  dl.push({ event: "video_start", video_title: videoTitle, page_path: window.location.pathname });
                }
                dl.push({ event: "video_play", video_title: videoTitle, page_path: window.location.pathname });
              }
              if (e.data === YT.ENDED) {
                dl.push({ event: "video_complete", video_title: videoTitle, page_path: window.location.pathname });
              }
            },
          },
        });
      }

      if ((window as any).YT?.Player) {
        initYT();
      } else {
        const prev = (window as any).onYouTubeIframeAPIReady;
        (window as any).onYouTubeIframeAPIReady = () => {
          try { prev?.(); } catch (e) { console.error(e); }
          initYT();
        };
      }

      function toggleYTPlay() {
        if (!ytPlayer) return;
        const state = ytPlayer.getPlayerState();
        const YT = (window as any).YT.PlayerState;
        if (state === YT.PLAYING) {
          ytPlayer.pauseVideo();
        } else {
          ytPlayer.playVideo();
        }
      }

      playBtn?.addEventListener("click", toggleYTPlay);
      overlay?.addEventListener("click", toggleYTPlay);

      muteBtn?.addEventListener("click", () => {
        if (!ytPlayer) return;
        if (isMuted) {
          ytPlayer.unMute();
          isMuted = false;
        } else {
          ytPlayer.mute();
          isMuted = true;
        }
        syncMuteIcons(isMuted);
      });

      return;
    }

    // --- Native video path ---
    if (!video) return;

    function syncVideoPlayIcons() {
      syncPlayIcons(!video!.paused);
    }

    function syncVideoMuteIcons() {
      syncMuteIcons(video!.muted);
    }

    function toggleVideoPlay() {
      if (video!.paused) video!.play();
      else video!.pause();
    }

    playBtn?.addEventListener("click", toggleVideoPlay);
    overlay?.addEventListener("click", toggleVideoPlay);

    muteBtn?.addEventListener("click", () => {
      video!.muted = !video!.muted;
      syncVideoMuteIcons();
    });

    let videoStarted = false;
    video.addEventListener("play", () => {
      syncVideoPlayIcons();
      const dl = (window as any).dataLayer || [];
      if (!videoStarted) {
        videoStarted = true;
        dl.push({ event: "video_start", video_title: videoTitle, page_path: window.location.pathname });
      }
      dl.push({ event: "video_play", video_title: videoTitle, page_path: window.location.pathname });
    });
    video.addEventListener("pause", syncVideoPlayIcons);
    video.addEventListener("ended", () => {
      const dl = (window as any).dataLayer || [];
      dl.push({ event: "video_complete", video_title: videoTitle, page_path: window.location.pathname });
    });

    syncVideoPlayIcons();
    syncVideoMuteIcons();
  });
</script>