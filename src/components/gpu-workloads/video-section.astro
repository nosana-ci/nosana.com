---
import Button from "../ui/button.astro";
import playIcon from "../../assets/icons/play.svg?raw";
import pauseIcon from "../../assets/icons/pause.svg?raw";
import muteIcon from "../../assets/icons/mute.svg?raw";
import speakerIcon from "../../assets/icons/speaker.svg?raw";

interface Props {
  heading?: string;
  videoSrc?: string;
  youtubeId?: string;
  poster?: string;
  cta?: {
    title: string;
    url: string;
  };
  darkControls?: boolean;
}

const { heading, videoSrc, youtubeId, poster, cta, darkControls = false } = Astro.props;
---

<section class="bg-bg-base w-full px-4 lg:px-12" data-video-section>
  {
    heading && (
      <h2 class="text-primary grotesk h4 mb-16 max-w-3xl">{heading}</h2>
    )
  }

    <div class="relative aspect-video w-full overflow-hidden rounded-lg bg-black">
    <video
      class="h-full w-full object-cover"
      poster={poster}
      preload="metadata"
      muted
      data-video
    >
      <source src={videoSrc} type="video/mp4" />
    </video>

    <div
      class="pointer-events-none absolute right-0 bottom-0 left-0 flex items-end justify-between bg-linear-to-t from-black/50 to-transparent p-2 sm:p-4 md:p-10"
    >
      <button
        class="pointer-events-auto flex h-8 w-8 cursor-pointer items-center justify-center text-white transition-opacity"
        aria-label="Toggle mute"
        data-mute-btn
      >
        <span
          data-muted-icon
          class:list={["[&_svg]:h-5 [&_svg]:w-5 md:[&_svg]:h-8 md:[&_svg]:w-8"]}
        >
          <Fragment set:html={muteIcon} />
        </span>
        <span
          data-unmuted-icon
          class:list={[
            "hidden [&_svg]:h-5 [&_svg]:w-5 md:[&_svg]:h-8 md:[&_svg]:w-8",
          ]}
        >
          <Fragment set:html={speakerIcon} />
        </span>
      </button>

      <div class="flex items-center gap-3">
        <div
          class="flex items-center justify-center text-white [&_svg]:h-5 [&_svg]:w-5 md:[&_svg]:h-9 md:[&_svg]:w-9"
          data-play-indicator
        >
          <span data-play-icon class:list={[darkControls && "invert"]}
            ><Fragment set:html={playIcon} /></span
          >
          <span
            data-pause-icon
            class:list={["hidden", darkControls && "invert"]}
            ><Fragment set:html={pauseIcon} /></span
          >
        </div>

        {
          cta && (
            <div class="hidden items-center gap-3 md:flex">
              <div
                class:list={[
                  "h-9 w-px",
                  darkControls ? "bg-black/20" : "bg-white/20",
                ]}
              />
              <div class="pointer-events-auto">
                <Button
                  title={cta.title}
                  url={cta.url}
                  variant="secondary"
                  class={darkControls ? "text-black!" : undefined}
                  data-cta="deploy"
                />
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>

  {
    cta && (
      <div class="mt-2 flex w-full md:hidden">
        <Button
          title={cta.title}
          url={cta.url}
          variant="secondary"
          data-cta="deploy"
        />
      </div>
    )
  }
</section>

<script>
  // Load YouTube IFrame API if any YouTube sections exist
  const youtubeSections = document.querySelectorAll("[data-youtube]");
  if (youtubeSections.length > 0 && !(window as any).YT) {
    const tag = document.createElement("script");
    tag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(tag);
  }

  document.querySelectorAll("[data-video-section]").forEach((section) => {
    const video = section.querySelector(
      "[data-video]",
    ) as HTMLVideoElement | null;
    const muteBtn = section.querySelector(
      "[data-mute-btn]",
    ) as HTMLButtonElement | null;
    const playIconEl = section.querySelector(
      "[data-play-icon]",
    ) as HTMLElement | null;
    const pauseIconEl = section.querySelector(
      "[data-pause-icon]",
    ) as HTMLElement | null;
    const mutedIconEl = section.querySelector(
      "[data-muted-icon]",
    ) as HTMLElement | null;
    const unmutedIconEl = section.querySelector(
      "[data-unmuted-icon]",
    ) as HTMLElement | null;

    const videoTitle = section.querySelector("h2")?.textContent?.trim() || "Video";

    function syncPlayIcons(playing: boolean) {
      playIconEl?.classList.toggle("hidden", playing);
      pauseIconEl?.classList.toggle("hidden", !playing);
    }

    function syncMuteIcons(muted: boolean) {
      mutedIconEl?.classList.toggle("hidden", !muted);
      unmutedIconEl?.classList.toggle("hidden", muted);
    }

    video.addEventListener("click", () => {
      if (video.paused) {
        video.play();
      } else {
        const prev = (window as any).onYouTubeIframeAPIReady;
        (window as any).onYouTubeIframeAPIReady = () => {
          prev?.();
          initYT();
        };
      }

      playBtn?.addEventListener("click", () => {
        if (!ytPlayer) return;
        const state = ytPlayer.getPlayerState();
        const YT = (window as any).YT.PlayerState;
        if (state === YT.PLAYING) {
          ytPlayer.pauseVideo();
        } else {
          ytPlayer.playVideo();
        }
      });

      muteBtn?.addEventListener("click", () => {
        if (!ytPlayer) return;
        if (isMuted) {
          ytPlayer.unMute();
          isMuted = false;
        } else {
          ytPlayer.mute();
          isMuted = true;
        }
        syncMuteIcons(isMuted);
      });

      return;
    }

    // --- Native video path ---
    if (!video) return;

    function syncVideoPlayIcons() {
      syncPlayIcons(!video!.paused);
    }

    function syncVideoMuteIcons() {
      syncMuteIcons(video!.muted);
    }

    playBtn?.addEventListener("click", () => {
      if (video!.paused) video!.play();
      else video!.pause();
    });

    muteBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      video.muted = !video.muted;
      syncMuteIcons();
    });

    let videoStarted = false;
    const videoTitle =
      section.querySelector("h2")?.textContent?.trim() || "Video";
    video.addEventListener("play", () => {
      syncVideoPlayIcons();
      const dl = (window as any).dataLayer || [];
      if (!videoStarted) {
        videoStarted = true;
        dl.push({
          event: "video_start",
          video_title: videoTitle,
          page_path: window.location.pathname,
        });
      }
      dl.push({
        event: "video_play",
        video_title: videoTitle,
        page_path: window.location.pathname,
      });
    });
    video.addEventListener("pause", syncVideoPlayIcons);
    video.addEventListener("ended", () => {
      const dl = (window as any).dataLayer || [];
      dl.push({
        event: "video_complete",
        video_title: videoTitle,
        page_path: window.location.pathname,
      });
    });

    syncVideoPlayIcons();
    syncVideoMuteIcons();
  });
</script>
