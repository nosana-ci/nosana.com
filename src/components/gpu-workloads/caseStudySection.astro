---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/badge.astro";
import Button from "../ui/button.astro";
import activeAstronaut from "../../content/gpu-workloads/assets/active-astronaut.png";

type Props = {
  caseStudy: CollectionEntry<"gpuWorkloads">["data"]["caseStudySection"];
};

const { caseStudy } = Astro.props;
const {
  badge,
  badgeIcon,
  quote,
  authorName,
  authorRole,
  companyLogo,
  companyName,
  image,
  ctaTitle,
  ctaUrl,
  stats,
} = caseStudy;
---

<section class="bg-bg-base w-full px-4 lg:px-12">
  <div
    class="mx-auto flex w-full flex-col gap-10 md:flex-row md:items-stretch lg:gap-16 xl:gap-24"
  >
    <div class="flex flex-1 flex-col justify-between">
      <div>
        <Badge title={badge} icon={badgeIcon} class="mb-4" />

        <blockquote class="text-primary h4 grotesk mb-8 lg:mb-10">
          {quote}
        </blockquote>

        <div class="mb-8 flex items-center gap-4">
          <div>
            <p class="text-primary body3">{authorName}</p>
            <p class="text-secondary body4">{authorRole}</p>
          </div>
          <div class="border-default h-10 border-l"></div>
          <div class="flex items-center gap-2">
            <Image
              src={companyLogo}
              alt={companyName}
              width={24}
              height={24}
              class="rounded-full"
              loading="lazy"
              decoding="async"
            />
            <span class="text-primary body3">{companyName}</span>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-x-8 gap-y-4 md:pt-10 sm:gap-x-16">
        {
          stats.map((stat) => (
            <div>
              <p class="text-secondary body4">{stat.label}</p>
              <p class="text-primary grotesk h5 pt-4 font-medium">
                {stat.value}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="relative w-full shrink-0 aspect-square md:w-1/3 md:aspect-3/4 lg:aspect-square"
    >
      <div
        class="case-study-image group relative h-full w-full overflow-hidden"
      >
        <Image
          src={image}
          alt="Case study"
          width={600}
          height={600}
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <Image
          src={activeAstronaut}
          alt="Case study active"
          width={600}
          height={600}
          class="absolute inset-0 h-full w-full scale-110 object-cover opacity-0 transition-all duration-500 group-hover:scale-100 group-hover:opacity-100"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute right-6 bottom-6 z-10">
          <Button
            title={ctaTitle}
            url={ctaUrl}
            variant="secondary"
            class="border-white! bg-white! text-black!"
            data-cta="case_study"
          />
        </div>
      </div>
    </div>
  </div>
</section>
