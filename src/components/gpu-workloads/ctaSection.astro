---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Button from "../ui/button.astro";
import sideFaces from "../../content/gpu-workloads/assets/side-faces.svg?raw";
import logoFace from "../../content/gpu-workloads/assets/logo-face.svg?raw";
import ctaBG from "../../content/gpu-workloads/assets/ctaBG.webp";
import ctaBGmobile from "../../content/gpu-workloads/assets/ctaBGmobile.webp";
import ctaBorder from "../../content/gpu-workloads/assets/ctaBorder.webp";

type Props = {
  ctaSection: CollectionEntry<"gpuWorkloads">["data"]["ctaSection"];
};

const { ctaSection } = Astro.props;
const { heading, headingHighlight, headingEnd, description, cta1, cta2 } =
  ctaSection;
---

<section class="bg-bg-base relative w-full h-[700px] lg:h-[580px] overflow-hidden">
  <!-- Full Width Background -->
  <div class="absolute inset-0 z-0 size-full">
    <Image
      src={ctaBGmobile}
      alt=""
      class="lg:hidden h-full w-full object-cover pointer-events-none select-none scale-110"
      loading="lazy"
      decoding="async"
    />
    <Image src={ctaBG} alt="" class="hidden lg:block h-full w-full object-cover pointer-events-none select-none" loading="lazy" decoding="async" />
    <div
      class="pointer-events-none absolute inset-0 z-10 size-full lg:hidden"
      style="background: linear-gradient(to bottom, #141414 20%, transparent 100%);"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 z-10 size-full hidden lg:block"
      style="background: linear-gradient(to right, #141414 20%, transparent 100%);"
    >
    </div>
  </div>
  
  <!-- Content Container -->
  <div class="relative z-20 px-4 lg:px-12 w-full h-full absolute inset-0">
    <div class="flex flex-col lg:flex-row w-full h-full justify-between">
      
      <!-- Left Side - Content -->
      <div class="lg:w-1/2 flex flex-col items-start justify-start lg:mt-12">
        <h2 class="text-primary h4 grotesk mb-4 max-w-md">
          {heading}
          <span class="text-brand-100">{headingHighlight}</span>
          {headingEnd}
        </h2>
        <p class="text-secondary body2 mb-8 max-w-lg">{description}</p>
        <div class="flex flex-wrap gap-4">
          <Button title={cta1.title} url={cta1.url} variant="secondary" data-cta="deploy" />
          <Button title={cta2.title} url={cta2.url} variant="secondary" data-cta="learn" />
        </div>
      </div>

      <!-- Right Side - Animation -->
      <div class="lg:w-1/2 flex justify-center items-center h-full pointer-events-none select-none">
        <div class="cta-stack relative h-[380px] w-[380px]">
          <div
            class="cta-layer cta-layer-1 absolute inset-x-0 bottom-0 flex justify-center"
          >
            <Fragment set:html={sideFaces} />
          </div>
          <div
            class="cta-layer cta-layer-2 absolute inset-x-0 bottom-[30px] flex justify-center"
          >
            <Fragment set:html={sideFaces} />
          </div>
          <div
            class="cta-layer cta-layer-3 absolute inset-x-0 bottom-[60px] flex justify-center"
          >
            <Fragment set:html={sideFaces} />
          </div>
          <div
            class="cta-layer cta-layer-4 absolute inset-x-0 bottom-[180px] flex justify-center"
          >
            <Fragment set:html={logoFace} />
          </div>
          <div class="absolute inset-x-0 -bottom-10 flex justify-center z-30">
            <Image src={ctaBorder} alt="" class="w-full h-auto object-contain" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      
    </div>
  </div>

  <style>
    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-60px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(60px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .cta-layer {
      opacity: 0;
    }

    .cta-stack.animated .cta-layer-1 {
      animation: slideDown 0.6s ease-out forwards;
      animation-delay: 0s;
    }

    .cta-stack.animated .cta-layer-2 {
      animation: slideDown 0.6s ease-out forwards;
      animation-delay: 0.3s;
    }

    .cta-stack.animated .cta-layer-3 {
      animation: slideDown 0.6s ease-out forwards;
      animation-delay: 0.6s;
    }

    .cta-stack.animated .cta-layer-4 {
      animation: slideUp 0.6s ease-out forwards;
      animation-delay: 0.9s;
    }

    .background-grid {
      display: none;
    }
  </style>
</section>

<script>
  const stack = document.querySelector(".cta-stack");
  if (stack) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            stack.classList.add("animated");
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    observer.observe(stack);
  }
</script>
