---
import type { CollectionEntry } from "astro:content";
import Button from "../ui/button.astro";
import sideFaces from "../../content/gpu-workloads/assets/side-faces.svg?raw";
import logoFace from "../../content/gpu-workloads/assets/logo-face.svg?raw";

type Props = {
  ctaSection: CollectionEntry<"gpuWorkloads">["data"]["ctaSection"];
};

const { ctaSection } = Astro.props;
const { heading, headingHighlight, headingEnd, description, cta1, cta2 } =
  ctaSection;
---

<section class="bg-bg-base relative w-full px-4 md:px-12">
  <div class="background-grid absolute inset-0 z-0 size-full"></div>
  <div
    class="pointer-events-none absolute inset-0 z-10 size-full"
    style="background: linear-gradient(to right, rgba(20, 20, 20, 1) 20%, transparent 100%);"
  >
  </div>
  <div
    class="relative z-20 mx-auto flex w-full flex-col gap-10 md:flex-row md:items-center md:justify-between"
  >
    <div class="md:w-1/3">
      <h2 class="text-primary h4 grotesk mb-4">
        {heading}
        <span class="text-brand-100">{headingHighlight}</span>
        {headingEnd}
      </h2>
      <p class="text-secondary body2 mb-8 max-w-md">{description}</p>
      <div class="flex flex-wrap gap-4">
        <Button title={cta1.title} url={cta1.url} variant="secondary" />
        <Button title={cta2.title} url={cta2.url} variant="secondary" />
      </div>
    </div>

    <div class="flex w-full justify-center md:w-1/2 md:items-center">
      <div class="cta-stack relative h-70 w-[450px] md:h-140">
        <div
          class="cta-layer cta-layer-1 absolute inset-x-0 bottom-0 flex justify-center"
        >
          <Fragment set:html={sideFaces} />
        </div>
        <div
          class="cta-layer cta-layer-2 absolute inset-x-0 bottom-[30px] flex justify-center"
        >
          <Fragment set:html={sideFaces} />
        </div>
        <div
          class="cta-layer cta-layer-3 absolute inset-x-0 bottom-[60px] flex justify-center"
        >
          <Fragment set:html={sideFaces} />
        </div>
        <div
          class="cta-layer cta-layer-4 absolute inset-x-0 bottom-[180px] flex justify-center"
        >
          <Fragment set:html={logoFace} />
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-60px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(60px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .cta-layer {
      opacity: 0;
    }

    .cta-stack.animated .cta-layer-1 {
      animation: slideDown 0.6s ease-out forwards;
      animation-delay: 0s;
    }

    .cta-stack.animated .cta-layer-2 {
      animation: slideDown 0.6s ease-out forwards;
      animation-delay: 0.3s;
    }

    .cta-stack.animated .cta-layer-3 {
      animation: slideDown 0.6s ease-out forwards;
      animation-delay: 0.6s;
    }

    .cta-stack.animated .cta-layer-4 {
      animation: slideUp 0.6s ease-out forwards;
      animation-delay: 0.9s;
    }

    .background-grid {
      background-color: transparent;
      background-image: url("data:image/svg+xml;base64,");
      background-size: 144px 144px;
      background-position: 0 0px;
      background-position: center center;
      border: 1px solid rgba(255, 255, 255, 0.15);
      opacity: 0.3;
    }
  </style>
</section>

<script>
  const stack = document.querySelector(".cta-stack");
  if (stack) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            stack.classList.add("animated");
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    observer.observe(stack);
  }
</script>
