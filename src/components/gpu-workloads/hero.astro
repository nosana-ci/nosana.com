---
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import heroBg from "../../content/homepage/assets/heroBg.webp";
import heroVideo from "../../content/homepage/assets/heroBg.mp4";
import heroImgRaw from "../../content/gpu-workloads/assets/heroImg.svg?raw";
import texture from "../../content/homepage/assets/texture.webp";

const optimizedPoster = await getImage({
  src: heroBg,
  format: "webp",
  quality: 80,
});

import Button from "../ui/button.astro";
import Badge from "../ui/badge.astro";

type Props = {
  heroSection: CollectionEntry<"gpuWorkloads">["data"]["heroSection"];
};

const { heroSection } = Astro.props;

const { badge, heading, description, cta1, cta2 } = heroSection;

const heroSvg = heroImgRaw.replace(
  "<svg ",
  '<svg preserveAspectRatio="xMaxYMax slice" ',
);
---

<section
  class="relative h-[calc(100vh-5rem)] max-h-[900px] min-h-[785px] w-full overflow-hidden px-4 pt-10 lg:h-[110vh] lg:px-12 lg:pt-20 2xl:h-[calc(100vh-5rem)]"
>
  <video
    autoplay
    loop
    muted
    playsinline
    poster={optimizedPoster.src}
    class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover select-none"
  >
    <source src={heroVideo} type="video/mp4" />
  </video>

  <div
    class="bg-bg-base relative z-10 h-full overflow-hidden rounded-t-xl p-6 md:p-12 lg:p-20"
  >
    <div class="pointer-events-none absolute inset-0 z-0 mix-blend-hard-light">
      <Image
        src={texture}
        alt="texture"
        quality={40}
        class="pointer-events-none h-full w-full object-cover select-none"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="pointer-events-none absolute inset-0 z-0">
      <div
        class="absolute -right-[20%] bottom-[10%] h-full w-full sm:right-0 md:bottom-0"
      >
        <div
          class="pointer-events-none h-full w-full origin-center pb-8 select-none max-xl:scale-125 md:pb-16 lg:pb-18 [&>svg]:h-full [&>svg]:w-full"
          set:html={heroSvg}
        />
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-1 [background-image:linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] [background-size:72px_72px] opacity-5"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-3xl">
      {badge && <Badge title={badge.title} icon={badge.icon} class="mb-4" />}

      <h1 class="text-primary grotesk h4 mb-4">{heading}</h1>
      <p class="text-secondary body2 mb-6 leading-relaxed md:max-w-xl lg:mb-10">
        {description}
      </p>

      <div class="flex flex-wrap gap-4">
        {
          cta1 && (
            <Button
              title={cta1.title}
              url={cta1.url}
              variant="secondary"
              data-cta="deploy"
            />
          )
        }

        {
          cta2 && (
            <Button
              title={cta2.title}
              url={cta2.url}
              icon={cta2.icon}
              variant="secondary"
              data-cta="schedule_call"
            />
          )
        }
      </div>
    </div>
  </div>
</section>
